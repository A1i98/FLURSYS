    import { Button, ComboBox, LineEdit, SpinBox, TextEdit, ScrollView } from "std-widgets.slint";

    export struct ProjectTreeRow {
        index: int,
        icon-code: int,
        depth: int,
        label: string,
        note: string,
        kind: int,
        payload: int,
        active: bool,
        expandable: bool,
        expanded: bool,
    }

    export global UiTheme {
        in-out property <bool> cad-active:true;
        in-out property <length> properties-width:300px;
        in property <color> background: UiTheme.cad-active ? rgb(28,31,38) : rgb(11, 19, 26);
        in property <color> sidebar: UiTheme.cad-active ? rgb(39,43,52) : rgb(14, 25, 34);
        in property <color> toolbar: UiTheme.cad-active ? rgb(37,41,49) : rgb(18, 32, 43);
        in property <color> topbar: UiTheme.cad-active ? rgb(28,31,38) : rgb(20, 37, 49);
        in property <color> viewport: UiTheme.cad-active ? rgb(46,52,64) : rgb(9, 16, 22);
        in property <color> border: UiTheme.cad-active ? rgb(63,69,82) : rgb(47, 74, 91);
        in property <color> border-soft: UiTheme.cad-active ? rgb(47,52,62) : rgb(37, 58, 73);
        in property <color> border-strong: UiTheme.cad-active ? rgb(72,83,99) : rgb(50, 79, 99);
        in property <color> viewport-border: UiTheme.cad-active ? rgb(63,69,82) : rgb(40, 66, 82);
        in property <color> divider: rgb(58, 85, 102);
        in property <color> divider-strong: rgb(65, 94, 112);
        in property <color> accent: UiTheme.cad-active ? rgb(58,136,238) : rgb(240, 195, 109);
        in property <color> text-title: rgb(233, 242, 248);
        in property <color> text-bright: rgb(226, 237, 245);
        in property <color> text: UiTheme.cad-active ? rgb(222,226,232) : rgb(213, 227, 236);
        in property <color> text-alt: rgb(205, 220, 229);
        in property <color> text-muted: UiTheme.cad-active ? rgb(148,155,168) : rgb(140, 167, 185);
        in property <color> text-dim: UiTheme.cad-active ? rgb(148,155,168) : rgb(132, 161, 180);
        in property <color> text-faint: rgb(126, 153, 170);
        in property <color> text-soft: rgb(163, 188, 203);
        in property <color> text-subtle: rgb(180, 202, 214);
        in property <color> text-mid: rgb(190, 209, 220);
        in property <color> text-secondary: UiTheme.cad-active ? rgb(208,214,226) : rgb(198, 215, 224);
        in property <color> text-tree: rgb(184, 207, 219);
        in property <color> text-project: rgb(215, 229, 238);
        in property <color> text-label: rgb(136, 164, 182);
        in property <color> text-overlay: rgb(145, 174, 190);
    }

    export component SectionTitle inherits Text {
        color: rgb(228, 238, 246);
        font-size: 22px;
        font-weight: 700;
    }

    export component SectionHint inherits Text {
        color: rgb(135, 160, 178);
        font-size: 12px;
        wrap: word-wrap;
    }

    export component Card inherits Rectangle {
        background: UiTheme.sidebar;
        border-color: UiTheme.border;
        border-width: 1px;
        border-radius: 5px;
    }

    // Scroll controls independently from the mesh / boundary viewport.
// Shared dock surface for workspace properties. Browser remains independent.
export component PropertiesPanel inherits Rectangle {
    width:UiTheme.properties-width;
    min-height:0px;
    preferred-height:0px;
    vertical-stretch:1;
    clip:true;
    background:UiTheme.sidebar;
    border-color:UiTheme.border;
    border-width:1px;
    border-radius:4px;
    @children
}

// The extent is a Rectangle, not a layout directly inside Flickable. Its height
// is the complete unconstrained column height, including width-dependent hints.
// This keeps viewport constraints out of the content layout and clamps stale
// offsets after selecting a shorter section or resizing the window.
export component PropertyScroll inherits Rectangle {
    in property <int> section:0;
    out property <length> visible-width:max(0px,scroller.visible-width - 16px);
    min-height:0px;min-width:0px;preferred-height:0px;vertical-stretch:1;
    clip:true;
    function clamp-offset() {
        scroller.viewport-y=max(min(0px,scroller.viewport-y),min(0px,scroller.visible-height - extent.height));
    }
    changed section=>{scroller.viewport-y=0px;}
    changed height=>{root.clamp-offset();}
    changed width=>{root.clamp-offset();}
    scroller:=ScrollView {
        width:parent.width;height:parent.height;
        horizontal-scrollbar-policy:always-off;
        vertical-scrollbar-policy:always-on;
        viewport-width:self.visible-width;
        viewport-height:max(self.visible-height,extent.height);
        extent:=Rectangle {
            x:0px;y:0px;width:root.visible-width;height:column.height;
            changed height=>{root.clamp-offset();}
            column:=VerticalLayout {
                x:0px;y:0px;width:parent.width;
                // Minimum layout extent contains intrinsic control heights without
                // inheriting percentage preferred heights from the viewport.
                height:self.min-height;
                padding:10px;padding-bottom:32px;spacing:8px;
                @children
            }
        }
    }
}

export component WorkspaceSections inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index:0;
    callback selected(int);
    min-height:36px;preferred-height:36px;max-height:36px;vertical-stretch:0;
    background:UiTheme.topbar;
    Rectangle {y:parent.height - 1px;width:parent.width;height:1px;background:UiTheme.border;}
    HorizontalLayout {spacing:2px;
        for title[index] in root.model : Rectangle {
            min-width:48px;preferred-width:112px;max-width:160px;horizontal-stretch:1;
            background:root.current-index==index ? UiTheme.sidebar : hit.has-hover ? UiTheme.border-soft : transparent;
            Rectangle {y:parent.height - 3px;width:parent.width;height:2px;background:root.current-index==index ? UiTheme.accent : transparent;}
            Text {text:title;color:root.current-index==index ? UiTheme.text-title : UiTheme.text-muted;font-size:11px;font-weight:root.current-index==index ? 700 : 500;horizontal-alignment:center;vertical-alignment:center;overflow:elide;}
            hit:=TouchArea {mouse-cursor:pointer;clicked=>{root.current-index=index;root.selected(index);}}
        }
        Rectangle {horizontal-stretch:1;min-width:0px;}
    }
}

export component WorkflowControlCard inherits PropertiesPanel {
    in property <int> section:0;
    VerticalLayout {padding:0px;spacing:0px;
        PropertyScroll {section:root.section;@children}
    }
}

    export component MetricCard inherits Card {
        in property <string> label;
        in property <string> value;
        VerticalLayout {
            padding: 12px;
            Text { text: root.label; color: rgb(135, 160, 178); font-size: 11px; }
            Text { text: root.value; color: rgb(240, 195, 109); font-size: 20px; font-weight: 700; }
        }
    }

    export component InteractiveGeometryPreview inherits Rectangle {
        in property <image> preview-image;
        in property <int> view-axis: 3;
        in property <image> orientation-image;
        in property <bool> navigation-3d:false;
        in property <bool> show-fit-control:true;
        in property <bool> planar-navigation:false;
        in property <bool> display-controls:false;
        in property <string> coordinates;
        private property <int> navigation-mode:0;
        callback normal-view();
        in-out property <int> display-mode:0;
        callback display-changed();
        callback frame-selection();
        callback pan(float,float,float,float);
        callback pick-orientation(float,float);
        in property <string> help-text: "DRAG: ORBIT  ·  WHEEL: ZOOM  ·  CLICK RGB XYZ TRIAD: AXIS VIEW  ·  DOUBLE-CLICK: RESET";
        in property <bool> select-geometry: false;
        callback orbit(float, float, float, float);
        callback orbit-end();
        callback zoom(float);
        callback reset-view();
        callback select-view-axis(int);
        callback pick-boundary(float, float, float, float);
        callback pick-modified(float,float,float,float,bool);
        callback hover(float, float, float, float);
        callback context-menu(float,float,float,float);
        callback shortcut(int);
        background: UiTheme.viewport;
        border-color: UiTheme.viewport-border;
        border-width: 1px;

        Image { source: root.preview-image; width: parent.width; height: parent.height; image-fit: contain; }
        Text {
            x: 10px; y: 10px;
            width: max(0px,parent.width - 120px);
            wrap:word-wrap;
            text: root.help-text;
            color: rgb(145, 174, 190); font-size: 10px; font-weight: 700;
        }
        viewport-focus := FocusScope {
            width:parent.width;height:parent.height;
            key-pressed(event)=>{
                if event.text=="1" && root.navigation-3d {root.select-view-axis(0);accept}
                else if event.text=="2" && root.navigation-3d {root.select-view-axis(1);accept}
                else if event.text=="3" && root.navigation-3d {root.select-view-axis(2);accept}
                else if event.text=="4" && root.navigation-3d {root.select-view-axis(3);accept}
                else if event.text=="5" && root.navigation-3d {root.select-view-axis(4);accept}
                else if event.text=="6" && root.navigation-3d {root.select-view-axis(5);accept}
                else if event.text=="7" && root.navigation-3d {root.select-view-axis(6);accept}
                else if (event.text=="f" || event.text=="F") && !event.modifiers.control {root.reset-view();accept}
                else if !root.select-geometry {reject}
                else if event.text==Key.Escape {root.shortcut(0);accept}
                else if event.text==Key.Return {root.shortcut(1);accept}
                else if event.modifiers.control && (event.text=="z" || event.text=="Z") {root.shortcut(event.modifiers.shift ? 3 : 2);accept}
                else if event.modifiers.control && (event.text=="y" || event.text=="Y") {root.shortcut(3);accept}
                else if !event.modifiers.control && (event.text=="f" || event.text=="F") {root.shortcut(4);accept}
                else if event.text==" " {root.shortcut(5);accept}
                else {reject}
            }
        }
        TouchArea {
            property <bool> dragged:false;
            property <bool> orbit-held:false;
            property <bool> pan-held:false;
            property <bool> additive:false;
            property <length> start-x;
            property <length> start-y;
            property <length> last-x;
            property <length> last-y;
            mouse-cursor: self.orbit-held || self.pan-held ? grabbing : root.select-geometry ? crosshair : grab;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    viewport-focus.focus();
                    self.start-x=self.mouse-x;self.start-y=self.mouse-y;
                    self.last-x=self.mouse-x;self.last-y=self.mouse-y;self.dragged=false;
                    self.pan-held=(root.planar-navigation && root.navigation-mode!=2 && event.button==PointerEventButton.left) || event.button==PointerEventButton.middle || (event.button==PointerEventButton.left && event.modifiers.shift) || (event.button==PointerEventButton.left && root.navigation-mode==1);
                    self.orbit-held=event.button==PointerEventButton.left && !self.pan-held;
                    self.additive=event.modifiers.shift || event.modifiers.control;
                }
                if event.kind == PointerEventKind.up {
                    if event.button==PointerEventButton.right && !self.dragged {
                        root.context-menu(self.mouse-x/1px,self.mouse-y/1px,root.width/1px,root.height/1px);
                    }
                    self.orbit-held=false;self.pan-held=false;root.orbit-end();
                }
                if event.kind == PointerEventKind.cancel {
                    self.orbit-held=false;self.pan-held=false;self.dragged=true;root.orbit-end();
                }
            }
            moved => {
                if self.orbit-held || self.pan-held {
                    if Math.abs((self.mouse-x - self.start-x)/1px)>4 || Math.abs((self.mouse-y - self.start-y)/1px)>4 {self.dragged=true;}
                    if self.dragged {
                        if self.pan-held {root.pan((self.mouse-x - self.last-x)/1px,(self.mouse-y - self.last-y)/1px,root.width/1px,root.height/1px);}
                        else if root.navigation-mode==2 {root.zoom((self.last-y - self.mouse-y)/1px*4);}
                        else {root.orbit(self.mouse-x/1px,self.mouse-y/1px,self.start-x/1px,self.start-y/1px);}
                    }
                    self.last-x=self.mouse-x;self.last-y=self.mouse-y;
                } else {root.hover(self.mouse-x/1px,self.mouse-y/1px,root.width/1px,root.height/1px);}
            }
            scroll-event(event) => {root.zoom(event.delta-y/1px);accept}
            double-clicked => {root.reset-view();}
            clicked => {if !self.dragged {
                root.pick-boundary(self.mouse-x/1px,self.mouse-y/1px,root.width/1px,root.height/1px);
                root.pick-modified(self.mouse-x/1px,self.mouse-y/1px,root.width/1px,root.height/1px,self.additive);
            }}
        }
        if root.navigation-3d : Rectangle {
            x:(parent.width - self.width)/2;y:parent.height - self.height - 8px;
            width:min(parent.width - 20px,root.display-controls ? 450px : 340px);height:36px;
            background:UiTheme.toolbar;border-color:UiTheme.border;border-width:1px;border-radius:6px;
            HorizontalLayout {padding:3px;spacing:2px;
                if !root.planar-navigation : Button {icon:@image-url("icons/rotate.svg");accessible-label:"Orbit · drag in viewport";checked:root.navigation-mode==0;checkable:true;min-width:28px;max-width:30px;clicked=>{root.navigation-mode=0;}}
                Button {text:"✥";accessible-label:"Pan · drag in viewport";checked:root.navigation-mode==1;checkable:true;min-width:28px;max-width:30px;clicked=>{root.navigation-mode=1;}}
                Button {text:"⌕";accessible-label:"Zoom · drag in viewport";checked:root.navigation-mode==2;checkable:true;min-width:28px;max-width:30px;clicked=>{root.navigation-mode=2;}}
                if root.show-fit-control : Button {icon:@image-url("icons/fit.svg");accessible-label:"Fit model · F";min-width:28px;max-width:30px;clicked=>{root.reset-view();}}
                if root.display-controls : Button {text:"⌖";accessible-label:"Look at selected face";min-width:28px;max-width:30px;clicked=>{root.normal-view();}}
                Button {icon:@image-url("icons/cube.svg");accessible-label:"Home isometric view";min-width:28px;max-width:30px;clicked=>{root.reset-view();root.select-view-axis(root.planar-navigation ? 2 : 3);}}
                ComboBox {model:["Right · X","Front · Y","Top · Z","Isometric","Left · −X","Back · −Y","Bottom · −Z","Custom"];current-index:root.view-axis;
                    min-width:0px;horizontal-stretch:1;selected(value)=>{if self.current-index<7{root.select-view-axis(self.current-index);}}}
                if root.display-controls : ComboBox {model:["Edges","Shaded","Wireframe"];current-index <=> root.display-mode;min-width:0px;horizontal-stretch:1;selected(value)=>{root.display-changed();}}
            }
        }
        if root.navigation-3d : Rectangle {
            x:parent.width - self.width - 10px;y:8px;width:96px;height:96px;background:transparent;
            Image {source:root.orientation-image;width:96px;height:96px;}
            TouchArea {mouse-cursor:self.pressed ? grabbing : pointer;
                property <length> start-x;property <length> start-y;property <bool> dragged:false;
                pointer-event(event)=>{if event.kind==PointerEventKind.down{self.start-x=self.mouse-x;self.start-y=self.mouse-y;self.dragged=false;}if event.kind==PointerEventKind.up || event.kind==PointerEventKind.cancel{root.orbit-end();}}
                moved=>{if self.pressed {if Math.abs((self.mouse-x - self.start-x)/1px)>4 || Math.abs((self.mouse-y - self.start-y)/1px)>4 {self.dragged=true;}if self.dragged{root.orbit(self.mouse-x/1px,self.mouse-y/1px,self.start-x/1px,self.start-y/1px);}}}
                clicked=>{if !self.dragged{root.pick-orientation(self.mouse-x/1px,self.mouse-y/1px);}}
                scroll-event(event)=>{root.zoom(event.delta-y/1px);accept}
            }
        }
        if root.coordinates!="" : Text {x:10px;y:parent.height - 68px;width:max(0px,parent.width - 20px);height:18px;text:root.coordinates;color:UiTheme.text-secondary;font-size:10px;overflow:elide;}
    }

    export component WorkflowItem inherits Rectangle {
        in property <string> number;
        in property <string> title;
        in property <string> detail;
        in property <bool> active;
        callback select();
        height: 66px;
        background: root.active ? rgb(30, 61, 78) : rgb(17, 29, 38);
        border-color: root.active ? rgb(77, 168, 184) : rgb(36, 58, 73);
        border-width: 1px;
        border-radius: 4px;
        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            Text { text: root.number; color: root.active ? rgb(240, 195, 109) : rgb(109, 137, 155); font-size: 17px; font-weight: 800; vertical-alignment: center; }
            VerticalLayout {
                Text { text: root.title; color: root.active ? rgb(232, 241, 248) : rgb(180, 199, 211); font-size: 13px; font-weight: 700; }
                Text { text: root.detail; color: rgb(123, 151, 169); font-size: 10px; }
            }
        }
        TouchArea { clicked => { root.select(); } }
    }

    export component TreeRowView inherits Rectangle {
        in property <ProjectTreeRow> entry;
        callback select(bool);
        callback toggle();
        callback activate();
        callback context-menu(float,float);
        height:34px;
        background:root.entry.active ? UiTheme.border : transparent;
        border-radius:3px;
        accessible-role:list-item;
        accessible-label:root.entry.label+" "+root.entry.note;
        TouchArea {
            pointer-event(event)=>{
                if event.kind==PointerEventKind.up && event.button==PointerEventButton.left {root.select(event.modifiers.control || event.modifiers.shift);}
                if event.kind==PointerEventKind.up && event.button==PointerEventButton.right {root.context-menu(self.mouse-x/1px,self.mouse-y/1px);}
            }
            double-clicked=>{root.activate();}
        }
        HorizontalLayout {
            padding-left:6px+root.entry.depth*10px;padding-right:5px;spacing:5px;
            Rectangle {width:14px;
                if root.entry.expandable : Text {text:root.entry.expanded ? "▾" : "▸";color:UiTheme.text-muted;font-size:12px;vertical-alignment:center;height:parent.height;}
                if root.entry.expandable : TouchArea {clicked=>{root.toggle();}}
            }
            if root.entry.icon-code>0 : Image {
                width:14px;height:14px;vertical-stretch:0;image-fit:contain;
                source:root.entry.icon-code==1 ? @image-url("icons/sketch.svg") : root.entry.icon-code==2 ? @image-url("icons/pad.svg") : root.entry.icon-code==3 ? @image-url("icons/revolve.svg") : root.entry.icon-code==4 ? @image-url("icons/cut.svg") : root.entry.icon-code==5 ? @image-url("icons/loft.svg") : root.entry.icon-code==6 ? @image-url("icons/mirror.svg") : root.entry.icon-code==7 ? @image-url("icons/rotate.svg") : root.entry.icon-code==8 ? @image-url("icons/union.svg") : root.entry.icon-code==9 ? @image-url("icons/cube.svg") : @image-url("icons/sketch.svg");
            }
            VerticalLayout {spacing:1px;alignment:center;horizontal-stretch:1;min-width:0px;
                Text {text:root.entry.label;color:root.entry.active ? UiTheme.accent : UiTheme.text;font-size:root.entry.depth==0 ? 12px : 11px;font-weight:root.entry.depth==0 ? 800 : 400;overflow:elide;}
                if root.entry.note!="" : Text {text:root.entry.note;color:UiTheme.text-muted;font-size:9px;overflow:elide;}
            }
        }
    }

    export component InspectorLabel inherits Text {
        color: rgb(136, 164, 182);
        font-size: 10px;
        font-weight: 700;
    }

    export component InspectorValue inherits Text {
        color: rgb(213, 227, 236);
        font-size: 11px;
        wrap: word-wrap;
    }
