    import { Button, ComboBox, LineEdit, SpinBox, TextEdit } from "std-widgets.slint";

    export struct ProjectTreeRow {
        index: int,
        icon-code: int,
        depth: int,
        label: string,
        note: string,
        kind: int,
        payload: int,
        active: bool,
        expandable: bool,
        expanded: bool,
    }

    export global UiTheme {
        in property <color> background: rgb(11, 19, 26);
        in property <color> sidebar: rgb(14, 25, 34);
        in property <color> toolbar: rgb(18, 32, 43);
        in property <color> topbar: rgb(20, 37, 49);
        in property <color> viewport: rgb(9, 16, 22);
        in property <color> border: rgb(47, 74, 91);
        in property <color> border-soft: rgb(37, 58, 73);
        in property <color> border-strong: rgb(50, 79, 99);
        in property <color> viewport-border: rgb(40, 66, 82);
        in property <color> divider: rgb(58, 85, 102);
        in property <color> divider-strong: rgb(65, 94, 112);
        in property <color> accent: rgb(240, 195, 109);
        in property <color> text-title: rgb(233, 242, 248);
        in property <color> text-bright: rgb(226, 237, 245);
        in property <color> text: rgb(213, 227, 236);
        in property <color> text-alt: rgb(205, 220, 229);
        in property <color> text-muted: rgb(140, 167, 185);
        in property <color> text-dim: rgb(132, 161, 180);
        in property <color> text-faint: rgb(126, 153, 170);
        in property <color> text-soft: rgb(163, 188, 203);
        in property <color> text-subtle: rgb(180, 202, 214);
        in property <color> text-mid: rgb(190, 209, 220);
        in property <color> text-secondary: rgb(198, 215, 224);
        in property <color> text-tree: rgb(184, 207, 219);
        in property <color> text-project: rgb(215, 229, 238);
        in property <color> text-label: rgb(136, 164, 182);
        in property <color> text-overlay: rgb(145, 174, 190);
    }

    export component SectionTitle inherits Text {
        color: rgb(228, 238, 246);
        font-size: 22px;
        font-weight: 700;
    }

    export component SectionHint inherits Text {
        color: rgb(135, 160, 178);
        font-size: 12px;
        wrap: word-wrap;
    }

    export component Card inherits Rectangle {
        background: rgb(20, 34, 45);
        border-color: rgb(48, 74, 92);
        border-width: 1px;
        border-radius: 5px;
    }

    export component MetricCard inherits Card {
        in property <string> label;
        in property <string> value;
        VerticalLayout {
            padding: 12px;
            Text { text: root.label; color: rgb(135, 160, 178); font-size: 11px; }
            Text { text: root.value; color: rgb(240, 195, 109); font-size: 20px; font-weight: 700; }
        }
    }

    export component InteractiveGeometryPreview inherits Rectangle {
        in property <image> preview-image;
        in property <int> view-axis: 3;
        in property <image> orientation-image;
        callback pick-orientation(float,float);
        in property <string> help-text: "DRAG: ORBIT  ·  WHEEL: ZOOM  ·  CLICK RGB XYZ TRIAD: AXIS VIEW  ·  DOUBLE-CLICK: RESET";
        in property <bool> select-geometry: false;
        callback orbit(float, float, float, float);
        callback orbit-end();
        callback zoom(float);
        callback reset-view();
        callback select-view-axis(int);
        callback pick-boundary(float, float, float, float);
        callback hover(float, float, float, float);
        callback context-menu(float,float,float,float);
        callback shortcut(int);
        background: rgb(9, 16, 22);
        border-color: rgb(40, 66, 82);
        border-width: 1px;

        Image { source: root.preview-image; width: parent.width; height: parent.height; image-fit: contain; }
        Text {
            x: 10px; y: parent.height - self.height - 8px;
            width: max(0px,parent.width - 132px);
            wrap:word-wrap;
            text: root.help-text;
            color: rgb(145, 174, 190); font-size: 10px; font-weight: 700;
        }
        viewport-focus := FocusScope {
            width:parent.width;height:parent.height;
            key-pressed(event)=>{
                if !root.select-geometry {reject}
                else if event.text==Key.Escape {root.shortcut(0);accept}
                else if event.text==Key.Return {root.shortcut(1);accept}
                else if event.modifiers.control && (event.text=="z" || event.text=="Z") {root.shortcut(event.modifiers.shift ? 3 : 2);accept}
                else if event.modifiers.control && (event.text=="y" || event.text=="Y") {root.shortcut(3);accept}
                else if !event.modifiers.control && (event.text=="f" || event.text=="F") {root.shortcut(4);accept}
                else if event.text==" " {root.shortcut(5);accept}
                else {reject}
            }
        }
        TouchArea {
            property <bool> dragged: false;
            property <bool> orbit-held:false;
            mouse-cursor: self.pressed ? grabbing : root.select-geometry ? crosshair : grab;
            pointer-event(event) => {
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                    root.context-menu(self.mouse-x/1px,self.mouse-y/1px,root.width/1px,root.height/1px);
                }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    viewport-focus.focus();self.dragged = false;self.orbit-held=true;
                }
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {self.orbit-held=false;}
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && self.dragged {
                    root.orbit-end();
                }
            }
            moved => {
                if self.pressed && self.orbit-held {
                    if Math.abs((self.mouse-x - self.pressed-x) / 1px) > 4 || Math.abs((self.mouse-y - self.pressed-y) / 1px) > 4 {
                        self.dragged = true;
                    }
                    root.orbit(self.mouse-x / 1px, self.mouse-y / 1px,
                        self.pressed-x / 1px, self.pressed-y / 1px);
                } else {
                    root.hover(self.mouse-x / 1px, self.mouse-y / 1px, root.width / 1px, root.height / 1px);
                }
            }
            scroll-event(event) => { root.zoom(event.delta-y / 1px); accept }
            double-clicked => { root.reset-view(); }
            clicked => { if !self.dragged { root.pick-boundary(self.mouse-x / 1px, self.mouse-y / 1px, root.width / 1px, root.height / 1px); } }
        }
        Rectangle {
            x: parent.width - self.width - 12px;
            y: parent.height - self.height - 12px;
            width:96px;height:96px;
            background:transparent;
            Image {source:root.orientation-image;width:96px;height:96px;}
            TouchArea {
                mouse-cursor:pointer;
                clicked=>{root.pick-orientation(self.mouse-x/1px,self.mouse-y/1px);}
            }
        }
    }

    export component WorkflowItem inherits Rectangle {
        in property <string> number;
        in property <string> title;
        in property <string> detail;
        in property <bool> active;
        callback select();
        height: 66px;
        background: root.active ? rgb(30, 61, 78) : rgb(17, 29, 38);
        border-color: root.active ? rgb(77, 168, 184) : rgb(36, 58, 73);
        border-width: 1px;
        border-radius: 4px;
        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            Text { text: root.number; color: root.active ? rgb(240, 195, 109) : rgb(109, 137, 155); font-size: 17px; font-weight: 800; vertical-alignment: center; }
            VerticalLayout {
                Text { text: root.title; color: root.active ? rgb(232, 241, 248) : rgb(180, 199, 211); font-size: 13px; font-weight: 700; }
                Text { text: root.detail; color: rgb(123, 151, 169); font-size: 10px; }
            }
        }
        TouchArea { clicked => { root.select(); } }
    }

    export component TreeRowView inherits Rectangle {
        in property <ProjectTreeRow> entry;
        callback select(bool);
        callback toggle();
        callback activate();
        callback context-menu(float,float);
        height:34px;
        background:root.entry.active ? rgb(30,61,78) : transparent;
        border-radius:3px;
        accessible-role:list-item;
        accessible-label:root.entry.label+" "+root.entry.note;
        TouchArea {
            pointer-event(event)=>{
                if event.kind==PointerEventKind.up && event.button==PointerEventButton.left {root.select(event.modifiers.control);}
                if event.kind==PointerEventKind.up && event.button==PointerEventButton.right {root.context-menu(self.mouse-x/1px,self.mouse-y/1px);}
            }
            double-clicked=>{root.activate();}
        }
        HorizontalLayout {
            padding-left:6px+root.entry.depth*10px;padding-right:5px;spacing:5px;
            Rectangle {width:14px;
                if root.entry.expandable : Text {text:root.entry.expanded ? "▾" : "▸";color:UiTheme.text-muted;font-size:12px;vertical-alignment:center;height:parent.height;}
                if root.entry.expandable : TouchArea {clicked=>{root.toggle();}}
            }
            if root.entry.icon-code>0 : Image {
                width:14px;height:14px;vertical-stretch:0;image-fit:contain;
                source:root.entry.icon-code==1 ? @image-url("icons/sketch.svg") : root.entry.icon-code==2 ? @image-url("icons/pad.svg") : root.entry.icon-code==3 ? @image-url("icons/revolve.svg") : root.entry.icon-code==4 ? @image-url("icons/cut.svg") : root.entry.icon-code==5 ? @image-url("icons/loft.svg") : root.entry.icon-code==6 ? @image-url("icons/mirror.svg") : root.entry.icon-code==7 ? @image-url("icons/rotate.svg") : root.entry.icon-code==8 ? @image-url("icons/union.svg") : root.entry.icon-code==9 ? @image-url("icons/cube.svg") : @image-url("icons/sketch.svg");
            }
            VerticalLayout {spacing:1px;alignment:center;horizontal-stretch:1;min-width:0px;
                Text {text:root.entry.label;color:root.entry.active ? UiTheme.accent : UiTheme.text;font-size:root.entry.depth==0 ? 12px : 11px;font-weight:root.entry.depth==0 ? 800 : 400;overflow:elide;}
                if root.entry.note!="" : Text {text:root.entry.note;color:UiTheme.text-muted;font-size:9px;overflow:elide;}
            }
        }
    }

    export component InspectorLabel inherits Text {
        color: rgb(136, 164, 182);
        font-size: 10px;
        font-weight: 700;
    }

    export component InspectorValue inherits Text {
        color: rgb(213, 227, 236);
        font-size: 11px;
        wrap: word-wrap;
    }
