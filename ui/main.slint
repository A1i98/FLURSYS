    in-out property <int> cad-primitive-kind: 0;
    in-out property <int> cad-axis: 1;
    in-out property <bool> cad-can-loft: false;
    in-out property <bool> cad-can-pocket:false;
    in-out property <int> cad-source: 0;
    in-out property <int> cad-target: 1;
