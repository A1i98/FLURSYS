    callback mesh-hover(float, float, float, float);

    VerticalLayout {
        spacing: 0px;
        TopBar {
            open-settings=>{root.gmsh-path-draft=root.preferences-gmsh-path;root.settings-open=true;}
            compact-ui: root.compact-ui;
            project-loaded: root.project-loaded;
            wb-busy: root.wb-busy;
            project-name: root.project-name;project-modified:root.project-modified;
            rename-project=>{root.project-name-draft=root.project-name;root.project-name-feedback="";root.project-name-open=true;}
            status: root.status;
            current-step: root.current-step;
            show-browser <=> root.show-browser;show-history <=> root.show-history;show-topology <=> root.show-topology;
            refresh-browser=>{root.refresh-browser();}
            fit-view=>{if root.current-step==0 {root.reset-geometry-view();}else if root.current-step==4 {root.post-view-fit();}else {root.mesh-view-fit();}}
            recent-project-model: root.recent-project-model;
            recent-project-index <=> root.recent-project-index;
            new-project => { root.new-project(); }
            show-examples => { root.show-examples(); }
            open-project => { root.open-project-native(); }
            open-recent-project(index) => { root.open-recent-project(index); }
            save-project => { root.save-project-native(); }
            save-project-as => { root.save-project-as(); }
            save-template => { root.save-as-case-template(); }
            select-step(step) => { root.select-step(step); }
        }

        HorizontalLayout {
            spacing: 0px;
            if root.show-browser && root.current-step!=0 : ProjectTree {
                compact-ui: root.compact-ui;
                project-tree-model: root.project-tree-model;
                select-tree-row(index, additive) => { root.select-tree-row(index, additive); }
                toggle-tree-row(index) => { root.toggle-tree-row(index); }
                edit-tree-row(index)=>{}
                context-tree-row(index)=>{false}
                expand-history(expand)=>{root.cad-tree-expand(expand);}
                command(action)=>{}
                activate(action)=>{}
                can-edit-feature:root.cad-selection-editable;has-source-sketch:root.cad-selection-source-sketch;
                has-body:root.cad-selection-body;has-sketch:root.cad-selection-sketch;planar-face:root.cad-selection-planar;has-edge:root.cad-selection-edge;
                selection-label:root.cad-selection-label;locked:root.cad-busy || root.cad-task-open;
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                if root.current-step == 4 && root.inspector-mode == 6 : Rectangle {
                    min-width: root.compact-ui ? 236px : 264px;
                    preferred-width: root.compact-ui ? 260px : 292px;
                    max-width: root.compact-ui ? 288px : 320px;
                    background: UiTheme.sidebar;
                    border-color: UiTheme.border-soft;
                    border-width: 1px;

                    VerticalLayout {
                        padding: root.compact-ui ? 9px : 12px;
                        spacing: 8px;

                        Text {
                            text: "PROPERTIES";
                            color: UiTheme.text-dim;
                            font-size: 10px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.inspector-title;
                            color: UiTheme.accent;
                            font-size: 12px;
                            font-weight: 800;
                        }

                        PropertyScroll {section:root.inspector-mode;
                                // 6 — persisted run record
                                if root.inspector-mode == 6 : VerticalLayout {
                                    spacing: 6px;
                                    InspectorLabel { text: "PERSISTED RUN METADATA"; }
                                    InspectorValue { text: root.inspector-info; font-family: "monospace"; }
                                    Rectangle { height: 1px; background: UiTheme.border; }
                                    Button { text: "DELETE RUN"; enabled: !root.wb-busy; clicked => { root.delete-run-wb(); } }
                                    InspectorLabel { text: "Delete is a two-step action: press once to arm confirmation, then press again to permanently remove this run's workspace artifacts."; wrap: word-wrap; color: rgb(126,153,170); font-size: 10px; }
                                }

                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: UiTheme.background;

                    if root.examples-open : ExampleGallery {
                        compact-ui: root.compact-ui;
                        page-padding: root.page-padding;
                        page-spacing: root.page-spacing;
                        example-model: root.example-model;
                        selected-example-index: root.selected-example-index;
                        selected-example-title: root.selected-example-title;
                        selected-example-category: root.selected-example-category;
                        selected-example-summary: root.selected-example-summary;
                        selected-example-details: root.selected-example-details;
                        close => { root.close-examples(); }
                        select-example(index) => { root.select-example(index); }
                        show-details(index) => { root.show-example-details(index); }
                        open-example(index) => { root.open-example(index); }
                    }

                    if !root.examples-open && root.current-step == 0 : Rectangle {
                    width:parent.width;height:parent.height;
                    NativeCadCanvas {
                    width:parent.width;height:parent.height;frame:root.cad-native-image;feedback:root.cad-native-feedback;
                    resize(w,h)=>{root.cad-native-resize(w,h);}
                    pointer(kind,x,y,button,ctrl,shift,alt)=>{root.cad-native-pointer(kind,x,y,button,ctrl,shift,alt);}
                    wheel(x,y,ctrl,shift,alt)=>{root.cad-native-wheel(x,y,ctrl,shift,alt);}
                    key(text,pressed,ctrl,shift,alt)=>{root.cad-native-key(text,pressed,ctrl,shift,alt);}
                }

                    if root.cad-flow-plane-selected : Rectangle {
                        x:min(260px,max(8px,parent.width - self.width - 8px));y:110px;width:292px;height:min(parent.height - 125px,650px);
                        background:UiTheme.sidebar;border-color:UiTheme.border;border-width:1px;border-radius:4px;
                        VerticalLayout {padding:0px;PropertyScroll {section:root.flow-plane-index;
PlaneMonitorPanel {manage-plane(i)=>{root.flow-plane-manage(i);}
                                palette <=> root.flow-plane-palette;density <=> root.flow-plane-density;scale <=> root.flow-plane-scale;plot <=> root.flow-plane-plot;levels <=> root.flow-plane-levels;streamlines <=> root.flow-plane-streamlines;field <=> root.flow-plane-field;vectors <=> root.flow-plane-vectors;edges <=> root.flow-plane-edges;normalize <=> root.flow-plane-normalize;normal-marks <=> root.flow-plane-normal-marks;range-min <=> root.flow-plane-min;range-max <=> root.flow-plane-max;
                                style=>{root.flow-plane-style();}export(i)=>{root.flow-plane-export(i);}profile(a,b,c,d,n,k)=>{root.flow-plane-profile(a,b,c,d,n,k);}
                                names:root.flow-plane-names;index <=> root.flow-plane-index;every <=> root.flow-plane-every;record <=> root.flow-plane-enabled;
                                busy:root.wb-busy;details:root.flow-plane-details;status:root.flow-plane-status;
                                select(i)=>{root.flow-plane-select(i);}apply=>{root.flow-plane-apply();}view=>{root.flow-plane-view();}
                            }
}}
                    }
                    }

                if !root.examples-open && root.current-step == 1 : MeshWorkspace {
                    width:parent.width;height:parent.height;
                    task <=> root.mesh-task;
                    busy:root.wb-busy;
                    dimension <=> root.mesh-dimension-index;
                    entity-mode:root.mesh-entity-mode;spatial:root.mesh-spatial-view;
                    layer-yplus <=> root.mesh-layer-yplus;layer-utau <=> root.mesh-layer-utau;layer-estimate:root.mesh-layer-estimate;estimate-layer=>{root.mesh-estimate-first-layer();}
                    domain-faces:root.mesh-domain-faces;domain-face-index:root.mesh-domain-face-index;select-domain-face(i)=>{root.mesh-select-domain-face(i);}
                    geometry-view:root.mesh-show-geometry;
                    selection:root.mesh-selection-summary;
                    coverage:root.mesh-coverage;
                    groups:root.mesh-group-model;group-index:root.mesh-group-index;
                    group-names:root.patch-model;local-group-index <=> root.mesh-local-group-index;
                    group-name <=> root.ns-edit-name;
                    feedback:root.wb-flow-feedback;
                    domain:root.wb-domain-status;
                    readiness:root.wb-mesh-readiness;
                    summary:root.wb-mesh-summary;
                    gmsh:root.wb-gmsh-status;
                    meshing:root.wb-meshing;progress:root.wb-mesh-progress;stage:root.wb-mesh-stage;
                    plan:root.mesh-plan;cad-route:root.mesh-cad-route;
                    size-growth <=> root.mesh-size-growth;
                    edge-cells <=> root.mesh-edge-cells;edge-growth <=> root.mesh-edge-growth;edge-reverse <=> root.mesh-edge-reverse;edge-symmetric <=> root.mesh-edge-symmetric;
                    add-edges()=>{root.mesh-add-edges();}calculate-transition()=>{root.mesh-calculate-transition();}
                    method <=> root.mesh-method;
                    divisions-i <=> root.mesh-divisions-i;divisions-j <=> root.mesh-divisions-j;divisions-k <=> root.mesh-divisions-k;
                    progression-i <=> root.mesh-progression-i;progression-j <=> root.mesh-progression-j;
                    algorithm2d <=> root.mesh-algorithm2d;algorithm3d <=> root.mesh-algorithm3d;
                    curvature <=> root.mesh-curvature;smoothing <=> root.mesh-smoothing;
                    optimize <=> root.mesh-optimize;netgen <=> root.mesh-netgen;extend <=> root.mesh-extend;
                    optimize-threshold <=> root.mesh-optimize-threshold;
                    refine-start <=> root.mesh-refine-start;refine-sampling <=> root.mesh-refine-sampling;
                    apply-settings()=>{root.mesh-apply-settings();}
                    cpu-threads <=> root.wb-mesh-threads;cpu-limit:root.wb-cpu-limit;
                    global-size <=> root.wb-global-size;min-size <=> root.wb-min-size;max-size <=> root.wb-max-size;
                    clip-enabled <=> root.mesh-clip-enabled;clip-axis <=> root.mesh-clip-axis;
                    clip-position <=> root.mesh-clip-position;clip-invert <=> root.mesh-clip-invert;
                    quality-bins:root.mesh-quality-bins;quality-stats:root.mesh-quality-stats;
                    quality-low:root.mesh-quality-low;quality-high:root.mesh-quality-high;
                    box-min <=> root.mesh-box-min;box-max <=> root.mesh-box-max;
                    box-size <=> root.mesh-box-size;box-transition <=> root.mesh-box-transition;
                    inspect(action)=>{root.mesh-inspection-apply(action);}
                    add-region()=>{root.mesh-add-region();}region-bounds()=>{root.mesh-region-bounds();}
                    scope-mode <=> root.mesh-scope-mode;control-kind <=> root.mesh-control-kind;
                    control-name <=> root.mesh-control-name;edit-id:root.mesh-edit-id;
                    layer-mode <=> root.mesh-layer-mode;layer-summary:root.mesh-layer-summary;
                    control-action(action,index)=>{root.mesh-control-action(action,index);}
                    layer-preview()=>{root.mesh-layer-preview();}
                    local-target <=> root.wb-local-target;local-size <=> root.wb-local-size;
                    refine-min <=> root.wb-refine-min;refine-max <=> root.wb-refine-max;refine-distance <=> root.wb-refine-distance;
                    layer-first <=> root.wb-layer-first;layer-growth <=> root.wb-layer-growth;layer-count <=> root.wb-layer-count;
                    controls:root.mesh-control-model;
                    display-mode <=> root.mesh-display-index;color-mode <=> root.mesh-color-index;
                    quality-mode <=> root.mesh-quality-index;quality-threshold <=> root.mesh-quality-threshold;
                    inspection:root.mesh-inspection;bad-cells:root.bad-cell-model;
                    preview:root.visualization-image;
                    task-changed(index)=>{root.mesh-task-changed(index);}
                    select-filter(index)=>{root.mesh-entity-filter(index);}
                    show-geometry(value)=>{root.mesh-workspace-view(value);}
                    pick(x,y,w,h,additive)=>{root.mesh-pick-geometry(x,y,w,h,additive);}
                    box-pick(a,b,c,d,w,h,add)=>{root.mesh-box-geometry(a,b,c,d,w,h,add);}
                    pick-mesh(x,y,w,h)=>{root.pick-boundary(x,y,w,h);}
                    select-group(index)=>{root.mesh-select-group(index);}
                    edit-condition(index)=>{root.mesh-edit-condition(index);}
                    group-action(action)=>{root.mesh-group-action(action);}
                    use-face=>{root.select-fluid-domain();}
                    check=>{root.check-mesh-inputs();}
                    generate=>{root.generate-mesh-wb();}
                    cancel=>{root.cancel-workbench-job();}
                    preset(index)=>{root.mesh-size-preset(index);}
                    add-local=>{root.add-local-size-wb();}
                    add-refinement=>{root.add-threshold-refinement-wb();}
                    add-layers=>{root.add-boundary-layer-wb();}
                    display(index)=>{root.mesh-display(index);}
                    select-color(index)=>{root.mesh-color(index);}
                    quality(index)=>{root.mesh-quality(index);}
                    threshold=>{root.mesh-threshold();}
                    select-bad(index)=>{root.select-bad-cell(index);}
                    hover(x,y,w,h)=>{root.mesh-hover(x,y,w,h);}
                    orientation:root.cad-orientation-image;view-axis:root.geometry-view-axis;
                    pan(dx,dy,w,h)=>{root.viewport-pan(dx,dy,w,h);}
                    view(axis)=>{root.select-geometry-view-axis(axis);}
                    pick-orientation(x,y)=>{root.cad-pick-orientation(x,y);}
                    drag(x,y,px,py,w,h)=>{root.mesh-view-drag(x,y,px,py,w,h);}
                    drag-end=>{root.mesh-view-end();}
                    zoom(delta)=>{root.mesh-view-zoom(delta);}
                    fit=>{root.mesh-view-fit();}
                }

                if !root.examples-open && root.current-step == 2 : Rectangle {
                    width:parent.width;height:parent.height;
                    VerticalLayout {
                        padding:12px;spacing:8px;
                        WorkspaceSections {model:["Boundaries","Material","Readiness","Multiphysics"];current-index <=> root.setup-section;}
                        HorizontalLayout {
                            spacing:10px;
                            WorkflowControlCard {section:root.setup-section;
                                if root.setup-section==0 : VerticalLayout {spacing:8px;vertical-stretch:0;
                                Button {text:"Cyclic patch pairs…";enabled:!root.wb-busy;clicked=>{root.open-cyclic-pairs();}}
                                Text {text:"BOUNDARY CONDITIONS";color:UiTheme.accent;font-size:11px;font-weight:700;}
                                InspectorValue {text:root.wb-boundary-summary;}
                                VerticalLayout {spacing:3px;vertical-stretch:0;
                                    for patch[index] in root.patch-status-model : Button {min-width:0px;
                                        text:(index==root.patch-index ? "● " : "○ ")+patch;
                                        enabled:!root.wb-busy;clicked=>{root.patch-index=index;root.select-patch-wb(index);}
                                    }
                                }


                                    InspectorLabel {text:"SELECTED PATCH";}
                                    InspectorValue {text:root.patch-model.length>0 && root.patch-index>=0 && root.patch-index<root.patch-model.length ? root.patch-model[root.patch-index] : "Create named boundaries in Mesh first.";}
                                    InspectorLabel { text: "PHYSICAL CONDITION"; }
                                    ComboBox {min-width:0px;
                                        enabled: root.patch-model.length > 0 && !root.wb-busy;
                                        model: ["No-slip wall", "Moving wall", "Velocity inlet", "Pressure outlet", "Slip", "Symmetry", "Far-field", "Volume-flow inlet", "Mass-flow inlet", "Pressure outlet / backflow", "Parabolic inlet", "Total-pressure opening"];
                                        current-index <=> root.bc-kind-index;
                                    }
                                    if root.bc-kind-index == 1 || root.bc-kind-index == 2 || root.bc-kind-index == 6 || root.bc-kind-index == 9 || root.bc-kind-index == 10 : VerticalLayout {
                                        spacing: 4px;
                                        InspectorLabel {text:root.bc-kind-index==10 ? "PEAK VELOCITY (Ux · Uy · Uz)" : root.bc-kind-index==9 ? "BACKFLOW VELOCITY (Ux · Uy · Uz)" : root.bc-kind-index==1 ? "WALL VELOCITY (Ux · Uy · Uz)" : root.bc-kind-index==6 ? "FREE-STREAM VELOCITY (Ux · Uy · Uz)" : "INLET VELOCITY (Ux · Uy · Uz)";}
                                        HorizontalLayout {
                                            spacing: 4px;
                                            LineEdit {min-width:0px; text <=> root.bc-value-x;placeholder-text:"Ux";enabled:!root.wb-busy; }
                                            LineEdit {min-width:0px; text <=> root.bc-value-y;placeholder-text:"Uy";enabled:!root.wb-busy; }
                                            LineEdit {min-width:0px; text <=> root.bc-value-z;placeholder-text:"Uz";enabled:!root.wb-busy; }
                                        }
                                    }
                                    if root.bc-kind-index==10 : VerticalLayout {
                                        InspectorLabel {text:"TRANSVERSE PROFILE AXIS";}
                                        ComboBox {model:["X","Y","Z"];current-index <=> root.bc-profile-axis;enabled:!root.wb-busy;max-height:32px;min-width:0px;}
                                        InspectorLabel {text:"CENTRE COORDINATE / HALF-WIDTH (m)";}
                                        HorizontalLayout {LineEdit {min-width:0px;text <=> root.bc-profile-center;} LineEdit {min-width:0px;text <=> root.bc-profile-half-width;}}
                                        InspectorLabel {text:"U = Upeak × max(0, 1 − ((coordinate − centre)/half-width)²). Velocity is peak, not mean.";wrap:word-wrap;}
                                    }
                                    if root.bc-kind-index==7 || root.bc-kind-index==8 : VerticalLayout {
                                        InspectorLabel {text:root.bc-kind-index==8 ? "TOTAL INWARD MASS FLOW (kg/s)" : "TOTAL INWARD VOLUME FLOW (m³/s)";}
                                        LineEdit {min-width:0px;text <=> root.bc-value-x;enabled:!root.wb-busy;}
                                        InspectorLabel {text:"Positive inward; normal inflow distributed by patch area. In 2D, flow is per unit depth.";wrap:word-wrap;}
                                    }
                                    if root.bc-kind-index == 3 || root.bc-kind-index == 6 || root.bc-kind-index == 9 || root.bc-kind-index == 11 : VerticalLayout {
                                        spacing: 4px;
                                        InspectorLabel { text: root.bc-kind-index==11 ? "TOTAL KINEMATIC GAUGE PRESSURE p₀/ρ" : "KINEMATIC GAUGE PRESSURE p/ρ"; }
                                        LineEdit {min-width:0px; text <=> root.bc-pressure; }
                                    }
                                    InspectorLabel {text:root.bc-kind-index==11 ? "Natural velocity opening: p/rho = p0/rho − |U|²/2 on inflow; p/rho = p0/rho on outflow. Incompressible only; no imposed flow direction." : root.bc-kind-index==9 ? "Fixed p/rho; incoming velocity on reversed faces, zero-gradient velocity on outgoing faces." : root.bc-kind-index==7 || root.bc-kind-index==8 ? "Prescribed total inward flow; density converts mass to volume flow." : root.bc-kind-index<0 ? "Choose a physical condition for this boundary." : root.bc-kind-index==0 ? "Stationary impermeable wall: U=(0,0,0)." : root.bc-kind-index==1 ? "Prescribed tangential wall velocity in model coordinates." : root.bc-kind-index==2 ? "Prescribed fluid velocity at an inlet." : root.bc-kind-index==4 || root.bc-kind-index==5 ? "Zero normal velocity and zero normal gradient of tangential velocity and pressure." : root.bc-kind-index==6 ? "Free-stream velocity on incoming flow; reference pressure on outgoing flow. Pressure is p/rho." : "Prescribed kinematic pressure at the outlet; p/rho is not pressure in pascals.";wrap:word-wrap;}
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button {min-width:0px; text: "APPLY CONDITION"; enabled: root.bc-kind-index >= 0 && root.patch-model.length > 0 && !root.wb-busy; clicked => { root.apply-boundary-wb(); } }
                                        Button {min-width:0px; text: "CLEAR"; enabled: root.patch-model.length > 0 && !root.wb-busy; clicked => { root.unassign-boundary-wb(); } }
                                    }
                                    InspectorValue { text: root.bc-assigned; }
                                    InspectorLabel {text:"SCRIPTED BOUNDARY VALUES · RHAI";}
                                    InspectorValue {text:root.script-binding-summary;}
                                    Button {text:"Scripts / attach profile…";enabled:!root.wb-busy;clicked=>{root.open-script-editor();}}
                                    InspectorLabel {text:"PHYSICAL-TIME BOUNDARY TABLE";}
                                    ComboBox {model:["Constant / remove time table","Velocity vector vs time","Flow rate vs time","Pressure vs time","Temperature vs time","Heat flux vs time"];current-index <=> root.time-bc-mode;min-height:32px;max-height:32px;min-width:0px;enabled:!root.wb-busy;}
                                    if root.time-bc-mode>0 : VerticalLayout {
                                        vertical-stretch:0;
                                        InspectorLabel {text:root.time-bc-mode==4 ? "CSV: time_s, temperature_K. Assign Fixed or Inlet/outlet temperature first." : root.time-bc-mode==5 ? "CSV: time_s, inward heat flux_W/m². Assign Heat flux first." : root.time-bc-mode==1 ? "CSV: time_s, Ux, Uy, Uz (m/s). For velocity, parabolic, far-field or backflow inlet." : root.time-bc-mode==2 ? "CSV: time_s, inward rate. Uses the assigned inlet's m³/s or kg/s units." : "CSV: time_s, pressure/rho (m²/s²). Uses the assigned static or total-pressure condition.";wrap:word-wrap;}
                                        TextEdit {text <=> root.time-bc-table;min-width:0px;min-height:120px;max-height:120px;enabled:!root.wb-busy;}
                                        InspectorLabel {text:"At least two rows; increasing times ≥ 0. Linear interpolation; endpoint values held outside table. Transient solve required. One table per patch.";wrap:word-wrap;}
                                    }
                                    Button {text:root.time-bc-mode==0 ? "Remove time table" : "Apply time table";enabled:!root.wb-busy && root.patch-model.length>0;clicked=>{root.apply-time-boundary();}}
                                    InspectorLabel {text:root.time-bc-status;wrap:word-wrap;}
                                    InspectorLabel {text:"INCOMING TURBULENCE / BACKFLOW";}
                                    ComboBox {min-height:32px;max-height:32px;min-width:0px;model:["Use global model values","Direct k / omega / epsilon","Intensity and length scale","SA modified viscosity","Intensity + hydraulic diameter","Intensity + viscosity ratio"];current-index <=> root.turb-patch-mode;}
                                    if root.turb-patch-mode==1 : VerticalLayout {
                                        InspectorLabel {text:"k (m²/s²)";} LineEdit {min-height:32px;max-height:32px;min-width:0px;text <=> root.turb-patch-k;}
                                        InspectorLabel {text:"omega (1/s)";} LineEdit {min-height:32px;max-height:32px;min-width:0px;text <=> root.turb-patch-omega;}
                                        InspectorLabel {text:"epsilon (m²/s³)";} LineEdit {min-height:32px;max-height:32px;min-width:0px;text <=> root.turb-patch-epsilon;}
                                    }
                                    if root.turb-patch-mode==3 : VerticalLayout {
                                        InspectorLabel {text:"SA incoming ν̃ (m²/s) ≥ 0";}LineEdit {text <=> root.turb-patch-nu-tilda;min-height:32px;max-height:32px;min-width:0px;}
                                    }
                                    if root.turb-patch-mode==2 || root.turb-patch-mode==4 || root.turb-patch-mode==5 : VerticalLayout {
                                        InspectorLabel {text:"Intensity (fraction: 0.05 = 5%)";} LineEdit {min-height:32px;max-height:32px;min-width:0px;text <=> root.turb-patch-intensity;}
                                        if root.turb-patch-mode==5 : VerticalLayout {
                                            InspectorLabel {text:"Turbulent / molecular viscosity νt/ν";}LineEdit {text <=> root.turb-patch-viscosity-ratio;min-width:0px;max-height:32px;}
                                            InspectorLabel {text:"Inlet estimate using Cμ=0.09 and the saved fluid viscosity; not a local closure constraint.";wrap:word-wrap;}
                                        }
                                        if root.turb-patch-mode==4 : VerticalLayout {
                                            InspectorLabel {text:"Hydraulic diameter (m)";} LineEdit {text <=> root.turb-patch-diameter;max-height:32px;min-width:0px;}
                                            InspectorLabel {text:"Length / diameter (0–1)";} LineEdit {text <=> root.turb-patch-length-ratio;max-height:32px;min-width:0px;}
                                            InspectorLabel {text:"L = ratio × hydraulic diameter; this is an inlet estimate, not a wall function.";wrap:word-wrap;}
                                        }
                                        if root.turb-patch-mode==2 : InspectorLabel {text:"Length scale (m)";} if root.turb-patch-mode==2 : LineEdit {min-height:32px;max-height:32px;min-width:0px;text <=> root.turb-patch-length;}
                                    }
                                    Button {text:"Apply incoming turbulence";enabled:!root.wb-busy && root.patch-model.length>0;clicked=>{root.apply-turbulence-patch();}}
                                    InspectorLabel {text:root.turb-patch-status;wrap:word-wrap;}
                                    InspectorLabel {text:"TEMPERATURE / HEAT TRANSFER";}
                                    ComboBox {model:["Adiabatic / zero diffusive flux","Fixed temperature","Inlet / outlet temperature","Imposed inward heat flux","External convection","Enclosure radiation"];current-index <=> root.thermal-bc-kind;enabled:!root.wb-busy;min-width:0px;max-height:32px;}
                                    if root.thermal-bc-kind!=0 : VerticalLayout {spacing:4px;vertical-stretch:0;
                                        InspectorLabel {text:root.thermal-bc-kind==5 ? "EMISSIVITY (0–1)" : root.thermal-bc-kind==3 ? "INWARD HEAT FLUX (W/m²)" : root.thermal-bc-kind==4 ? "FILM COEFFICIENT h (W/m²/K)" : "TEMPERATURE (K)";}
                                        LineEdit {text <=> root.thermal-bc-value;min-width:0px;}
                                    }
                                    if root.thermal-bc-kind>=4 : VerticalLayout {spacing:4px;vertical-stretch:0;
                                        InspectorLabel {text:"AMBIENT TEMPERATURE (K)";}LineEdit {text <=> root.thermal-bc-ambient;min-width:0px;}
                                    }
                                    if root.thermal-bc-kind==5 : InspectorLabel {text:"Diffuse-grey radiation to a large enclosure; no participating-media or view-factor model.";wrap:word-wrap;}
                                    Button {text:"Apply thermal condition";enabled:!root.wb-busy && root.patch-model.length>0;clicked=>{root.apply-workbench-thermal-boundary();}}
                                    InspectorLabel {text:root.thermal-bc-status;wrap:word-wrap;}
                                    InspectorLabel {text:"Enable heat transport in Fluid material. Assign every thermal patch; incoming flow needs a temperature.";wrap:word-wrap;}

                                    InspectorLabel { text: "Solve stays disabled until every exterior patch is assigned. The backend re-validates the full case before starting."; wrap: word-wrap; color: rgb(126,153,170); font-size: 10px; }


                                }
                                if root.setup-section==1 : VerticalLayout {spacing:8px;vertical-stretch:0;
                                Rectangle {height:1px;background:UiTheme.border;}
                                Text {text:"FLUID MATERIAL";color:UiTheme.accent;font-size:11px;font-weight:700;}
                                InspectorValue {text:"ρ="+root.material-density+" · ν="+root.material-viscosity;}
                                Button {text:"Edit fluid material…";enabled:!root.wb-busy;clicked=>{root.open-material-editor();}}
                                Button {text:"Material library & property curves…";enabled:!root.wb-busy;clicked=>{root.open-library();}}



                                }
                                if root.setup-section==3 : VerticalLayout {spacing:8px;vertical-stretch:0;
                                    Text {text:"PHASE & HEAT TRANSPORT";color:UiTheme.accent;font-size:11px;font-weight:700;}
                                    InspectorLabel {text:"Configure two-phase scalar transport, conformal solid/fluid energy, thermal contacts and meridian coordinates.";wrap:word-wrap;}
                                    Button {text:"Open phase & heat workspace…";enabled:!root.wb-busy || root.transport-running;clicked=>{root.open-transport();}}
                                    InspectorLabel {text:root.transport-running ? "A scalar job is active. Open the workspace to pause or stop it." : "Runs use a fixed prescribed flow and their own archive. They do not replace the CFD pressure/velocity job.";wrap:word-wrap;}
                                    Rectangle {height:1px;background:UiTheme.border;}
                                    InspectorLabel {text:"Available: temperature, phase fraction, solid/fluid conduction, contact resistance, enclosure radiation and scalar axisymmetry.";wrap:word-wrap;}
                                    InspectorLabel {text:"Not coupled here: variable-density momentum, capillary VOF, swirl and axisymmetric Navier–Stokes. The CFD buoyancy solver still uses full kinematic pressure, not p_rgh.";wrap:word-wrap;}
                                }
                                if root.setup-section==2 : VerticalLayout {spacing:8px;vertical-stretch:0;
                                    Text {text:"BOUNDARY READINESS";color:UiTheme.accent;font-size:11px;font-weight:700;}
                                    InspectorValue {text:root.wb-boundary-summary;}
                                    InspectorLabel {text:root.wb-run-readiness;wrap:word-wrap;}
                                    InspectorLabel {text:"Define names on the original geometry, assign every exterior zone, and inspect units before running.";wrap:word-wrap;}
                                }
                            }
                            Card {
                                horizontal-stretch:1;
                                VerticalLayout {
                                    padding:10px;spacing:8px;
                                    Text {text:"BOUNDARY ZONES";color:UiTheme.accent;font-size:11px;font-weight:700;}
HorizontalLayout {height:32px;spacing:5px;
                                        Button {text:root.mesh-show-geometry ? "✓ Geometry" : "Geometry";clicked=>{root.mesh-workspace-view(true);}}
                                        Button {text:!root.mesh-show-geometry ? "✓ Mesh" : "Mesh";enabled:!root.wb-busy;clicked=>{root.mesh-workspace-view(false);}}
                                    }
                                    EntitySelectionBar {mode:root.mesh-entity-mode;enabled:!root.wb-busy;select(mode)=>{root.mesh-entity-filter(mode);}clear=>{root.mesh-group-action(0);}}
                                    InteractiveGeometryPreview { vertical-stretch: 1; preview-image: root.visualization-image;navigation-3d:true;planar-navigation:!root.mesh-spatial-view;orientation-image:root.cad-orientation-image;pick-orientation(x,y)=>{root.cad-pick-orientation(x,y);}select-view-axis(axis)=>{root.select-geometry-view-axis(axis);}pan(dx,dy,w,h)=>{root.viewport-pan(dx,dy,w,h);} help-text:!root.mesh-spatial-view ? "CLICK: SELECT · DRAG: PAN · WHEEL: ZOOM · DOUBLE CLICK: FIT" : "CLICK: SELECT · DRAG: ORBIT · MIDDLE: PAN · WHEEL: ZOOM"; view-axis: root.geometry-view-axis; orbit(x, y, pressed-x, pressed-y) => { root.mesh-view-drag(x,y,pressed-x,pressed-y,self.width/1px,self.height/1px); } orbit-end => { root.mesh-view-end(); } zoom(delta) => { root.mesh-view-zoom(delta); } reset-view => { root.mesh-view-fit(); } pick-modified(x,y,w,h,add)=>{if root.mesh-show-geometry {root.mesh-pick-geometry(x,y,w,h,add);}else{root.pick-boundary(x,y,w,h);}} hover(x, y, w, h) => { root.mesh-hover(x, y, w, h); } }
                                    Text {text:root.wb-flow-feedback;color:UiTheme.text-soft;font-size:11px;wrap:word-wrap;}
                                    HorizontalLayout {
                                        Text {text:root.wb-boundary-summary;color:UiTheme.text-soft;font-size:11px;wrap:word-wrap;vertical-alignment:center;horizontal-stretch:1;}
                                    }
                                }
                            }

                        }
                    }
                }

                if !root.examples-open && root.current-step == 3 : SolutionWorkspace {
                    box-xmin <=> root.initial-box-xmin;box-ymin <=> root.initial-box-ymin;box-zmin <=> root.initial-box-zmin;
                    box-xmax <=> root.initial-box-xmax;box-ymax <=> root.initial-box-ymax;box-zmax <=> root.initial-box-zmax;
                    mapping-busy:root.field-mapping-busy;preflight:root.preflight-summary;review=>{root.validate-case();}repair-stage(i)=>{root.select-step(i);}manage-plane(i)=>{root.flow-plane-manage(i);}
                    width:parent.width;height:parent.height;
                    properties-section <=> root.solution-properties-section;show-log <=> root.solution-show-log;chart-kind <=> root.wb-chart-kind;
                    plane-palette <=> root.flow-plane-palette;plane-density <=> root.flow-plane-density;plane-scale <=> root.flow-plane-scale;plane-plot <=> root.flow-plane-plot;plane-levels <=> root.flow-plane-levels;plane-streamlines <=> root.flow-plane-streamlines;plane-field <=> root.flow-plane-field;plane-vectors <=> root.flow-plane-vectors;plane-edges <=> root.flow-plane-edges;plane-normalize <=> root.flow-plane-normalize;plane-normal-marks <=> root.flow-plane-normal-marks;plane-min <=> root.flow-plane-min;plane-max <=> root.flow-plane-max;style-plane=>{root.flow-plane-style();}
                    show-plane <=> root.solution-show-plane;plane-image:root.flow-plane-image;plane-readout:root.flow-plane-readout;plane-navigate(a,x,y,w,h)=>{root.flow-plane-navigate(a,x,y,w,h);}
                    plane-frame:root.flow-plane-frame;plane-count:root.flow-plane-count;plane-fps <=> root.flow-plane-fps;plane-loop <=> root.flow-plane-loop;plane-first <=> root.flow-plane-first;plane-last <=> root.flow-plane-last;plane-playing:root.flow-plane-playing;playback(i)=>{root.flow-plane-playback(i);}
                    plane-names:root.flow-plane-names;plane-index <=> root.flow-plane-index;plane-every <=> root.flow-plane-every;plane-enabled <=> root.flow-plane-enabled;
                    plane-details:root.flow-plane-details;plane-status:root.flow-plane-status;
                    export-plane(i)=>{root.flow-plane-export(i);}plane-profile(a,b,c,d,n,k)=>{root.flow-plane-profile(a,b,c,d,n,k);}
                    select-plane(i)=>{root.flow-plane-select(i);}apply-plane=>{root.flow-plane-apply();}view-plane=>{root.flow-plane-view();}

                    refresh-chart=>{root.post-refresh();}
                    continuity <=> root.chart-continuity;momentum <=> root.chart-momentum;velocity <=> root.chart-velocity;pressure <=> root.chart-pressure;
                    logarithmic <=> root.chart-logarithmic;normalized <=> root.chart-normalized;legend <=> root.chart-legend;history-window <=> root.chart-window;
                    readout:root.chart-readout;resize-chart(w,h)=>{root.chart-resize(w,h);}hover-chart(x)=>{root.chart-hover(x);}

                    chart:root.residual-image;caption:root.continuity-chart-caption;
                    convergence-summary:root.post-convergence-summary;balance:root.post-balance;monitor:root.wb-solve-monitor;summary:root.wb-solution-summary;readiness:root.wb-run-readiness;
                    log:root.log-text;material:"ρ="+root.material-density+" · ν="+root.material-viscosity;
                    checkpoint-every <=> root.wb-checkpoint-every;
                    three-d:root.mesh-dimension-index==1;
                    initial-x <=> root.initial-x;initial-y <=> root.initial-y;initial-z <=> root.initial-z;initial-p <=> root.initial-p;
                    paused:root.solver-paused;control(i)=>{root.solver-control(i);}
                    busy:root.wb-busy;can-run:root.can-run-workbench;progress:root.wb-solve-progress;
                    target-courant <=> root.wb-target-courant;min-time-step <=> root.wb-min-time-step;max-time-step <=> root.wb-max-time-step;time-growth <=> root.wb-time-growth;
                    wall-summary:root.post-wall-summary;
                    coupling-algorithm <=> root.wb-coupling-algorithm;pressure-correctors <=> root.wb-pressure-correctors;nonorthogonal-correctors <=> root.wb-nonorthogonal-correctors;nonorthogonal-limiter <=> root.wb-nonorthogonal-limiter;
                    max-diffusion <=> root.wb-max-diffusion;end-time <=> root.wb-end-time;time-mode <=> root.wb-time-mode;time-step <=> root.wb-time-step;time-steps <=> root.wb-time-steps;
                    edit-volume-models=>{root.open-volume-models();}
                    edit-equations=>{root.open-equation-controls();}
                    nu-tilda <=> root.wb-nu-tilda;
                    turbulence-relaxation <=> root.wb-turbulence-relaxation;turbulence-tolerance <=> root.wb-turbulence-tolerance;wall-treatment <=> root.wb-wall-treatment;turbulence-model <=> root.wb-turbulence-model;turbulence-k <=> root.wb-turbulence-k;turbulence-omega <=> root.wb-turbulence-omega;turbulence-epsilon <=> root.wb-turbulence-epsilon;
                    cpu-limit:root.wb-cpu-limit;cpu-threads <=> root.wb-cpu-threads;iterations <=> root.wb-max-iterations;velocity-relaxation <=> root.wb-velocity-relaxation;
                    convection-index <=> root.wb-convection-index;
                    pressure-relaxation <=> root.wb-pressure-relaxation;continuity-tolerance <=> root.wb-continuity-tolerance;
                    coupling-tolerance <=> root.wb-coupling-tolerance;
                    apply=>{root.apply-solver-settings-wb();}run=>{root.run-workbench();}cancel=>{root.cancel-workbench-job();}
                    edit-material=>{root.open-material-editor();}
                    export-history=>{root.post-export(3);}export-chart=>{root.post-export(6);}export-vector=>{root.post-export(11);}
                }
                if !root.examples-open && root.current-step == 4 : ResultsWorkspace {warning:root.post-result-warning;manage-plane(i)=>{root.flow-plane-manage(i);}
                    width:parent.width;height:parent.height;
                    plane-frame:root.flow-plane-frame;plane-count:root.flow-plane-count;plane-fps <=> root.flow-plane-fps;plane-loop <=> root.flow-plane-loop;plane-first <=> root.flow-plane-first;plane-last <=> root.flow-plane-last;plane-playing:root.flow-plane-playing;playback(i)=>{root.flow-plane-playback(i);}
                    plane-image:root.flow-plane-image;plane-readout:root.flow-plane-readout;plane-navigate(a,x,y,w,h)=>{root.flow-plane-navigate(a,x,y,w,h);}plane-names:root.flow-plane-names;plane-index <=> root.flow-plane-index;plane-every <=> root.flow-plane-every;plane-enabled <=> root.flow-plane-enabled;
                    busy:root.wb-busy;plane-details:root.flow-plane-details;plane-status:root.flow-plane-status;
                    plane-palette <=> root.flow-plane-palette;plane-density <=> root.flow-plane-density;plane-scale <=> root.flow-plane-scale;plane-plot <=> root.flow-plane-plot;plane-levels <=> root.flow-plane-levels;plane-streamlines <=> root.flow-plane-streamlines;plane-field <=> root.flow-plane-field;plane-vectors <=> root.flow-plane-vectors;plane-edges <=> root.flow-plane-edges;plane-normalize <=> root.flow-plane-normalize;plane-normal-marks <=> root.flow-plane-normal-marks;plane-min <=> root.flow-plane-min;plane-max <=> root.flow-plane-max;
                    style-plane=>{root.flow-plane-style();}select-plane(i)=>{root.flow-plane-select(i);}apply-plane=>{root.flow-plane-apply();}view-plane=>{root.flow-plane-view();}export-plane(i)=>{root.flow-plane-export(i);}plane-profile(a,b,c,d,n,k)=>{root.flow-plane-profile(a,b,c,d,n,k);}
                    force-patch-names:root.force-patch-names;force-apply(a)=>{root.force-apply(a);}force-image:root.force-image;force-caption:root.force-caption;force-reattach <=> root.force-reattach;
                    force-patches <=> root.force-patches;force-frequency-start <=> root.force-frequency-start;force-speed <=> root.force-speed;force-area <=> root.force-area;force-length <=> root.force-length;force-center <=> root.force-center;force-drag <=> root.force-drag;force-lift <=> root.force-lift;force-start <=> root.force-start;force-axis <=> root.force-axis;force-tolerance <=> root.force-tolerance;
                    wall-summary:root.post-wall-summary;has-wall-report:root.post-has-wall-report;has-wall-samples:root.post-has-wall-samples;
                    tab <=> root.post-tab;
                    balance:root.post-balance;profile-image:root.post-profile-image;profile-caption:root.post-profile-caption;
                    line-x0 <=> root.post-line-x0;line-y0 <=> root.post-line-y0;line-x1 <=> root.post-line-x1;line-y1 <=> root.post-line-y1;line-samples <=> root.post-line-samples;
                    monitor-kind <=> root.post-monitor-kind;plot-mode <=> root.post-plot-mode;compare(i)=>{root.post-compare(i);}sample-line(preset)=>{root.post-profile(preset);}
                    preview:root.visualization-image;title:root.visualization-title;summary:root.residual-summary;
                    legend:root.post-legend;probe:root.result-probe-text;statistics:root.post-statistics;log:root.log-text;
                    feedback:root.post-feedback;export-status:root.post-export-status;has-result:root.post-has-result;is-3d:root.post-is-3d;
                    playing:root.post-playing;export-busy:root.post-export-busy;phase:root.post-phase;probe-count:root.post-probe-count;
                    probes:root.post-probe-model;runs:root.post-run-model;run-index:root.post-run-index;field-index:root.result-field-index;
                    plot <=> root.result-plot-index;palette <=> root.result-colormap-index;levels <=> root.result-contour-levels;
                    range-min <=> root.result-range-min;range-max <=> root.result-range-max;
                    vector-density <=> root.result-vector-density;vector-scale <=> root.result-vector-scale;edges <=> root.post-edges;
                    section-names:root.result-section-names;select-section(i)=>{root.result-section-selected(i);}
                    slice-axis <=> root.result-slice-axis;slice-percent <=> root.result-slice-percent;
                    animation-mode <=> root.post-animation-mode;animation-rate <=> root.post-animation-rate;
                    select-run(index)=>{root.post-select-run(index);}select-field(index)=>{root.select-result-field(index);}
                    style=>{if root.result-slice-axis>=4 {root.plane-display-style();}else{root.apply-result-style();}}
                    apply-range=>{if root.result-slice-axis>=4 {root.plane-display-style();}else{root.apply-result-range();}}
                    auto-range=>{if root.result-slice-axis>=4 {root.result-range-min="";root.result-range-max="";root.plane-display-style();}else{root.reset-result-range();}}
                    action(index)=>{root.post-action(index);}export(index)=>{root.post-export(index);}export-cells=>{root.export-result-csv();}
                    seek(value)=>{root.post-seek(value);}select-probe(index)=>{root.post-select-probe(index);}
                    pick(x,y,w,h)=>{root.pick-boundary(x,y,w,h);}hover(x,y,w,h)=>{root.mesh-hover(x,y,w,h);}
                    orientation:root.cad-orientation-image;view-axis:root.geometry-view-axis;
                    pan(dx,dy,w,h)=>{root.viewport-pan(dx,dy,w,h);}
                    view(axis)=>{root.select-geometry-view-axis(axis);}
                    pick-orientation(x,y)=>{root.cad-pick-orientation(x,y);}
                    drag(x,y,px,py,w,h)=>{root.post-view-drag(x,y,px,py,w,h);}drag-end=>{root.mesh-view-end();}
                    zoom(value)=>{root.post-view-zoom(value);}fit=>{root.post-view-fit();}
                }

                }

                // Properties are docked on the left.

            }
        }

        StatusBar {
            compact-ui: root.compact-ui;
            project-loaded: root.project-loaded;
            current-step: root.current-step;
            threads: root.wb-cpu-threads;
            status: root.status;
            status-cells: root.status-cells;
            status-iteration: root.status-iteration;
            status-continuity: root.status-continuity;
            project-path: root.project-path;
        }
    }
    if root.recovery-pending : RecoveryDialog {
            x:0px;y:0px;width:root.width;height:root.height;
            compact-ui: root.compact-ui;
            workspace: root.recovery-workspace;
            recover => { root.recover-workspace(); }
            discard => { root.discard-workspace-recovery(); }
        }
    if root.unsaved-replacement-pending : UnsavedChangesDialog {
            x:0px;y:0px;width:root.width;height:root.height;
            compact-ui: root.compact-ui;
            save => { root.save-before-project-replacement(); }
            discard => { root.discard-before-project-replacement(); }
            cancel => { root.cancel-project-replacement(); }
        }

    if root.volume-models-open : VolumeModelsDialog {
        draft <=> root.volume-model-draft;feedback:root.volume-model-feedback;busy:root.wb-busy;
        apply=>{root.apply-volume-models();}cancel=>{root.volume-models-open=false;}
    }
    if root.equation-controls-open : EquationControlsDialog {
        rows <=> root.equation-drafts;feedback:root.equation-feedback;busy:root.wb-busy;
        apply=>{root.apply-equation-controls();}cancel=>{root.equation-controls-open=false;}
    }
    if root.library-open : MaterialLibraryDialog {
        x:0px;y:0px;width:root.width;height:root.height;
        entries <=> root.library-entries;selected <=> root.library-selected;filter <=> root.library-filter;
        details:root.library-details;feedback:root.library-feedback;busy:root.library-busy;draft <=> root.library-draft;
        quantity <=> root.library-quantity;tmin <=> root.library-tmin;tmax <=> root.library-tmax;pressure <=> root.library-pressure;curve:root.library-curve;
        close=>{root.library-open=false;}refresh=>{root.refresh-library();}choose=>{root.select-library();}evaluate=>{root.evaluate-library();}create=>{root.create-library-material();}copy=>{root.copy-library-material();}
    }
    if root.transport-open : TransportDialog {
        x:0px;y:0px;width:root.width;height:root.height;
        draft <=> root.transport-draft;boundaries <=> root.transport-boundaries;regions <=> root.transport-regions;contacts <=> root.transport-contacts;
        ready:root.transport-ready;orientation:root.transport-orientation;view-axis <=> root.transport-view-axis;running:root.transport-running;paused:root.transport-paused;has-restart:root.transport-has-restart;three-d:root.transport-three-d;
        status:root.transport-status;progress:root.transport-progress;output:root.transport-output;preview:root.transport-image;
        cut <=> root.transport-cut;cut-position <=> root.transport-cut-position;cut-reverse <=> root.transport-cut-reverse;range-min <=> root.transport-range-min;range-max <=> root.transport-range-max;field <=> root.transport-field;edges <=> root.transport-edges;frame <=> root.transport-frame;frames:root.transport-frames;playing <=> root.transport-playing;
        close=>{root.transport-open=false;root.transport-playing=false;}
        apply=>{root.save-transport();}start=>{root.run-transport();}stop=>{root.stop-transport();}pause=>{root.pause-transport();}resume=>{root.resume-transport();}initialize=>{root.reset-transport();}
        import-settings=>{root.import-transport();}export-settings=>{root.export-transport();}use-flow=>{root.use-transport-flow();}load-restart=>{root.load-transport-restart();}open-archive=>{root.open-transport-archive();}
        add-region=>{root.add-transport-region();}remove-region(index)=>{root.remove-transport-region(index);}add-contact=>{root.add-transport-contact();}remove-contact(index)=>{root.remove-transport-contact(index);}
        refresh-view=>{root.refresh-transport();}show-frame(index)=>{root.select-transport-frame(index);}orbit(x,y,w,h)=>{root.orbit-transport(x,y,w,h);}zoom(delta)=>{root.zoom-transport(delta);}home=>{root.home-transport();}orbit-end=>{root.end-transport-orbit();}pan(x,y,w,h)=>{root.pan-transport(x,y,w,h);}axis(index)=>{root.axis-transport(index);}pick-orientation(x,y)=>{root.pick-transport-orientation(x,y);}
    }
    if root.script-editor-open : ScriptEditorDialog {
        names:root.script-names;index <=> root.script-index;
        script-name <=> root.script-name;source <=> root.script-source;timed <=> root.script-timed;
        function-name <=> root.script-function;parameters <=> root.script-parameters;quantity <=> root.script-quantity;
        patch:root.script-patch;feedback:root.script-feedback;busy:root.wb-busy;
        preview-position <=> root.script-preview-position;preview-time <=> root.script-preview-time;
        load(i)=>{root.load-script(i);}new-template=>{root.script-template();}
        save=>{root.save-script();}attach=>{root.attach-script();}detach=>{root.detach-script();}
        delete=>{root.delete-script();}preview=>{root.preview-script();}
        close-requested=>{root.script-editor-open=false;}
    }
    if root.material-dialog-open : FluidMaterialDialog {
        x:0px;y:0px;width:root.width;height:root.height;
        density <=> root.material-draft-density;viscosity <=> root.material-draft-viscosity;
        catalog-names:root.material-catalog-names;catalog-index <=> root.material-catalog-index;eval-temperature <=> root.material-eval-temperature;eval-pressure <=> root.material-eval-pressure;source:root.material-source;
        enabled-energy <=> root.thermal-enabled;initial <=> root.thermal-initial;cp <=> root.thermal-cp;kappa <=> root.thermal-kappa;heat-source <=> root.thermal-volume-source;wall-treatment <=> root.thermal-wall-treatment;prt <=> root.thermal-prt;relaxation <=> root.thermal-relaxation;tolerance <=> root.thermal-tolerance;
        max-fraction <=> root.thermal-max-fraction;three-d:root.mesh-dimension-index==1;buoyancy <=> root.thermal-buoyancy;reference <=> root.thermal-reference;beta <=> root.thermal-beta;gx <=> root.thermal-gx;gy <=> root.thermal-gy;gz <=> root.thermal-gz;
        load-catalog=>{root.load-material-catalog();}
        import-catalog=>{root.import-material-catalog();}
        backup-catalog=>{root.backup-material-catalog();}
        feedback:root.material-dialog-feedback;busy:root.wb-busy || root.material-catalog-busy;
        cancel=>{root.material-dialog-open=false;}
        apply=>{if root.apply-fluid-material(root.material-draft-density,root.material-draft-viscosity) {root.material-dialog-open=false;}}
    }


    if root.project-name-open : ProjectNameDialog {
        name <=> root.project-name-draft;feedback:root.project-name-feedback;
        cancel=>{root.project-name-open=false;}
        apply=>{if root.apply-project-name(root.project-name-draft) {root.project-name-open=false;}}
    }
    if root.compute-open : ComputeDialog {
        backend <=> root.compute-backend;threads <=> root.compute-threads;gpu-index <=> root.compute-gpu-index;
        display-index <=> root.compute-display-index;fallback <=> root.compute-fallback;parallel-rows <=> root.compute-parallel-rows;
        basis-mb <=> root.compute-basis-mb;preconditioner <=> root.compute-preconditioner;restart <=> root.compute-restart;inner <=> root.compute-inner;sweeps <=> root.compute-sweeps;timeout <=> root.compute-timeout;
        gpu-rows <=> root.compute-gpu-rows;memory-percent <=> root.compute-memory-percent;cpu-display <=> root.compute-cpu-display;
        fps <=> root.compute-fps;adapters:root.compute-adapters;information:root.compute-information;feedback:root.compute-feedback;
        cancel=>{root.compute-open=false;}apply=>{if root.apply-compute() {root.compute-open=false;}}
    }
    if root.settings-open : SettingsDialog {
        compute=>{root.settings-open=false;root.open-compute();}
        browser:root.show-browser;topology:root.show-topology;
        panel-size:root.preferences-panel-size;
        gmsh-path <=> root.gmsh-path-draft;
        browse-gmsh=>{root.browse-gmsh();}
        cancel=>{root.settings-open=false;}
        apply(browser,topology,size,gmsh)=>{
            root.preferences-gmsh-path=gmsh;
            root.show-browser=browser;root.show-topology=topology;
            root.preferences-panel-size=size;
            UiTheme.properties-width=size==0 ? 270px : size==2 ? 340px : 300px;
            root.refresh-browser();root.save-preferences();root.settings-open=false;
        }
    }
}
