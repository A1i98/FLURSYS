import { Button, ComboBox, LineEdit, SpinBox, TextEdit, ScrollView } from "std-widgets.slint";
import { SectionTitle, SectionHint, Card, MetricCard, InteractiveGeometryPreview, WorkflowItem } from "components.slint";

global UiTheme {
    in property <color> background: rgb(11, 19, 26);
    in property <color> sidebar: rgb(14, 25, 34);
    in property <color> toolbar: rgb(18, 32, 43);
    in property <color> topbar: rgb(20, 37, 49);
    in property <color> viewport: rgb(9, 16, 22);

    in property <color> border: rgb(47, 74, 91);
    in property <color> border-soft: rgb(37, 58, 73);
    in property <color> border-strong: rgb(50, 79, 99);
    in property <color> viewport-border: rgb(40, 66, 82);
    in property <color> divider: rgb(58, 85, 102);
    in property <color> divider-strong: rgb(65, 94, 112);

    in property <color> accent: rgb(240, 195, 109);
    in property <color> text-title: rgb(233, 242, 248);
    in property <color> text-bright: rgb(226, 237, 245);
    in property <color> text: rgb(213, 227, 236);
    in property <color> text-alt: rgb(205, 220, 229);
    in property <color> text-muted: rgb(140, 167, 185);
    in property <color> text-dim: rgb(132, 161, 180);
    in property <color> text-faint: rgb(126, 153, 170);
    in property <color> text-soft: rgb(163, 188, 203);
    in property <color> text-subtle: rgb(180, 202, 214);
    in property <color> text-mid: rgb(190, 209, 220);
    in property <color> text-secondary: rgb(198, 215, 224);
    in property <color> text-tree: rgb(184, 207, 219);
    in property <color> text-project: rgb(215, 229, 238);
    in property <color> text-label: rgb(136, 164, 182);
    in property <color> text-overlay: rgb(145, 174, 190);
}


export component MainWindow inherits Window {
    title: "FLURSYS | CFD Workbench";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 900px;
    min-height: 650px;
    background: UiTheme.background;

    // Keep the responsive size-class independent from Window layout constraints.
    // Binding this directly to root.width creates a cycle:
    // root.width -> compact-ui -> child layoutinfo -> root.layoutinfo -> root.width.
    // The backend may toggle this property on resize if automatic compact mode is desired.
    in-out property <bool> compact-ui: false;
    property <length> page-padding: root.compact-ui ? 14px : 24px;
    property <length> page-spacing: root.compact-ui ? 10px : 16px;
    property <length> sidebar-preferred-width: root.compact-ui ? 176px : 224px;

    in-out property <int> current-step: 0;
    in-out property <int> case-index: 0;
    in-out property <int> part-kind-index: 0;
    in-out property <int> sketch-kind-index: 0;
    in-out property <int> feature-kind-index: 0;
    in-out property <string> sketch-name: "Sketch 1";
    in-out property <string> feature-name: "Extrude 1";
    in-out property <string> sketch-size-x: "1.0";
    in-out property <string> sketch-size-y: "1.0";
    in-out property <string> sketch-pos-x: "0.0";
    in-out property <string> sketch-pos-y: "0.0";
    in-out property <string> sketch-pos-z: "0.0";
    in-out property <string> feature-depth: "1.0";
    in-out property <string> revolve-axis-offset: "1.0";
    in-out property <string> driving-dimension: "1.0";
    in-out property <string> part-name: "Part 1";
    in-out property <string> part-size-x: "1.0";
    in-out property <string> part-size-y: "1.0";
    in-out property <string> part-size-z: "1.0";
    in-out property <string> part-pos-x: "0.0";
    in-out property <string> part-pos-y: "0.0";
    in-out property <string> part-pos-z: "0.0";
    in-out property <string> geometry-parts-summary: "No custom solids in this project.";
    in-out property <string> geometry-model-tree: "▾ Geometry\n   ▾ Sketches (0)\n      — None\n   ▾ Features (0)\n      — None\n   ▾ Solids (0)\n      — None";
    in-out property <bool> project-loaded: false;
    in-out property <int> geometry-sidebar-tab: 0;
    in-out property <string> status: "Idle";
    in-out property <string> project-path: "case.flursys.json";
    in-out property <string> project-name: "Lid-driven cavity";
    in-out property <string> case-name: "Lid-driven cavity";
    in-out property <int> nx: 64;
    in-out property <int> ny: 64;
    in-out property <string> dt-text: "0.001";
    in-out property <int> iterations: 10000;
    in-out property <int> threads: 0;
    in-out property <int> gui-update-every: 10;
    in-out property <int> history-every: 10;
    in-out property <int> frame-every: 100;
    in-out property <int> coupling-index: 0;
    in-out property <int> pressure-solver-index: 0;
    in-out property <string> velocity-relaxation: "0.7";
    in-out property <string> pressure-relaxation: "0.3";
    in-out property <string> extrusion-depth: "0.25";
    in-out property <int> mesh-nz: 8;
    in-out property <string> mesh-inspection: "Mesh inspection is waiting for a valid grid.";
    in-out property <int> boundary-face-index: 0;
    in-out property <int> boundary-kind-index: 0;
    in-out property <string> boundary-value: "0.0";
    in-out property <string> boundary-summary: "No boundary summary available.";
    in-out property <string> preflight-summary: "Run validation before starting the solver.";
    in-out property <int> energy-model-index: 0;
    in-out property <string> initial-temperature: "293.15";
    in-out property <string> thermal-diffusivity: "0.000022";
    in-out property <string> thermal-source: "0.0";
    in-out property <int> thermal-face-index: 0;
    in-out property <int> thermal-boundary-kind-index: 0;
    in-out property <string> thermal-boundary-value: "293.15";
    in-out property <int> buoyancy-model-index: 0;
    in-out property <string> reference-temperature: "293.15";
    in-out property <string> thermal-expansion: "0.0034";
    in-out property <string> gravity-x: "0.0";
    in-out property <string> gravity-y: "-9.81";
    in-out property <int> result-field-index: 0;
    in-out property <int> result-plot-index: 2;
    in-out property <int> result-colormap-index: 0;
    in-out property <int> result-contour-levels: 12;
    in-out property <string> residual-summary: "Waiting for a solver run.";
    in-out property <float> solver-physical-time: 0.0;
    in-out property <float> solver-time-step: 0.0;
    in-out property <float> solver-momentum-cfl: 0.0;
    in-out property <float> solver-viscous-number: 0.0;
    in-out property <float> solver-max-speed: 0.0;
    in-out property <string> solver-stability-summary: "Time       0.0000e+0\ndt         0.0000e+0\nCFL        0.0000e+0\nDν         0.0000e+0\n|U|max     0.0000e+0";
    in-out property <image> residual-image;
    in-out property <float> continuity-level: 0.0;
    in-out property <float> momentum-level: 0.0;
    in-out property <float> pressure-level: 0.0;
    in-out property <string> force-summary: "Cd: —\nCl: —";
    in-out property <string> field-summary: "No field snapshot received.";
    in-out property <image> visualization-image;
    in-out property <image> sketch-image;
    in-out property <bool> sketch-editing: false;
    in-out property <string> sketch-status: "Start a sketch to edit a 2D profile.";
    in-out property <string> visualization-title: "MESH PREVIEW";
    in-out property <string> animation-status: "Frame 0 / 0";
    in-out property <int> geometry-view-axis: 3;
    in-out property <string> log-text: "FLURSYS Slint workbench ready.";

    callback new-project(); callback start(); callback pause(); callback resume(); callback stop(); callback validate-case();
    callback load-project(); callback save-project(); callback show-mesh(); callback show-field();
    callback animation-play-pause(); callback animation-next(); callback show-geometry-3d();
    callback rotate-geometry-3d(); callback apply-boundary(); callback show-boundary-face(); callback select-step(int);
    callback select-case(); callback add-part(); callback build-feature(); callback duplicate-last-part(); callback remove-last-part();
    callback apply-thermal-boundary(); callback select-result-field(int); callback apply-result-style();
    callback geometry-drag(float, float, float, float); callback geometry-zoom(float); callback reset-geometry-view(); callback select-geometry-view-axis(int);
    callback pick-boundary(float, float, float, float);
    callback start-sketch(); callback select-sketch-tool(int); callback sketch-click(float, float, float, float); callback sketch-preview(float, float, float, float); callback sketch-undo(); callback sketch-redo(); callback apply-driving-dimension();

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            min-height: 56px;
            preferred-height: 60px;
            max-height: 64px;
            background: UiTheme.topbar;
            border-color: UiTheme.border-strong;
            border-width: 1px;

            HorizontalLayout {
                padding-left: root.compact-ui ? 10px : 14px;
                padding-right: root.compact-ui ? 10px : 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: root.compact-ui ? 8px : 11px;

                Text {
                    text: "FLURSYS";
                    color: UiTheme.text-title;
                    font-size: root.compact-ui ? 19px : 23px;
                    font-weight: 800;
                    vertical-alignment: center;
                }

                if !root.compact-ui : Rectangle { width: 1px; background: UiTheme.divider-strong; }
                if !root.compact-ui : Text {
                    text: "CFD WORKBENCH";
                    color: UiTheme.text-label;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Button { text: "NEW PROJECT"; clicked => { root.new-project(); } }
                Rectangle { horizontal-stretch: 1; }

                if !root.compact-ui : Text {
                    text: "PROJECT";
                    color: UiTheme.text-label;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.project-loaded ? root.project-name : "No project loaded";
                    color: UiTheme.text-project;
                    font-size: 12px;
                    max-width: root.compact-ui ? 170px : 260px;
                    overflow: elide;
                    vertical-alignment: center;
                }

                Rectangle { width: 1px; background: UiTheme.divider-strong; }

                Text {
                    text: "SOLVER";
                    color: UiTheme.text-label;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.status;
                    color: UiTheme.accent;
                    font-size: 12px;
                    font-weight: 700;
                    max-width: root.compact-ui ? 100px : 160px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                min-width: root.compact-ui ? 164px : 196px;
                preferred-width: root.sidebar-preferred-width;
                max-width: root.compact-ui ? 184px : 236px;
                background: UiTheme.sidebar;
                border-color: UiTheme.border-soft;
                border-width: 1px;

                VerticalLayout {
                    padding: root.compact-ui ? 9px : 12px;
                    spacing: root.compact-ui ? 6px : 8px;

                    Text {
                        text: root.compact-ui ? "WORKFLOW" : "SIMULATION WORKFLOW";
                        color: UiTheme.text-dim;
                        font-size: 10px;
                        font-weight: 700;
                    }

                    WorkflowItem { number: "01"; title: "Geometry"; detail: root.compact-ui ? "" : "Choose domain and project"; active: root.current-step == 0; select => { root.select-step(0); } }
                    WorkflowItem { number: "02"; title: "Mesh"; detail: root.compact-ui ? "" : "Structured volume controls"; active: root.current-step == 1; select => { root.select-step(1); } }
                    WorkflowItem { number: "03"; title: "Setup"; detail: root.compact-ui ? "" : "Boundaries and physics"; active: root.current-step == 2; select => { root.select-step(2); } }
                    WorkflowItem { number: "04"; title: "Run"; detail: root.compact-ui ? "" : "Solver and convergence"; active: root.current-step == 3; select => { root.select-step(3); } }
                    WorkflowItem { number: "05"; title: "Results"; detail: root.compact-ui ? "" : "Fields and animation"; active: root.current-step == 4; select => { root.select-step(4); } }

                    Rectangle { vertical-stretch: 1; }
                    Rectangle { height: 1px; background: UiTheme.border-soft; }

                    if !root.compact-ui : Text {
                        text: "Active numerical core";
                        color: UiTheme.text-label;
                        font-size: 10px;
                    }

                    Text {
                        text: root.compact-ui ? "2D FVM · 3D preview" : "2D structured FVM\n3D workbench preview";
                        color: UiTheme.text-mid;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: UiTheme.background;

                if root.current-step == 0 : Rectangle {
                    width: parent.width; height: parent.height;
                    VerticalLayout {
                        padding: 8px; spacing: 6px;
                        Rectangle {
                            min-height: 102px;
                            preferred-height: root.compact-ui ? 108px : 112px;
                            max-height: 116px;
                            background: UiTheme.toolbar;
                            border-color: UiTheme.border;
                            border-width: 1px;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 5px;

                                    Text { text: "SKETCH"; color: UiTheme.accent; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                    Rectangle { width: 1px; background: UiTheme.divider; }

                                    Button { text: "NEW SKETCH"; clicked => { root.start-sketch(); } }
                                    Button { text: "SELECT"; clicked => { root.select-sketch-tool(0); } }
                                    Button { text: "LINE"; clicked => { root.select-sketch-tool(8); } }
                                    Button { text: "RECT"; clicked => { root.select-sketch-tool(1); } }
                                    Button { text: "SQUARE"; clicked => { root.select-sketch-tool(2); } }
                                    Button { text: "CIRCLE"; clicked => { root.select-sketch-tool(3); } }
                                    Button { text: "DIM"; clicked => { root.select-sketch-tool(4); } }

                                    Rectangle { horizontal-stretch: 1; }
                                }

                                HorizontalLayout {
                                    spacing: 5px;

                                    Text { text: "EDIT / FEATURE"; color: UiTheme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; }

                                    Button { text: "HORIZONTAL"; clicked => { root.select-sketch-tool(6); } }
                                    Button { text: "VERTICAL"; clicked => { root.select-sketch-tool(7); } }
                                    Button { text: "TRIM"; clicked => { root.select-sketch-tool(5); } }
                                    Button { text: "UNDO"; clicked => { root.sketch-undo(); } }
                                    Button { text: "REDO"; clicked => { root.sketch-redo(); } }

                                    Rectangle { width: 1px; background: UiTheme.divider; }

                                    Button { text: "EXTRUDE"; clicked => { root.feature-kind-index = 0; } }
                                    Button { text: "REVOLVE"; clicked => { root.feature-kind-index = 1; } }
                                    Button { text: "BUILD"; clicked => { root.build-feature(); } }

                                    Rectangle { horizontal-stretch: 1; }
                                }

                                HorizontalLayout {
                                    spacing: 5px;

                                    Text { text: "SOLID"; color: UiTheme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                    Button { text: "BOX"; clicked => { root.part-kind-index = 0; } }
                                    Button { text: "CYL"; clicked => { root.part-kind-index = 1; } }

                                    if !root.compact-ui : Button { text: "CONE"; clicked => { root.part-kind-index = 2; } }
                                    if !root.compact-ui : Button { text: "SPHERE"; clicked => { root.part-kind-index = 3; } }
                                    if !root.compact-ui : Button { text: "TORUS"; clicked => { root.part-kind-index = 4; } }

                                    Button { text: "ADD SOLID"; clicked => { root.add-part(); } }

                                    Rectangle { width: 1px; background: UiTheme.divider; }

                                    Button { text: "DUPLICATE"; clicked => { root.duplicate-last-part(); } }
                                    Button { text: "DELETE"; clicked => { root.remove-last-part(); } }

                                    Rectangle { horizontal-stretch: 1; }

                                    Text { text: "VIEW"; color: UiTheme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                    Button { text: "FIT"; clicked => { root.reset-geometry-view(); } }
                                    Button { text: "3D"; clicked => { root.show-geometry-3d(); } }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Card {
                                min-width: 218px;
                                preferred-width: root.compact-ui ? 238px : 280px;
                                max-width: 330px;
                                horizontal-stretch: 1;

                                VerticalLayout {
                                    padding: root.compact-ui ? 10px : 14px;
                                    spacing: 8px;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        Button { text: "MODEL"; clicked => { root.geometry-sidebar-tab = 0; } }
                                        Button { text: "PROJECT"; clicked => { root.geometry-sidebar-tab = 1; } }
                                        Button { text: root.compact-ui ? "INSPECT" : "INSPECTOR"; clicked => { root.geometry-sidebar-tab = 2; } }
                                    }

                                    ScrollView {
                                        vertical-stretch: 1;
                                        horizontal-scrollbar-policy: always-off;

                                        VerticalLayout {
                                            spacing: 8px;
                                    if root.geometry-sidebar-tab == 0 : VerticalLayout {
                                        Text { text: "MODEL TREE"; color: UiTheme.accent; font-size: 11px; font-weight: 800; }
                                        Text { text: "▾  " + root.project-name; color: UiTheme.text-bright; font-size: 13px; font-weight: 700; }
                                        Text { text: root.geometry-model-tree; color: UiTheme.text-tree; font-family: "monospace"; font-size: 10px; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: UiTheme.border; }
                                        Text { text: "ACTIVE BODY"; color: UiTheme.text-dim; font-size: 10px; font-weight: 700; }
                                        Text { text: root.geometry-parts-summary; color: UiTheme.text-secondary; font-size: 11px; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: UiTheme.border; }
                                        Text { text: "PRIMITIVE"; color: UiTheme.text-muted; font-size: 10px; font-weight: 700; }
                                        ComboBox { model: ["Box", "Cylinder", "Cone", "Sphere", "Torus"]; current-index <=> root.part-kind-index; }
                                        LineEdit { text <=> root.part-name; placeholder-text: "Solid name"; }
                                        HorizontalLayout {
                                            LineEdit { text <=> root.part-size-x; placeholder-text: "X / R"; }
                                            LineEdit { text <=> root.part-size-y; placeholder-text: "Y"; }
                                            LineEdit { text <=> root.part-size-z; placeholder-text: "Z / H"; }
                                        }
                                        Text { text: "POSITION (mm)"; color: UiTheme.text-faint; font-size: 10px; font-weight: 700; }
                                        HorizontalLayout {
                                            LineEdit { text <=> root.part-pos-x; placeholder-text: "X"; }
                                            LineEdit { text <=> root.part-pos-y; placeholder-text: "Y"; }
                                            LineEdit { text <=> root.part-pos-z; placeholder-text: "Z"; }
                                        }
                                        Button { text: "ADD SOLID"; clicked => { root.add-part(); } }
                                        Rectangle { vertical-stretch: 1; }
                                    }
                                    if root.geometry-sidebar-tab == 1 : VerticalLayout {
                                        Text { text: "CASE / DOMAIN"; color: UiTheme.accent; font-size: 11px; font-weight: 800; }
                                        ComboBox { model: ["Lid-driven cavity", "Cylinder flow Re=100", "Backward-facing step", "Channel flow (Poiseuille)"]; current-index <=> root.case-index; }
                                        Button { text: "SET ACTIVE DOMAIN"; clicked => { root.select-case(); } }
                                        Text { text: "Project"; color: UiTheme.text-muted; font-size: 10px; }
                                        LineEdit { text <=> root.project-name; }
                                        Text { text: "File"; color: UiTheme.text-muted; font-size: 10px; }
                                        LineEdit { text <=> root.project-path; }
                                        HorizontalLayout { Button { text: "LOAD"; clicked => { root.load-project(); } } Button { text: "SAVE"; clicked => { root.save-project(); } } }
                                        Rectangle { vertical-stretch: 1; }
                                    }
                                    if root.geometry-sidebar-tab == 2 : VerticalLayout {
                                        Text { text: "INSPECTOR"; color: UiTheme.accent; font-size: 11px; font-weight: 800; }
                                        Text { text: "SKETCH"; color: UiTheme.text-muted; font-size: 10px; font-weight: 700; }
                                        ComboBox { model: ["Rectangle", "Circle"]; current-index <=> root.sketch-kind-index; }
                                        LineEdit { text <=> root.sketch-name; placeholder-text: "Sketch name"; }
                                        Text { text: "PROFILE SIZE (mm)"; color: UiTheme.text-muted; font-size: 10px; font-weight: 700; }
                                        HorizontalLayout {
                                            LineEdit { text <=> root.sketch-size-x; placeholder-text: root.sketch-kind-index == 0 ? "Width" : "Radius"; }
                                            LineEdit { text <=> root.sketch-size-y; placeholder-text: root.sketch-kind-index == 0 ? "Height" : "Reference"; }
                                        }
                                        Text { text: "ORIGIN (mm)"; color: UiTheme.text-muted; font-size: 10px; font-weight: 700; }
                                        HorizontalLayout {
                                            LineEdit { text <=> root.sketch-pos-x; placeholder-text: "X"; }
                                            LineEdit { text <=> root.sketch-pos-y; placeholder-text: "Y"; }
                                            LineEdit { text <=> root.sketch-pos-z; placeholder-text: "Z"; }
                                        }
                                        Rectangle { height: 1px; background: UiTheme.border; }
                                        Text { text: "DRIVING DIMENSION (select a line/circle, mm)"; color: UiTheme.accent; font-size: 10px; font-weight: 700; wrap: word-wrap; }
                                        HorizontalLayout { LineEdit { text <=> root.driving-dimension; placeholder-text: "Length / radius"; } Button { text: "APPLY"; clicked => { root.apply-driving-dimension(); } } }
                                        Text { text: "Selection fills the current value. Applying updates the same persistent driving dimension."; color: UiTheme.text-faint; font-size: 10px; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: UiTheme.border; }
                                        Text { text: "FEATURE"; color: UiTheme.text-muted; font-size: 10px; font-weight: 700; }
                                        ComboBox { model: ["Extrude", "Revolve (360°)"]; current-index <=> root.feature-kind-index; }
                                        LineEdit { text <=> root.feature-name; placeholder-text: "Feature name"; }
                                        if root.feature-kind-index == 0 : LineEdit { text <=> root.feature-depth; placeholder-text: "Extrude depth (mm)"; }
                                        if root.feature-kind-index == 1 : LineEdit { text <=> root.revolve-axis-offset; placeholder-text: "Axis offset (mm)"; }
                                        HorizontalLayout {
                                            Button { text: "BUILD"; clicked => { root.build-feature(); } }
                                            Button { text: "DUPLICATE"; clicked => { root.duplicate-last-part(); } }
                                            Button { text: "DELETE"; clicked => { root.remove-last-part(); } }
                                        }
                                        Rectangle { vertical-stretch: 1; }
                                    }
                                        }
                                    }
                                }
                            }
                            Card {
                                min-width: 360px;
                                horizontal-stretch: 3;
                                VerticalLayout {
                                    padding: 12px; spacing: 8px;
                                    HorizontalLayout { Text { text: root.sketch-editing ? "2D SKETCH EDITOR" : "3D VIEWPORT"; color: UiTheme.accent; font-size: 11px; font-weight: 800; } Rectangle { horizontal-stretch: 1; } Text { text: root.sketch-editing ? "XY PLANE · mm" : "PERSPECTIVE · mm"; color: UiTheme.text-dim; font-size: 10px; } }
                                    if root.sketch-editing : Rectangle {
                                        vertical-stretch: 1;
                                        background: UiTheme.viewport;
                                        border-color: UiTheme.viewport-border;
                                        border-width: 1px;
                                        Image { source: root.sketch-image; width: parent.width; height: parent.height; image-fit: contain; }
                                        Text { x: 10px; y: parent.height - self.height - 8px; text: "CLICK: APPLY ACTIVE SKETCH TOOL  ·  GRID: 0.1 mm  ·  ENDPOINT + AXIS SNAP"; color: UiTheme.text-overlay; font-size: 10px; font-weight: 700; }
                                        TouchArea {
                                            x: 0px; y: 0px;
                                            width: parent.width; height: parent.height;
                                            moved => {
                                                root.sketch-preview(
                                                    self.mouse-x / 1px,
                                                    self.mouse-y / 1px,
                                                    self.width / 1px,
                                                    self.height / 1px,
                                                );
                                            }
                                            clicked => {
                                                root.sketch-click(
                                                    self.mouse-x / 1px,
                                                    self.mouse-y / 1px,
                                                    self.width / 1px,
                                                    self.height / 1px,
                                                );
                                            }
                                        }
                                    }
                                    if !root.sketch-editing : InteractiveGeometryPreview { vertical-stretch: 1; preview-image: root.visualization-image; view-axis: root.geometry-view-axis; orbit(x, y, pressed-x, pressed-y) => { root.geometry-drag(x, y, pressed-x, pressed-y); } zoom(delta) => { root.geometry-zoom(delta); } reset-view => { root.reset-geometry-view(); } select-view-axis(axis) => { root.select-geometry-view-axis(axis); } pick-boundary(x, y, w, h) => { root.pick-boundary(x, y, w, h); } }
                                    HorizontalLayout { Text { text: root.sketch-editing ? root.sketch-status : root.animation-status; color: UiTheme.text-soft; font-size: 10px; vertical-alignment: center; wrap: word-wrap; } Rectangle { horizontal-stretch: 1; } if root.sketch-editing : Button { text: "FINISH SKETCH"; clicked => { root.show-geometry-3d(); } } if !root.sketch-editing : Button { text: "ORBIT"; clicked => { root.rotate-geometry-3d(); } } Button { text: "FIT VIEW"; clicked => { root.reset-geometry-view(); } } }
                                }
                            }

                        }
                    }
                }

                if root.current-step == 1 : Rectangle {
                    width: parent.width; height: parent.height;
                    mesh-scroll := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        horizontal-scrollbar-policy: as-needed;

                        VerticalLayout {
                            min-height: mesh-scroll.visible-height;
                            padding: root.page-padding; spacing: root.page-spacing;
                        SectionTitle { text: "02  Mesh"; }
                        SectionHint { text: "Define the active structured solver grid and retain extrusion layers for the 3D workbench model."; }
                        HorizontalLayout {
                                spacing: root.page-spacing;
                                Card { min-width: 250px; preferred-width: 340px; max-width: 400px; horizontal-stretch: 1; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 10px;
                                Text { text: "STRUCTURED GRID"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                Text { text: "Planar cells"; color: UiTheme.text-muted; font-size: 11px; }
                                HorizontalLayout { Text { text: "Nx"; color: UiTheme.text-alt; vertical-alignment: center; } SpinBox { value <=> root.nx; minimum: 4; maximum: 1024; } Text { text: "Ny"; color: UiTheme.text-alt; vertical-alignment: center; } SpinBox { value <=> root.ny; minimum: 4; maximum: 1024; } }
                                Text { text: "Extrusion layers (Nz)"; color: UiTheme.text-muted; font-size: 11px; }
                                SpinBox { value <=> root.mesh-nz; minimum: 1; maximum: 1024; }
                                Text { text: "Extrusion depth"; color: UiTheme.text-muted; font-size: 11px; }
                                LineEdit { text <=> root.extrusion-depth; }
                                Text { text: "The active solver uses Nx × Ny. Nz is retained in the project and drives the 3D mesh preview."; color: UiTheme.text-faint; font-size: 11px; wrap: word-wrap; }
                                Button { text: "GENERATE MESH PREVIEW"; clicked => { root.show-mesh(); } }
                            } }
                                Card { min-width: 350px; horizontal-stretch: 2; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 10px;
                                Text { text: "MESH INSPECTION"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                Text { text: root.mesh-inspection; color: UiTheme.text-subtle; font-family: "monospace"; font-size: 11px; wrap: word-wrap; }
                                InteractiveGeometryPreview { vertical-stretch: 1; preview-image: root.visualization-image; view-axis: root.geometry-view-axis; orbit(x, y, pressed-x, pressed-y) => { root.geometry-drag(x, y, pressed-x, pressed-y); } zoom(delta) => { root.geometry-zoom(delta); } reset-view => { root.reset-geometry-view(); } select-view-axis(axis) => { root.select-geometry-view-axis(axis); } pick-boundary(x, y, w, h) => { root.pick-boundary(x, y, w, h); } }
                                Text { text: root.visualization-title + " · " + root.animation-status; color: UiTheme.text-soft; font-size: 11px; }
                                HorizontalLayout { Button { text: "2D GRID"; clicked => { root.show-mesh(); } } Button { text: "3D VOLUME"; clicked => { root.show-geometry-3d(); } } }
                            } }
                        }
                    }
                    }
                }

                if root.current-step == 2 : Rectangle {
                    width: parent.width; height: parent.height;
                    setup-scroll := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        horizontal-scrollbar-policy: as-needed;

                        VerticalLayout {
                            min-height: setup-scroll.visible-height;
                            padding: root.page-padding; spacing: root.page-spacing;
                        SectionTitle { text: "03  Setup"; }
                        SectionHint { text: "Assign flow and thermal boundary conditions. Executable energy and Boussinesq controls are saved with the project."; }
                        HorizontalLayout {
                                spacing: root.page-spacing;
                                Card { min-width: 190px; preferred-width: 330px; max-width: 420px; horizontal-stretch: 1; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 9px;
                                Text { text: "BOUNDARY CONDITIONS"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                Text { text: "Boundary face"; color: UiTheme.text-muted; font-size: 11px; }
                                ComboBox { model: ["Left / inlet", "Right / outlet", "Bottom", "Top", "Front", "Back"]; current-index <=> root.boundary-face-index; }
                                Text { text: "Condition"; color: UiTheme.text-muted; font-size: 11px; }
                                ComboBox { model: ["Case default", "Velocity", "Pressure outlet", "Wall", "Symmetry"]; current-index <=> root.boundary-kind-index; }
                                Text { text: "Value  (u for velocity/wall; p for outlet)"; color: UiTheme.text-muted; font-size: 11px; }
                                LineEdit { text <=> root.boundary-value; }
                                HorizontalLayout { Button { text: "APPLY"; clicked => { root.apply-boundary(); } } Button { text: "SHOW FACE"; clicked => { root.show-boundary-face(); } } }
                                Rectangle { height: 1px; background: UiTheme.border; }
                                Text { text: "BOUNDARY SUMMARY"; color: UiTheme.accent; font-size: 10px; font-weight: 700; }
                                Text { text: root.boundary-summary; color: UiTheme.text-subtle; font-family: "monospace"; font-size: 10px; wrap: word-wrap; }
                                Text { text: "Front and back are retained for the future 3D solver. The active 2D solver accepts a pressure outlet on the right face."; color: UiTheme.text-faint; font-size: 11px; wrap: word-wrap; }
                            } }
                                Card { min-width: 200px; preferred-width: 320px; max-width: 410px; horizontal-stretch: 1; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 8px;
                                Text { text: "ENERGY & BUOYANCY"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                Text { text: "Energy model"; color: UiTheme.text-muted; font-size: 11px; }
                                ComboBox { model: ["Flow only", "Constant-property energy"]; current-index <=> root.energy-model-index; }
                                HorizontalLayout {
                                    VerticalLayout { Text { text: "Initial T (K)"; color: UiTheme.text-muted; font-size: 10px; } LineEdit { text <=> root.initial-temperature; } }
                                    VerticalLayout { Text { text: "Thermal diffusivity"; color: UiTheme.text-muted; font-size: 10px; } LineEdit { text <=> root.thermal-diffusivity; } }
                                }
                                Text { text: "Heat source (K/s)"; color: UiTheme.text-muted; font-size: 10px; } LineEdit { text <=> root.thermal-source; }
                                HorizontalLayout {
                                    ComboBox { model: ["Left", "Right", "Bottom", "Top"]; current-index <=> root.thermal-face-index; }
                                    ComboBox { model: ["Adiabatic", "Fixed temperature"]; current-index <=> root.thermal-boundary-kind-index; }
                                }
                                HorizontalLayout { LineEdit { text <=> root.thermal-boundary-value; } Button { text: "APPLY THERMAL BC"; clicked => { root.apply-thermal-boundary(); } } }
                                Rectangle { height: 1px; background: UiTheme.border; }
                                Text { text: "Buoyancy model"; color: UiTheme.text-muted; font-size: 11px; }
                                ComboBox { model: ["Off", "Boussinesq"]; current-index <=> root.buoyancy-model-index; }
                                HorizontalLayout { LineEdit { text <=> root.reference-temperature; } LineEdit { text <=> root.thermal-expansion; } }
                                HorizontalLayout { LineEdit { text <=> root.gravity-x; } LineEdit { text <=> root.gravity-y; } }
                                Text { text: "Tref (K) · beta (1/K) · gx / gy (m/s²). The solver validates Fourier and CFL limits before it starts."; color: UiTheme.text-faint; font-size: 10px; wrap: word-wrap; }
                            } }
                                Card { min-width: 250px; horizontal-stretch: 2; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 10px;
                                Text { text: "BOUNDARY & VOLUME VIEW"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                InteractiveGeometryPreview { vertical-stretch: 1; preview-image: root.visualization-image; view-axis: root.geometry-view-axis; orbit(x, y, pressed-x, pressed-y) => { root.geometry-drag(x, y, pressed-x, pressed-y); } zoom(delta) => { root.geometry-zoom(delta); } reset-view => { root.reset-geometry-view(); } select-view-axis(axis) => { root.select-geometry-view-axis(axis); } pick-boundary(x, y, w, h) => { root.pick-boundary(x, y, w, h); } }
                                Text { text: "Cyan: left · Gold: right · Green: top · Magenta: bottom"; color: UiTheme.text-soft; font-size: 11px; }
                                HorizontalLayout { Button { text: "SHOW 3D"; clicked => { root.show-geometry-3d(); } } Button { text: "ROTATE"; clicked => { root.rotate-geometry-3d(); } } }
                            } }
                        }
                    }
                    }
                }

                if root.current-step == 3 : Rectangle {
                    width: parent.width; height: parent.height;
                    run-scroll := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        horizontal-scrollbar-policy: as-needed;

                        VerticalLayout {
                            min-height: run-scroll.visible-height;
                            padding: root.page-padding; spacing: root.page-spacing;
                        SectionTitle { text: "04  Run"; }
                        SectionHint { text: "Choose the numerical method, start the worker, and follow convergence without blocking the interface."; }
                        HorizontalLayout {
                                spacing: root.page-spacing;
                                Card { min-width: 260px; preferred-width: 360px; max-width: 420px; horizontal-stretch: 1; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 9px;
                                Text { text: "SOLVER CONTROLS"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                Text { text: "Coupling"; color: UiTheme.text-muted; font-size: 11px; } ComboBox { model: ["SIMPLE-style steady", "Projection transient"]; current-index <=> root.coupling-index; }
                                Text { text: "Pressure solver"; color: UiTheme.text-muted; font-size: 11px; } ComboBox { model: ["PCG + Jacobi", "SOR"]; current-index <=> root.pressure-solver-index; }
                                Text { text: "Pseudo-time step"; color: UiTheme.text-muted; font-size: 11px; } LineEdit { text <=> root.dt-text; }
                                Text { text: "Iterations"; color: UiTheme.text-muted; font-size: 11px; } SpinBox { value <=> root.iterations; minimum: 1; maximum: 10000000; }
                                Text { text: "CPU threads (0 = auto)"; color: UiTheme.text-muted; font-size: 11px; } SpinBox { value <=> root.threads; minimum: 0; maximum: 256; }
                                Text { text: "Update / history / frame interval (iterations)"; color: UiTheme.text-muted; font-size: 11px; }
                                HorizontalLayout {
                                    VerticalLayout { Text { text: "GUI"; color: UiTheme.text-faint; font-size: 10px; } SpinBox { value <=> root.gui-update-every; minimum: 1; maximum: 1000000; } }
                                    VerticalLayout { Text { text: "CSV"; color: UiTheme.text-faint; font-size: 10px; } SpinBox { value <=> root.history-every; minimum: 1; maximum: 1000000; } }
                                    VerticalLayout { Text { text: "FRAME"; color: UiTheme.text-faint; font-size: 10px; } SpinBox { value <=> root.frame-every; minimum: 1; maximum: 1000000; } }
                                }
                                Text { text: "GUI refreshes at the selected cadence. CSV history and PPM frames are saved in results/gui-run."; color: UiTheme.text-faint; font-size: 10px; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Button { text: "VALIDATE"; clicked => { root.validate-case(); } }
                                    Button { text: "START"; clicked => { root.start(); } }
                                    Button { text: "STOP"; clicked => { root.stop(); } }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "RUN CONTROL"; color: UiTheme.text-faint; font-size: 10px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { text: "PAUSE"; clicked => { root.pause(); } }
                                    Button { text: "RESUME"; clicked => { root.resume(); } }
                                }
                                Text { text: root.preflight-summary; color: UiTheme.text-subtle; font-family: "monospace"; font-size: 10px; wrap: word-wrap; }
                            } }
                                Card { min-width: 350px; horizontal-stretch: 2; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 10px;
                                Text { text: "LIVE CONVERGENCE"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                Rectangle { vertical-stretch: 1; background: UiTheme.viewport; border-color: UiTheme.viewport-border; border-width: 1px; Image { source: root.residual-image; width: parent.width; height: parent.height; image-fit: contain; } }
                                Text { text: "STABILITY · COMPLETED STEP"; color: UiTheme.text-dim; font-size: 10px; font-weight: 700; }
                                Text { text: root.solver-stability-summary; color: UiTheme.text; font-family: "monospace"; font-size: 11px; }
                                HorizontalLayout { MetricCard { label: "STATUS"; value: root.status; } MetricCard { label: "ITERATIONS"; value: root.iterations; } MetricCard { label: "WORKERS"; value: root.threads == 0 ? "AUTO" : root.threads; } }
                            } }
                        }
                    }
                    }
                }

                if root.current-step == 4 : Rectangle {
                    width: parent.width; height: parent.height;
                    results-scroll := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        horizontal-scrollbar-policy: as-needed;

                        VerticalLayout {
                            min-height: results-scroll.visible-height;
                            padding: root.page-padding; spacing: root.page-spacing;
                        SectionTitle { text: "05  Results"; }
                        SectionHint { text: "Inspect scalar fields with configurable palettes, isolines, and cell-centred velocity vectors from sampled solver snapshots."; }
                        HorizontalLayout {
                                spacing: root.page-spacing;
                                Card { min-width: 350px; horizontal-stretch: 2; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 10px;
                                Text { text: root.visualization-title; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                Rectangle { vertical-stretch: 1; background: UiTheme.viewport; border-color: UiTheme.viewport-border; border-width: 1px; Image { source: root.visualization-image; width: parent.width; height: parent.height; image-fit: contain; } }
                                Text { text: root.animation-status; color: UiTheme.text-soft; font-size: 11px; }
                                HorizontalLayout { Button { text: "SPEED"; clicked => { root.select-result-field(0); } } Button { text: "PRESSURE"; clicked => { root.select-result-field(1); } } Button { text: "VORTICITY"; clicked => { root.select-result-field(2); } } Button { text: "TEMPERATURE"; clicked => { root.select-result-field(3); } } }
                                Rectangle { height: 1px; background: UiTheme.border; }
                                Text { text: "POST-PROCESSING STYLE"; color: UiTheme.accent; font-size: 10px; font-weight: 700; }
                                HorizontalLayout {
                                    VerticalLayout { Text { text: "Plot"; color: UiTheme.text-muted; font-size: 10px; } ComboBox { model: ["Filled field", "Contours", "Contours + vectors", "Vectors only"]; current-index <=> root.result-plot-index; } }
                                    VerticalLayout { Text { text: "Color map"; color: UiTheme.text-muted; font-size: 10px; } ComboBox { model: ["Turbo", "Viridis", "Plasma", "Blue–red"]; current-index <=> root.result-colormap-index; } }
                                    VerticalLayout { Text { text: "Levels"; color: UiTheme.text-muted; font-size: 10px; } SpinBox { value <=> root.result-contour-levels; minimum: 3; maximum: 32; } }
                                }
                                HorizontalLayout { Button { text: "APPLY STYLE"; clicked => { root.apply-result-style(); } } Text { text: "Vectors use cell-centred velocity; arrows are adaptively sampled for readability."; color: UiTheme.text-faint; font-size: 10px; wrap: word-wrap; vertical-stretch: 1; } }
                                HorizontalLayout { Button { text: "FIELD"; clicked => { root.show-field(); } } Button { text: "MESH"; clicked => { root.show-mesh(); } } Button { text: "PLAY / PAUSE"; clicked => { root.animation-play-pause(); } } Button { text: "NEXT"; clicked => { root.animation-next(); } } }
                            } }
                                Card { min-width: 250px; preferred-width: 330px; max-width: 390px; horizontal-stretch: 1; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 10px;
                                Text { text: "RUN SUMMARY"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                Text { text: root.residual-summary; color: UiTheme.text; font-family: "monospace"; font-size: 12px; }
                                Text { text: root.force-summary; color: UiTheme.text; font-family: "monospace"; font-size: 12px; }
                                Text { text: root.field-summary; color: UiTheme.text-muted; font-size: 11px; wrap: word-wrap; }
                                Text { text: "SOLVER LOG"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                TextEdit { text: root.log-text; read-only: true; vertical-stretch: 1; }
                            } }
                        }
                    }
                    }
                }
            }
        }

        Rectangle {
            min-height: 28px;
            preferred-height: 30px;
            max-height: 32px;
            background: UiTheme.sidebar;
            border-color: UiTheme.border-soft;
            border-width: 1px;

            HorizontalLayout {
                padding-left: root.compact-ui ? 10px : 14px;
                padding-right: root.compact-ui ? 10px : 14px;
                spacing: 10px;

                Text {
                    text: root.status;
                    color: UiTheme.accent;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle { width: 1px; background: UiTheme.border; }

                Text {
                    text: root.current-step == 0 ? "Geometry" :
                          root.current-step == 1 ? "Mesh" :
                          root.current-step == 2 ? "Setup" :
                          root.current-step == 3 ? "Run" : "Results";
                    color: UiTheme.text-soft;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                if !root.compact-ui : Text {
                    text: root.project-loaded ? root.project-path : "No active project";
                    color: UiTheme.text-muted;
                    font-size: 10px;
                    max-width: 260px;
                    overflow: elide;
                    vertical-alignment: center;
                }

                if !root.compact-ui : Rectangle { width: 1px; background: UiTheme.border; }

                Text {
                    text: root.threads == 0 ? "CPU AUTO" : "CPU MANUAL";
                    color: UiTheme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
