    VerticalLayout {
        spacing: 0px;
        TopBar {
            compact-ui: root.compact-ui;
            project-loaded: root.project-loaded;
            wb-busy: root.wb-busy;
            can-run-workbench: root.can-run-workbench;
            project-name: root.project-name;
            status: root.status;
            recent-project-model: root.recent-project-model;
            recent-project-index <=> root.recent-project-index;
            new-project => { root.new-project(); }
            show-examples => { root.show-examples(); }
            open-project => { root.open-project-native(); }
            open-recent-project(index) => { root.open-recent-project(index); }
            save-project => { root.save-project-native(); }
            save-project-as => { root.save-project-as(); }
            save-template => { root.save-as-case-template(); }
            select-step(step) => { root.select-step(step); }
            run-workbench => { root.run-workbench(); }
        }

        HorizontalLayout {
            spacing: 0px;
            ProjectTree {
                compact-ui: root.compact-ui;
                project-tree-model: root.project-tree-model;
                select-tree-row(index, additive) => { root.select-tree-row(index, additive); }
                toggle-tree-row(index) => { root.toggle-tree-row(index); }
                edit-tree-row(index)=>{root.cad-tree-edit(index);}
                context-tree-row(index)=>{root.cad-tree-context(index)}
                expand-history(expand)=>{root.cad-tree-expand(expand);}
                command(action)=>{root.cad-command(action);}
                activate(action)=>{root.cad-activate-tool(action);}
                can-edit-feature:root.cad-selection-editable;has-source-sketch:root.cad-selection-source-sketch;
                has-body:root.cad-selection-body;has-sketch:root.cad-selection-sketch;planar-face:root.cad-selection-planar;has-edge:root.cad-selection-edge;
                selection-label:root.cad-selection-label;locked:root.cad-busy || root.cad-task-open;
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: UiTheme.background;

                    if root.examples-open : ExampleGallery {
                        compact-ui: root.compact-ui;
                        page-padding: root.page-padding;
                        page-spacing: root.page-spacing;
                        example-model: root.example-model;
                        selected-example-index: root.selected-example-index;
                        selected-example-title: root.selected-example-title;
                        selected-example-category: root.selected-example-category;
                        selected-example-summary: root.selected-example-summary;
                        selected-example-details: root.selected-example-details;
                        close => { root.close-examples(); }
                        select-example(index) => { root.select-example(index); }
                        show-details(index) => { root.show-example-details(index); }
                        open-example(index) => { root.open-example(index); }
                    }

                    if !root.examples-open && root.current-step == 0 : Rectangle {
                    width: parent.width; height: parent.height;
                    VerticalLayout {
                        padding: 8px; spacing: 6px;
                        CadRibbon {
                            workbench:root.cad-workbench;operation:root.cad-operation;
                            task-title:root.cad-task-title;
                            active-tool:root.geometry-active-tool;pick-mode:root.geometry-pick-mode;
                            busy:root.cad-busy;previewing:root.cad-preview-active;
                            editing:root.cad-direct-sketch-editing;face-editing:root.geometry-face-sketch-editing;
                            has-body:root.cad-bodies.length>0;has-sketch:root.cad-sketches.length>0;
                            grid:root.geometry-grid;snap:root.geometry-snap;view-3d:root.geometry-cad-view-3d;
                            activate(action)=>{root.cad-activate-tool(action);}
                            command(action)=>{root.cad-command(action);}
                            drawing(tool)=>{
                                root.cad-workbench=0;root.cad-operation=1;root.feature-kind-index=0;
                                root.cad-task-title="Sketch / Pad";root.geometry-sidebar-tab=0;
                                root.cad-sketch-editing=false;
                                if !root.geometry-face-sketch-editing {root.geometry-cad-view-3d=false;}
                                root.geometry-tool(tool);
                            }
                            select-mode(mode)=>{
                                root.select-geometry-pick-mode(mode);
                                if mode==0 {root.geometry-select-face-mode();} else {root.geometry-select-entity-mode();}
                            }
                            utility(action)=>{
                                if action==0 {if root.geometry-cad-view-3d {root.reset-geometry-view();} else {root.geometry-fit();}}
                                if action==1 {root.geometry-cad-view-3d=!root.geometry-cad-view-3d;if root.geometry-cad-view-3d {root.show-geometry-3d();}}
                                if action==2 {root.geometry-toggle-grid();}
                                if action==3 {root.geometry-toggle-snap();}
                                if action==4 {root.geometry-undo();}
                                if action==5 {root.geometry-redo();}
                                if action==6 {root.cad-command(23);}
                                if action==7 {root.clear-geometry-selection();}
                                if action==8 {root.geometry-delete-selection();}
                                if action==9 {root.prepare-flow-domain(false);}
                                if action==10 {root.prepare-flow-domain(true);}
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Card {
                                min-width: 218px;
                                preferred-width: root.compact-ui ? 238px : 280px;
                                max-width: 330px;
                                horizontal-stretch: 1;

                                VerticalLayout {
                                    padding: root.compact-ui ? 10px : 14px;
                                    spacing: 8px;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        Button { text: "TASKS"; clicked => { root.geometry-sidebar-tab = 0; } }
                                        Button { text: "PROJECT"; clicked => { root.geometry-sidebar-tab = 1; } }
                                        Button { text: root.compact-ui ? "INSPECT" : "INSPECTOR"; clicked => { root.geometry-sidebar-tab = 2; } }
                                    }

                                     if root.geometry-sidebar-tab == 0 : CadTaskPanel {
                                         vertical-stretch: 1;
                                         workbench <=> root.cad-workbench;
                                         operation:root.cad-operation;
                                         task-title:root.cad-task-title;
                                         task-open:root.cad-task-open;preview-label:root.cad-preview-label;
                                         auto-preview <=> root.cad-auto-preview;
                                         auto-status:root.cad-auto-preview-status;
                                         profiles:root.cad-profiles;profile-index <=> root.cad-profile-index;
                                         profile-valid:root.cad-profile-valid;pick-role:root.cad-pick-role;
                                         region-owner:root.cad-region-owner;region-grouped:root.cad-region-grouped;
                                         drive-x <=> root.cad-drive-x;drive-y <=> root.cad-drive-y;
                                         drive-width <=> root.cad-drive-width;drive-height <=> root.cad-drive-height;
                                         equal-sides <=> root.cad-equal-sides;centered <=> root.cad-centered;
                                         constraint-status:root.cad-constraint-status;
                                         length-unit <=> root.cad-length-unit;angle-unit <=> root.cad-angle-unit;
                                         reverse <=> root.cad-reverse;transform-copy <=> root.cad-transform-copy;
                                         axis-x <=> root.cad-axis-x;axis-y <=> root.cad-axis-y;axis-z <=> root.cad-axis-z;
                                         units-changed()=>{root.cad-units-changed(root.cad-last-length-unit,root.cad-last-angle-unit);root.cad-last-length-unit=root.cad-length-unit;root.cad-last-angle-unit=root.cad-angle-unit;}
                                         face-editing:root.geometry-face-sketch-editing;
                                         through-all <=> root.cad-through-all;
                                         pocket-end-mode <=> root.cad-pocket-end-mode;
                                         pocket-stop-face <=> root.cad-pocket-stop-face;
                                         previewing:root.cad-preview-active;
                                         sketch-plane <=> root.cad-sketch-plane;
                                         sketch-kind <=> root.cad-sketch-kind;
                                         sketch-index <=> root.cad-sketch-index;
                                         sketch-editing <=> root.cad-sketch-editing;
                                         sketches: root.cad-sketches; history: root.cad-history;
                                         edit-sketch-id <=> root.cad-edit-sketch-id;
                                         editing-pad <=> root.cad-editing-pad;
                                         feature-index <=> root.cad-feature-index;
                                         features:root.cad-features;
                                         history-profiles:root.cad-history-profiles;
                                         history-profile-index <=> root.cad-history-profile-index;
                                         history-parents:root.cad-history-parents;
                                         history-parent-index <=> root.cad-history-parent-index;
                                         editing-recipe:root.cad-edit-body-id!="";
                                         sketch-host:root.cad-sketch-host;
                                         profile-face:root.cad-profile-face;
                                         axis-mode <=> root.cad-axis-mode;
                                         axis-edge:root.cad-axis-edge;
                                         axis-edge-index <=> root.cad-axis-edge-index;
                                         axis-edges:root.cad-axis-edges;
                                         loft-sections:root.cad-loft-sections;
                                         loft-index <=> root.cad-loft-index;
                                         primitive-kind <=> root.cad-primitive-kind;
                                         axis <=> root.cad-axis; can-loft: root.cad-can-loft;
                                         feature-mode <=> root.feature-kind-index;can-pocket:root.cad-can-pocket;
                                         source <=> root.cad-source; target <=> root.cad-target;
                                         count <=> root.cad-count; name <=> root.cad-name;
                                         selection-items:root.cad-selection-items;unselect(index)=>{root.cad-unselect(index);}
                                         finish-corner0 <=> root.cad-finish-corner0;finish-corner1 <=> root.cad-finish-corner1;
                                         finish-corner2 <=> root.cad-finish-corner2;finish-corner3 <=> root.cad-finish-corner3;finish-opening <=> root.cad-finish-opening;
                                         size-x <=> root.cad-size-x; size-y <=> root.cad-size-y; size-z <=> root.cad-size-z;
                                         pos-x <=> root.cad-pos-x; pos-y <=> root.cad-pos-y; pos-z <=> root.cad-pos-z;
                                         revolve-x <=> root.cad-revolve-x;revolve-y <=> root.cad-revolve-y;revolve-z <=> root.cad-revolve-z;
                                         angle <=> root.cad-angle; factor <=> root.cad-factor; tolerance <=> root.cad-tolerance;
                                         bodies: root.cad-bodies; inspector: root.cad-inspector;
                                         feedback: root.cad-feedback; busy: root.cad-busy; has-profile: root.geometry-can-extrude;
                                         command(action) => {root.cad-command(action);}
                                         activate(action)=>{root.cad-activate-tool(action);}
                                         edit-status:root.cad-sketch-edit-status;
                                         editing-pocket:root.cad-editing-pocket;
                                         sketch-offset <=> root.cad-sketch-offset;
                                         direct-editing:root.cad-direct-sketch-editing;
                                         parameters-edited()=>{root.cad-parameters-changed();root.cad-sketch-parameters-edited();}
                                         select-body(index) => {root.cad-select-body(index);}
                                     }

                                    if root.geometry-sidebar-tab != 0 : ScrollView {
                                        vertical-stretch: 1;
                                        horizontal-scrollbar-policy: always-off;

                                        VerticalLayout {
                                            spacing: 8px;


                                     if root.geometry-sidebar-tab == 1 : VerticalLayout {
                                         Button { text: root.geometry-domain-open ? "▾  CASE / DOMAIN" : "▸  CASE / DOMAIN"; clicked => { root.geometry-domain-open = !root.geometry-domain-open; } }
                                         if root.geometry-domain-open : VerticalLayout {
                                             ComboBox { model: ["Lid-driven cavity", "Cylinder flow Re=100", "Backward-facing step", "Channel flow (Poiseuille)"]; current-index <=> root.case-index; }
                                             Button { text: "SET ACTIVE DOMAIN"; clicked => { root.select-case(); } }
                                         }
                                         Button { text: root.geometry-project-open ? "▾  PROJECT / PATH" : "▸  PROJECT / PATH"; clicked => { root.geometry-project-open = !root.geometry-project-open; } }
                                         if root.geometry-project-open : VerticalLayout {
                                             Text { text: "Project"; color: UiTheme.text-muted; font-size: 10px; }
                                             LineEdit { text <=> root.project-name; }
                                             Text { text: "ADVANCED PATH (manual load/save)"; color: UiTheme.text-muted; font-size: 10px; }
                                             LineEdit { text <=> root.project-path; placeholder-text: "Workspace folder or legacy import file"; }
                                             HorizontalLayout { Button { text: "LOAD PATH"; clicked => { root.load-project(); } } Button { text: "SAVE PATH"; clicked => { root.save-project(); } } }
                                         }
                                        Rectangle { vertical-stretch: 1; }
                                    }
                                     if root.geometry-sidebar-tab == 2 : VerticalLayout {
                                         Text { text: "INSPECTOR"; color: UiTheme.accent; font-size: 11px; font-weight: 800; }
                                         Text { text: root.geometry-selection-detail; color: UiTheme.text-bright; font-size: 11px; wrap: word-wrap; }
                                         Rectangle { height: 1px; background: UiTheme.border; }
                                         Button { text: root.geometry-sketch-open ? "▾  SKETCH" : "▸  SKETCH"; clicked => { root.geometry-sketch-open = !root.geometry-sketch-open; } }
                                         if root.geometry-sketch-open : VerticalLayout {
                                         spacing: 5px;
                                        ComboBox { model: ["Rectangle", "Circle"]; current-index <=> root.sketch-kind-index; }
                                        Text { text: "SKETCH PLANE"; color: UiTheme.text-muted; font-size: 10px; font-weight: 700; }
                                        ComboBox { model: ["XY", "YZ", "ZX"]; current-index <=> root.sketch-plane-index; }
                                        LineEdit { text <=> root.sketch-name; placeholder-text: "Sketch name"; }
                                        Text { text: "PROFILE SIZE (mm)"; color: UiTheme.text-muted; font-size: 10px; font-weight: 700; }
                                        HorizontalLayout {
                                            LineEdit { text <=> root.sketch-size-x; placeholder-text: root.sketch-kind-index == 0 ? "Width" : "Radius"; }
                                            LineEdit { text <=> root.sketch-size-y; placeholder-text: root.sketch-kind-index == 0 ? "Height" : "Reference"; }
                                        }
                                        Button { text: "RECTANGLE ON PLANE"; enabled: !root.geometry-face-sketch-editing; clicked => { root.sketch-on-plane(); root.geometry-cad-view-3d = true; } }
                                        Button { text: "DRAW RECTANGLE ON FACE"; enabled: !root.geometry-face-sketch-editing; clicked => { root.draw-on-face(); } }
                                        Button { text: "RECTANGLE ON SELECTED FACE"; enabled: !root.geometry-face-sketch-editing; clicked => { root.sketch-on-face(); root.geometry-cad-view-3d = true; } }
                                        Text { text: "Select a flat face in 3D or in the tree, set width and height, create its sketch, then extrude the selected profile. Dimensions use the face's local axes."; color: UiTheme.text-faint; font-size: 10px; wrap: word-wrap; }
                                        Text { text: "ORIGIN (mm)"; color: UiTheme.text-muted; font-size: 10px; font-weight: 700; }
                                        HorizontalLayout {
                                            LineEdit { text <=> root.sketch-pos-x; placeholder-text: "X"; }
                                            LineEdit { text <=> root.sketch-pos-y; placeholder-text: "Y"; }
                                            LineEdit { text <=> root.sketch-pos-z; placeholder-text: "Z"; }
                                        }
                                        Rectangle { height: 1px; background: UiTheme.border; }
                                        Text { text: "DRIVING DIMENSION (select a line/circle, mm)"; color: UiTheme.accent; font-size: 10px; font-weight: 700; wrap: word-wrap; }
                                        HorizontalLayout { LineEdit { text <=> root.driving-dimension; placeholder-text: "Length / radius"; } Button { text: "APPLY"; clicked => { root.apply-driving-dimension(); } } }
                                         Text { text: "Selection fills the current value. Applying updates the same persistent driving dimension."; color: UiTheme.text-faint; font-size: 10px; wrap: word-wrap; }
                                         }
                                         Rectangle { height: 1px; background: UiTheme.border; }
                                         Button { text: root.geometry-feature-open ? "▾  EXTRUDE" : "▸  EXTRUDE"; clicked => { root.geometry-feature-open = !root.geometry-feature-open; } }
                                         if root.geometry-feature-open : VerticalLayout {
                                             Text { text: "Extrude selected planar face"; color: UiTheme.text-secondary; font-size: 11px; }
                                             LineEdit { text <=> root.feature-depth; placeholder-text: "Extrude distance (mm)"; }
                                             Text { text: "Select a closed profile, then apply Pad in the Sketch task panel."; color: UiTheme.text-faint; font-size: 10px; wrap: word-wrap; }
                                         }
                                        Rectangle { vertical-stretch: 1; }
                                    }
                                        }
                                    }
                                }
                            }
                            Card {
                                min-width: 360px;
                                horizontal-stretch: 3;
                                VerticalLayout {
                                    padding: 12px; spacing: 8px;
                                     if root.cad-measure-active : Rectangle {
                                         min-height:86px;preferred-height:86px;background:UiTheme.toolbar;border-color:UiTheme.accent;border-width:1px;border-radius:5px;
                                         VerticalLayout {padding:8px;spacing:5px;
                                             HorizontalLayout {
                                                 Text {text:"MEASURE";color:UiTheme.accent;font-size:11px;font-weight:800;vertical-alignment:center;}
                                                 ComboBox {model:["Geometry", "Point distance", "Planar faces"];current-index <=> root.cad-measure-kind;min-width:0px;max-height:28px;selected(value)=>{root.cad-command(33);}}
                                                 Button {text:"Clear";min-width:0px;max-height:28px;clicked=>{root.cad-command(33);}}
                                                 Button {text:"Close";min-width:0px;max-height:28px;clicked=>{root.cad-command(32);}}
                                             }
                                             Text {text:root.cad-measure-result;color:UiTheme.text;font-size:12px;wrap:word-wrap;}
                                         }
                                     }
                                     HorizontalLayout { Text { text: root.cad-direct-sketch-editing && !root.geometry-cad-view-3d ? "EDIT SKETCH · " + root.cad-sketch-plane-label : root.geometry-cad-view-3d ? "3D CAD · SELECT A FACE" : root.geometry-face-sketch-editing ? "SKETCH ON SELECTED FACE" : "2D GEOMETRY EDITOR"; color: UiTheme.accent; font-size: 11px; font-weight: 800; } Rectangle { horizontal-stretch: 1; } Text { text: root.cad-direct-sketch-editing && !root.geometry-cad-view-3d ? "DRAG HANDLES · LOCAL PLANE" : root.geometry-cad-view-3d ? "ORBIT · PICK · EXTRUDE" : root.geometry-face-sketch-editing ? "LOCAL FACE PLANE · mm" : "XY PLANE · mm"; color: UiTheme.text-dim; font-size: 10px; } }
                                     if root.geometry-cad-view-3d : Rectangle {
                                         vertical-stretch:1;
                                         property <length> menu-x:0px;
                                         property <length> menu-y:0px;
                                         context-menu := CadContextMenu {
                                             x:parent.menu-x;y:parent.menu-y;
                                             can-edit-feature:root.cad-selection-editable;has-source-sketch:root.cad-selection-source-sketch;
                                             has-body:root.cad-selection-body;planar-face:root.cad-selection-planar;has-sketch:root.cad-selection-sketch;
                                             has-edge:root.cad-selection-edge;selection-label:root.cad-selection-label;
                                             axis-task:root.cad-task-open && (root.cad-operation==2 || root.cad-operation==57);
                                             locked:root.cad-busy || root.cad-task-open || root.cad-preview-active || root.geometry-face-sketch-editing;
                                             command(action)=>{root.cad-command(action);}
                                             activate(action)=>{root.cad-activate-tool(action);}
                                             fit=>{root.reset-geometry-view();}
                                         }
                                         InteractiveGeometryPreview {
                                         width:parent.width;height:parent.height;
                                         context-menu(x,y,w,h)=>{
                                             if root.cad-context-pick(x,y,w,h) {
                                                 parent.menu-x=max(0px,min(x*1px,parent.width - 270px));
                                                 parent.menu-y=max(0px,min(y*1px,parent.height - context-menu.menu-height));
                                                 context-menu.show();
                                             }
                                         }
                                         preview-image: root.visualization-image;
                                         orientation-image:root.cad-orientation-image;
                                         pick-orientation(x,y)=>{root.cad-pick-orientation(x,y);}
                                         view-axis: root.geometry-view-axis;
                                         select-geometry: true;
                                         help-text: root.geometry-pick-mode == 0 ? "CLICK FACE: SELECT  ·  DRAG: ORBIT  ·  WHEEL: ZOOM  ·  DOUBLE-CLICK: FIT" : root.geometry-pick-mode == 1 ? "CLICK AN EDGE: SELECT  ·  DRAG: ORBIT  ·  WHEEL: ZOOM" : "CLICK A VERTEX: SELECT  ·  DRAG: ORBIT  ·  WHEEL: ZOOM";
                                         shortcut(action)=>{
                                             if action==0 {if root.cad-task-open || root.cad-preview-active {root.cad-command(61);}else{root.geometry-shortcut(0);}}
                                             else if action==1 && root.cad-task-open {root.cad-command(60);}
                                             else if action==2 {root.cad-command(75);}
                                             else if action==3 {root.cad-command(76);}
                                             else if action==4 {root.reset-geometry-view();}
                                             else if action==5 && root.cad-selection-body && !root.cad-task-open && !root.cad-busy {root.cad-command(12);}
                                         }
                                         orbit(x, y, pressed-x, pressed-y) => { root.geometry-drag(x, y, pressed-x, pressed-y); }
                                         orbit-end => { root.geometry-drag-end(); }
                                         zoom(delta) => { root.geometry-zoom(delta); }
                                         reset-view => { root.reset-geometry-view(); }
                                         select-view-axis(axis) => { root.select-geometry-view-axis(axis); }
                                         pick-boundary(x, y, w, h) => { root.pick-boundary(x, y, w, h); }
                                         hover(x, y, w, h) => { root.mesh-hover(x, y, w, h); }
                                     }
                                     }
                                     if !root.geometry-cad-view-3d : Rectangle {
                                        vertical-stretch: 1;
                                        background: UiTheme.viewport;
                                        border-color: UiTheme.viewport-border;
                                        border-width: 1px;
                                        line-menu := SketchLineContextMenu {
                                            edit(tool)=>{
                                                root.geometry-tool(tool);
                                                root.geometry-pointer(line-menu.pick-x,line-menu.pick-y,parent.width/1px,parent.height/1px,false);
                                                root.geometry-tool(0);
                                            }
                                            utility(action)=>{root.geometry-shortcut(action);}
                                        }
                                        Image { source: root.geometry-editor-image; width: parent.width; height: parent.height; image-fit: contain; }
                                        editor-focus := FocusScope {
                                            width: parent.width; height: parent.height;
                                            key-pressed(event) => {
                                                 if event.modifiers.control && (event.text == "z" || event.text == "Z") && event.modifiers.shift { root.geometry-shortcut(7); accept }
                                                 else if event.modifiers.control && (event.text == "z" || event.text == "Z") { root.geometry-shortcut(6); accept }
                                                 else if event.modifiers.control && (event.text == "y" || event.text == "Y") { root.geometry-shortcut(7); accept }
                                                 else if root.cad-direct-sketch-editing && event.text == Key.Return {root.cad-command(129);accept}
                                                 else if !root.cad-direct-sketch-editing && root.geometry-can-extrude && !event.modifiers.control && (event.text == "e" || event.text == "E" || event.text == Key.Return) { root.build-feature(); accept }
                                                else if event.text == Key.Escape { root.geometry-shortcut(0); accept }
                                                else if event.text == "v" || event.text == "V" {if !root.cad-direct-sketch-editing {root.geometry-shortcut(0);} accept}
                                                else if !event.modifiers.control && (event.text == "l" || event.text == "L") { root.geometry-shortcut(1); accept }
                                                else if !event.modifiers.control && (event.text == "r" || event.text == "R") { root.geometry-shortcut(2); accept }
                                                else if !event.modifiers.control && (event.text == "c" || event.text == "C") { root.geometry-shortcut(3); accept }
                                                else if !event.modifiers.control && (event.text == "t" || event.text == "T") { root.geometry-shortcut(9); accept }
                                                else if !event.modifiers.control && (event.text == "x" || event.text == "X") { root.geometry-shortcut(10); accept }
                                                else if !event.modifiers.control && (event.text == "s" || event.text == "S") { root.geometry-shortcut(11); accept }
                                                else if event.text == Key.Delete { root.geometry-shortcut(4); accept }
                                                else if !event.modifiers.control && (event.text == "f" || event.text == "F") { root.geometry-shortcut(5); accept }
                                                else { reject }
                                            }
                                        }
                                        TouchArea {
                                            x: 0px; y: 0px;
                                            width: parent.width; height: parent.height;
                                            property <length> press-x: 0px;
                                            property <length> press-y: 0px;
                                            property <bool> started-on-down: false;
                                            mouse-cursor: root.geometry-editor-panning ? grabbing : root.geometry-active-tool == 0 ? default : crosshair;
                                            moved => {
                                                if root.geometry-editor-panning {
                                                    root.geometry-pan-move(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                                                } else if root.cad-direct-sketch-editing && self.pressed {
                                                    root.cad-sketch-drag(1,self.mouse-x/1px,self.mouse-y/1px,self.width/1px,self.height/1px);
                                                } else {
                                                    root.geometry-move(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                                                }
                                            }
                                            pointer-event(event) => {
                                                if root.cad-direct-sketch-editing && event.button == PointerEventButton.left {
                                                    editor-focus.focus();
                                                    if event.kind == PointerEventKind.down {root.cad-sketch-drag(0,self.mouse-x/1px,self.mouse-y/1px,self.width/1px,self.height/1px);}
                                                    if event.kind == PointerEventKind.up {root.cad-sketch-drag(2,self.mouse-x/1px,self.mouse-y/1px,self.width/1px,self.height/1px);}
                                                } else {

                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                    editor-focus.focus();
                                                    if root.geometry-line-context(self.mouse-x/1px,self.mouse-y/1px,self.width/1px,self.height/1px) {
                                                        line-menu.pick-x=self.mouse-x/1px;
                                                        line-menu.pick-y=self.mouse-y/1px;
                                                        line-menu.x=max(0px,min(self.mouse-x,parent.width - 150px));
                                                        line-menu.y=max(0px,min(self.mouse-y,parent.height - 120px));
                                                        line-menu.show();
                                                    }
                                                }
                                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                    editor-focus.focus();
                                                    self.press-x = self.mouse-x;
                                                    self.press-y = self.mouse-y;
                                                    self.started-on-down = root.geometry-pointer-down(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                                                }
                                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                                                    let dragged = Math.abs((self.mouse-x - self.press-x) / 1px) >= 5 || Math.abs((self.mouse-y - self.press-y) / 1px) >= 5;
                                                    if !root.geometry-editor-panning && (!self.started-on-down || dragged) && (!dragged || root.geometry-active-tool != 0) {
                                                        root.geometry-pointer(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px, event.modifiers.control);
                                                    }
                                                    self.started-on-down = false;
                                                }
                                                if event.button == PointerEventButton.middle && event.kind == PointerEventKind.down {
                                                    root.geometry-editor-panning = true;
                                                    root.geometry-pan-begin(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                                                }
                                                if event.button == PointerEventButton.middle && event.kind == PointerEventKind.up {
                                                    root.geometry-editor-panning = false;
                                                }
                                                }
                                            }
                                            scroll-event(event) => { root.geometry-wheel(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px, event.delta-y / 1px); accept }
                                        }
                                        if root.cad-direct-sketch-editing : SketchDimensionsOverlay {width:parent.width;height:parent.height;labels:root.cad-sketch-dimensions;}
                                    }
                                    if root.geometry-feature-feedback != "" : Text {text:root.geometry-feature-feedback;color:UiTheme.accent;font-size:11px;wrap:word-wrap;}
                                    if root.geometry-active-tool != 0 || root.geometry-face-sketch-editing : Text {text:root.geometry-editor-status;color:UiTheme.text-muted;font-size:10px;wrap:word-wrap;}

                                }
                            }

                        }
                    }
                }

                if !root.examples-open && root.current-step == 1 : Rectangle {
                    width: parent.width; height: parent.height;
                    mesh-scroll := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        horizontal-scrollbar-policy: as-needed;

                        VerticalLayout {
                            min-height: mesh-scroll.visible-height;
                            padding: root.page-padding; spacing: root.page-spacing;
                        SectionTitle { text: "02  Mesh"; }
                        SectionHint { text: "Generate and inspect the active unstructured mesh before assigning boundaries or solving."; }
                        Text {text:root.wb-operation-feedback;color:UiTheme.text-soft;wrap:word-wrap;font-size:11px;}
                        HorizontalLayout {
                                height:max(540px,mesh-scroll.visible-height - 125px);
                                spacing: root.page-spacing;
                                WorkflowControlCard { min-width: 250px; preferred-width: 340px; max-width: 400px; horizontal-stretch: 1;
                                Text {text:"FLUID MESH";color:UiTheme.accent;font-size:11px;font-weight:700;}

                                    InspectorLabel {text:"FLUID DOMAIN";}
                                    InspectorValue {text:root.wb-domain-status;}

                                    Button {text:"USE SELECTED 2D FACE";enabled:!root.wb-busy;clicked=>{root.prepare-flow-domain(false);}}
                                    Button {text:"PREPARE 2D MOVING-LID CAVITY";enabled:!root.wb-busy;clicked=>{root.prepare-cavity();}}
                                    Button {text:root.mesh-domain-expanded ? "▾ CHANNEL / CYLINDER DOMAIN" : "▸ CHANNEL / CYLINDER DOMAIN";clicked=>{root.mesh-domain-expanded=!root.mesh-domain-expanded;}}
                                    if root.mesh-domain-expanded : VerticalLayout {
                                    InspectorLabel {text:"CIRCULAR SUBTRACTION · MODEL COORDINATES";}
                                    HorizontalLayout {
                                        LineEdit {text <=> root.wb-obstacle-x;placeholder-text:"Center X";}
                                        LineEdit {text <=> root.wb-obstacle-y;placeholder-text:"Center Y";}
                                        LineEdit {text <=> root.wb-obstacle-radius;placeholder-text:"Radius";}
                                    }
                                    Button {text:"SUBTRACT CIRCLE FROM FLUID FACE";enabled:!root.wb-busy;clicked=>{root.cut-flow-obstacle();}}
                                    Button {text:"PREPARE CHANNEL BOUNDARIES";enabled:!root.wb-busy;clicked=>{root.prepare-flow-domain(true);}}

                                    HorizontalLayout {
                                        LineEdit {text <=> root.wb-channel-depth;placeholder-text:"Spanwise depth";}
                                        Button {text:"EXTRUDE 3D FLUID";enabled:!root.wb-busy;clicked=>{root.extrude-flow-channel();}}
                                    }
                                    InspectorLabel {text:"3D: draw the channel and circular hole, then extrude the fluid. The hole becomes a cylinder wall; both spanwise caps are no-slip. Depth uses the same length unit as the sketch. All conditions remain editable in Setup.";wrap:word-wrap;}
                                    InspectorLabel {text:"Draw a rectangle, then a circle inside it in XY: the circle cuts a fluid hole. Select the remaining face. Channel preparation creates editable inlet (+X, U=1), outlet (p=0), walls and obstacle groups. Geometry and mesh sizes use model coordinates; use consistent length/velocity/viscosity units.";wrap:word-wrap;}
                                    }
                                    InspectorLabel { text: "DIMENSION"; }
                                    ComboBox {
                                        enabled: !root.wb-busy;
                                        model: ["2D planar face", "3D fluid body"];
                                        current-index <=> root.mesh-dimension-index;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        VerticalLayout { InspectorLabel { text: "GLOBAL SIZE"; } LineEdit { text <=> root.wb-global-size; } }
                                        VerticalLayout { InspectorLabel { text: "MIN SIZE"; } LineEdit { text <=> root.wb-min-size; } }
                                        VerticalLayout { InspectorLabel { text: "MAX SIZE"; } LineEdit { text <=> root.wb-max-size; } }
                                    }
                                    HorizontalLayout {
                                        Button {text:"COARSE";enabled:!root.wb-busy;clicked=>{root.mesh-size-preset(0);}}
                                        Button {text:"MEDIUM";enabled:!root.wb-busy;clicked=>{root.mesh-size-preset(1);}}
                                        Button {text:"FINE";enabled:!root.wb-busy;clicked=>{root.mesh-size-preset(2);}}
                                    }
                                    InspectorLabel {text:"Presets scale target size to the domain. Sizes are lengths, not cell counts.";wrap:word-wrap;}
                                    InspectorLabel {text:"MESH READINESS";}
                                    InspectorValue {text:root.wb-mesh-readiness;}
                                    Button {text:"CHECK MESH INPUTS";enabled:!root.wb-busy;clicked=>{root.check-mesh-inputs();}}
                                    InspectorLabel { text: "ELEMENT ORDER"; }
                                    InspectorValue { text: "1st order (linear) — only order supported by the importer"; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button { text: root.wb-busy ? "GENERATING…" : "GENERATE MESH"; enabled: !root.wb-busy; clicked => { root.generate-mesh-wb(); } }
                                        Button { text: "CANCEL JOB"; enabled: root.wb-busy; clicked => { root.cancel-workbench-job(); } }
                                    }
                                    Button {text:root.mesh-advanced-expanded ? "▾ LOCAL REFINEMENT & LAYERS" : "▸ LOCAL REFINEMENT & LAYERS";clicked=>{root.mesh-advanced-expanded=!root.mesh-advanced-expanded;}}
                                    if root.mesh-advanced-expanded : VerticalLayout {
                                    InspectorLabel { text: "ADVANCED MESH RECIPE"; }
                                    InspectorValue { text: root.wb-mesh-recipe-summary; font-family: "monospace"; }
                                    InspectorLabel { text: "LOCAL SIZE · BOUNDARY GROUP"; }
                                    ComboBox {model:root.patch-model;selected(value)=>{root.wb-local-target=value;}}
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LineEdit { text <=> root.wb-local-target; placeholder-text: "selection name"; }
                                        LineEdit { text <=> root.wb-local-size; placeholder-text: "size"; }
                                        Button { text: "ADD"; enabled: !root.wb-busy; clicked => { root.add-local-size-wb(); } }
                                    }
                                    InspectorLabel { text: "DISTANCE / THRESHOLD · SAME TARGET"; }
                                    HorizontalLayout {
                                        VerticalLayout {InspectorLabel {text:"NEAR SIZE";} LineEdit {text <=> root.wb-refine-min;}}
                                        VerticalLayout {InspectorLabel {text:"FAR SIZE";} LineEdit {text <=> root.wb-refine-max;}}
                                    }
                                    HorizontalLayout {VerticalLayout {InspectorLabel {text:"REFINEMENT DISTANCE";} LineEdit {text <=> root.wb-refine-distance;}} Button {text:"ADD DISTANCE FIELD";enabled:!root.wb-busy;clicked=>{root.add-threshold-refinement-wb();}}}
                                    InspectorLabel { text: "2D BOUNDARY LAYER · SAME TARGET"; }
                                    if root.mesh-dimension-index==0 : VerticalLayout {
                                        HorizontalLayout {
                                            VerticalLayout {InspectorLabel {text:"FIRST HEIGHT";} LineEdit {text <=> root.wb-layer-first;}}
                                            VerticalLayout {InspectorLabel {text:"GROWTH > 1";} LineEdit {text <=> root.wb-layer-growth;}}
                                        }
                                        HorizontalLayout {SpinBox {value <=> root.wb-layer-count;minimum:1;maximum:64;} Button {text:"ADD LAYERS";enabled:!root.wb-busy;clicked=>{root.add-boundary-layer-wb();}}}
                                    }
                                    if root.mesh-dimension-index!=0 : InspectorLabel {text:"Boundary-layer generation is currently supported in 2D only.";wrap:word-wrap;}
                                    ComboBox {model:root.mesh-control-model;enabled:root.mesh-control-model.length>0;selected(value)=>{root.select-mesh-control(self.current-index);}}
                                    HorizontalLayout { LineEdit { text <=> root.wb-recipe-control-id; placeholder-text: "Control ID"; } Button { text: "REMOVE CONTROL"; enabled: !root.wb-busy; clicked => { root.remove-mesh-control-wb(); } } }
                                    }
                                    Rectangle { height: 1px; background: UiTheme.border; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        InspectorValue { text: root.wb-gmsh-status; vertical-stretch: 1; }
                                        Button { text: "↻"; clicked => { root.refresh-gmsh-status(); } }
                                    }
                                    Rectangle { height: 1px; background: UiTheme.border; }
                                    InspectorLabel { text: "MESH STATISTICS"; }
                                    InspectorValue { text: root.wb-mesh-summary; font-family: "monospace"; }
                            }
                                Card { min-width: 350px; horizontal-stretch: 2; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 10px;
                                Text { text: "MESH INSPECTION"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                HorizontalLayout { Text { text: "View"; color: UiTheme.text-muted; vertical-alignment: center; } Button { text: root.mesh-display-index == 0 ? "WIREFRAME ✓" : "WIREFRAME"; clicked => { root.mesh-display(0); } } Button { text: root.mesh-display-index == 1 ? "SURFACE ✓" : "SURFACE"; clicked => { root.mesh-display(1); } } Button { text: root.mesh-display-index == 2 ? "SURFACE + EDGES ✓" : "SURFACE + EDGES"; clicked => { root.mesh-display(2); } } }
                                HorizontalLayout { Text { text: "Select"; color: UiTheme.text-muted; vertical-alignment: center; } Button { text: root.mesh-selection-index == 0 ? "FACE ✓" : "FACE"; clicked => { root.mesh-select-mode(0); } } Button { text: root.mesh-selection-index == 1 ? "CELL ✓" : "CELL"; clicked => { root.mesh-select-mode(1); } } }
                                HorizontalLayout { Text { text: "Color"; color: UiTheme.text-muted; vertical-alignment: center; } Button { text: "NEUTRAL"; clicked => { root.mesh-color(0); } } Button { text: "PATCHES"; clicked => { root.mesh-color(1); } } Button { text: "QUALITY"; clicked => { root.mesh-color(2); } } }
                                HorizontalLayout { Text { text: "Metric"; color: UiTheme.text-muted; vertical-alignment: center; } Button { text: "ASPECT"; clicked => { root.mesh-quality(0); } } Button { text: "SKEW"; clicked => { root.mesh-quality(1); } } Button { text: "NON-ORTH"; clicked => { root.mesh-quality(2); } } Button { text: "MEASURE"; clicked => { root.mesh-quality(3); } } }
                                HorizontalLayout { Text { text: "Threshold"; color: UiTheme.text-muted; vertical-alignment: center; } LineEdit { text <=> root.mesh-quality-threshold; } Button { text: "APPLY"; clicked => { root.mesh-threshold(); } } }
                                if root.bad-cell-model.length > 0 : VerticalLayout { spacing: 3px; Text { text: "CELLS ABOVE THRESHOLD (first " + root.bad-cell-model.length + ")"; color: UiTheme.text-muted; font-size: 10px; font-weight: 700; } ListView { min-height: 48px; max-height: 96px; for cell[index] in root.bad-cell-model : Button { text: cell; clicked => { root.select-bad-cell(index); } } } }
                                Text { text: root.mesh-inspection; color: UiTheme.text-subtle; font-family: "monospace"; font-size: 11px; wrap: word-wrap; }
                                InteractiveGeometryPreview { vertical-stretch: 1; preview-image: root.visualization-image; help-text:root.mesh-dimension-index==0 ? "CLICK: SELECT · DRAG: PAN · WHEEL: ZOOM · DOUBLE CLICK: FIT" : "CLICK: SELECT · 3D FIXED ISOMETRIC VIEW"; view-axis: root.geometry-view-axis; orbit(x, y, pressed-x, pressed-y) => { root.mesh-view-drag(x,y,pressed-x,pressed-y,self.width/1px,self.height/1px); } orbit-end => { root.mesh-view-end(); } zoom(delta) => { root.mesh-view-zoom(delta); } reset-view => { root.mesh-view-fit(); } pick-boundary(x, y, w, h) => { root.pick-boundary(x, y, w, h); } hover(x, y, w, h) => { root.mesh-hover(x, y, w, h); } }
                                Text { text: root.visualization-title + " · " + root.animation-status; color: UiTheme.text-soft; font-size: 11px; }
                                HorizontalLayout { Button { text: "SHOW GENERATED MESH"; clicked => { root.show-mesh(); } } Button {text:"CONTINUE TO SETUP →";clicked=>{root.select-step(2);}} }
                            } }
                        }
                    }
                    }
                }

                if !root.examples-open && root.current-step == 2 : Rectangle {
                    width: parent.width; height: parent.height;
                    setup-scroll := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        horizontal-scrollbar-policy: as-needed;

                        VerticalLayout {
                            min-height: setup-scroll.visible-height;
                            padding: root.page-padding; spacing: root.page-spacing;
                        SectionTitle { text: "03  Setup"; }
                        SectionHint { text: "Select each named patch, inspect its highlighted boundary, and assign its physical condition."; }
                        Text {text:root.wb-operation-feedback;color:UiTheme.text-soft;wrap:word-wrap;font-size:11px;}
                        HorizontalLayout {
                                height:max(540px,setup-scroll.visible-height - 125px);
                                spacing: root.page-spacing;
                                WorkflowControlCard { min-width: 190px; preferred-width: 330px; max-width: 420px; horizontal-stretch: 1;
                                Text {text:"BOUNDARY CONDITIONS";color:UiTheme.accent;font-size:11px;font-weight:700;}
                                InspectorValue {text:root.wb-boundary-summary;}
                                ListView {min-height:70px;max-height:150px;
                                    for patch[index] in root.patch-status-model : Button {
                                        text:(index==root.patch-index ? "● " : "○ ")+patch;
                                        enabled:!root.wb-busy;clicked=>{root.patch-index=index;root.select-patch-wb(index);}
                                    }
                                }


                                    InspectorLabel {text:"SELECTED PATCH";}
                                    InspectorValue {text:root.patch-model.length>0 && root.patch-index>=0 && root.patch-index<root.patch-model.length ? root.patch-model[root.patch-index] : "Prepare boundary groups in Mesh first.";}
                                    InspectorLabel { text: "PHYSICAL CONDITION"; }
                                    ComboBox {
                                        enabled: root.patch-model.length > 0 && !root.wb-busy;
                                        model: ["No-slip wall", "Moving wall", "Velocity inlet", "Pressure outlet"];
                                        current-index <=> root.bc-kind-index;
                                    }
                                    if root.bc-kind-index == 1 || root.bc-kind-index == 2 : VerticalLayout {
                                        spacing: 4px;
                                        InspectorLabel {text:root.bc-kind-index==1 ? "WALL VELOCITY (Ux · Uy · Uz)" : "INLET VELOCITY (Ux · Uy · Uz)";}
                                        HorizontalLayout {
                                            spacing: 4px;
                                            LineEdit { text <=> root.bc-value-x;placeholder-text:"Ux";enabled:!root.wb-busy; }
                                            LineEdit { text <=> root.bc-value-y;placeholder-text:"Uy";enabled:!root.wb-busy; }
                                            LineEdit { text <=> root.bc-value-z;placeholder-text:"Uz";enabled:!root.wb-busy; }
                                        }
                                    }
                                    if root.bc-kind-index == 3 : VerticalLayout {
                                        spacing: 4px;
                                        InspectorLabel { text: "KINEMATIC GAUGE PRESSURE p/ρ"; }
                                        LineEdit { text <=> root.bc-pressure; }
                                    }
                                    InspectorLabel {text:root.bc-kind-index==0 ? "Stationary impermeable wall: U=(0,0,0)." : root.bc-kind-index==1 ? "Prescribed wall velocity; for the cavity lid use U=(1,0,0)." : root.bc-kind-index==2 ? "Prescribed fluid velocity at an inlet." : "Prescribed kinematic pressure at the outlet; p/rho is not pressure in pascals.";wrap:word-wrap;}
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button { text: "APPLY TO SELECTED PATCH"; enabled: root.patch-model.length > 0 && !root.wb-busy; clicked => { root.apply-boundary-wb(); } }
                                        Button { text: "CLEAR"; enabled: root.patch-model.length > 0 && !root.wb-busy; clicked => { root.unassign-boundary-wb(); } }
                                    }
                                    InspectorValue { text: root.bc-assigned; }
                                    InspectorLabel { text: "Solve stays disabled until every exterior patch is assigned. The backend re-validates the full case before starting."; wrap: word-wrap; color: rgb(126,153,170); font-size: 10px; }
                            }
                                Card {min-width:180px;preferred-width:240px;max-width:300px;VerticalLayout {padding:14px;spacing:8px;
                                    InspectorLabel {text:"FLUID MATERIAL";}
                                    InspectorLabel {text:"DENSITY ρ";} LineEdit {text <=> root.material-density;enabled:!root.wb-busy;}
                                    InspectorLabel {text:"KINEMATIC VISCOSITY ν";} LineEdit {text <=> root.material-viscosity;enabled:!root.wb-busy;}
                                    InspectorLabel {text:"For a unit cavity: lid speed 1, side length 1, ν=0.01 gives Re=100. Use consistent units; there is no automatic geometry unit conversion.";wrap:word-wrap;}
                                    Button {text:"APPLY MATERIAL & CONTROLS";enabled:!root.wb-busy;clicked=>{root.apply-solver-settings-wb();}}
                                    InspectorLabel {text:"CLOSED CAVITY";} InspectorValue {text:"lid → Moving wall\nwalls → No-slip wall\nNo inlet or outlet required. Pressure uses an internal gauge.";}
                                    Button {text:"CONTINUE TO SOLUTION →";clicked=>{root.select-step(3);}}
                                } }
                                Card { min-width: 250px; horizontal-stretch: 2; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 10px;
                                Text { text: "BOUNDARY & VOLUME VIEW"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                InteractiveGeometryPreview { vertical-stretch: 1; preview-image: root.visualization-image; help-text:root.mesh-dimension-index==0 ? "CLICK: SELECT · DRAG: PAN · WHEEL: ZOOM · DOUBLE CLICK: FIT" : "CLICK: SELECT · 3D FIXED ISOMETRIC VIEW"; view-axis: root.geometry-view-axis; orbit(x, y, pressed-x, pressed-y) => { root.mesh-view-drag(x,y,pressed-x,pressed-y,self.width/1px,self.height/1px); } orbit-end => { root.mesh-view-end(); } zoom(delta) => { root.mesh-view-zoom(delta); } reset-view => { root.mesh-view-fit(); } pick-boundary(x, y, w, h) => { root.pick-boundary(x, y, w, h); } hover(x, y, w, h) => { root.mesh-hover(x, y, w, h); } }
                                Text { text: "Select a patch on the left to highlight its mesh boundary."; color: UiTheme.text-soft; font-size: 11px; }
                                HorizontalLayout {Button {text:"SHOW BOUNDARY MESH";clicked=>{root.show-mesh();root.mesh-color(1);}}}
                            } }
                        }
                    }
                    }
                }

                if !root.examples-open && root.current-step == 3 : Rectangle {
                    width: parent.width; height: parent.height;
                    run-scroll := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        horizontal-scrollbar-policy: as-needed;

                        VerticalLayout {
                            min-height: run-scroll.visible-height;
                            padding: root.page-padding; spacing: root.page-spacing;
                        SectionTitle { text: "04  Solution"; }
                        SectionHint { text: "Choose the numerical method, start the worker, and follow convergence without blocking the interface."; }
                        Text {text:root.wb-operation-feedback;color:UiTheme.text-soft;wrap:word-wrap;font-size:11px;}
                        HorizontalLayout {
                                height:max(540px,run-scroll.visible-height - 125px);
                                spacing: root.page-spacing;
                                WorkflowControlCard { min-width: 260px; preferred-width: 360px; max-width: 420px; horizontal-stretch: 1;

                                    InspectorLabel {text:"FLUID MATERIAL · FROM SETUP";}
                                    InspectorValue {text:"ρ="+root.material-density+" · ν="+root.material-viscosity;}
                                    Button {text:"EDIT MATERIAL IN SETUP";clicked=>{root.select-step(2);}}
                                    InspectorLabel { text: "SIMPLE COUPLING"; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        VerticalLayout { InspectorLabel { text: "MAX ITERATIONS"; } SpinBox { value <=> root.wb-max-iterations; minimum: 1; maximum: 1000000; } }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        VerticalLayout { InspectorLabel { text: "VELOCITY RELAX α"; } LineEdit { text <=> root.wb-velocity-relaxation; } }
                                        VerticalLayout { InspectorLabel { text: "PRESSURE RELAX α"; } LineEdit { text <=> root.wb-pressure-relaxation; } }
                                    }
                                    InspectorLabel { text: "CONTINUITY TOLERANCE"; }
                                    LineEdit { text <=> root.wb-continuity-tolerance; }
                                    InspectorLabel {text:"MOMENTUM / VELOCITY RELATIVE TOLERANCE";}
                                    LineEdit {text <=> root.wb-coupling-tolerance;}
                                    InspectorLabel {text:"Steady convergence requires mass conservation, momentum residual reduction and a stable velocity field.";wrap:word-wrap;}
                                    Button { text: "APPLY SETTINGS"; enabled:!root.wb-busy; clicked => { root.apply-solver-settings-wb(); } }
                                    InspectorLabel { text: "Linear solvers keep their verified backend defaults; advanced controls are intentionally not exposed here."; wrap: word-wrap; color: rgb(126,153,170); font-size: 10px; }
                                    Rectangle { height: 1px; background: UiTheme.border; }
                                    InspectorLabel { text: "SOLUTION STATUS"; }
                                    InspectorValue { text: root.wb-solution-summary; font-family: "monospace"; }
                                InspectorLabel {text:"RUN READINESS";}
                                InspectorValue {text:root.wb-run-readiness;}
                                HorizontalLayout {
                                    Button {text:"RUN WORKBENCH";enabled:root.can-run-workbench;clicked=>{root.run-workbench();}}
                                    Button {text:"CANCEL";enabled:root.wb-busy;clicked=>{root.cancel-workbench-job();}}
                                }
                                Button {text:"VIEW RESULTS →";enabled:!root.wb-busy;clicked=>{root.select-step(4);root.show-field();}}
                            }
                                Card { min-width: 350px; horizontal-stretch: 2; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 10px;
                                Text { text: "CONTINUITY · LAST 400 ITERATIONS"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                Rectangle { vertical-stretch: 1; background: UiTheme.viewport; border-color: UiTheme.viewport-border; border-width: 1px; Image { source: root.residual-image; width: parent.width; height: parent.height; image-fit: contain; } }
                                Text { text: "WORKBENCH SOLUTION"; color: UiTheme.text-dim; font-size: 10px; font-weight: 700; }
                                Text { text: root.wb-solution-summary; color: UiTheme.text; font-family: "monospace"; font-size: 11px; }
                                InspectorValue {text:root.wb-run-readiness;}
                            } }
                        }
                    }
                    }
                }

                if !root.examples-open && root.current-step == 4 : Rectangle {
                    width: parent.width; height: parent.height;
                    results-scroll := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        horizontal-scrollbar-policy: as-needed;

                        VerticalLayout {
                            min-height: results-scroll.visible-height;
                            padding: root.page-padding; spacing: root.page-spacing;
                        SectionTitle { text: "05  Results"; }
                        SectionHint { text: "Inspect scalar fields with configurable palettes, isolines, and cell-centred velocity vectors from sampled solver snapshots."; }
                        HorizontalLayout {
                                spacing: root.page-spacing;
                                Card { min-width: 350px; horizontal-stretch: 2; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 10px;
                                Text { text: root.visualization-title; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                Rectangle { vertical-stretch: 1; background: UiTheme.viewport; border-color: UiTheme.viewport-border; border-width: 1px;
                                    Image { source: root.visualization-image; width: parent.width; height: parent.height; image-fit: contain; }
                                    TouchArea {clicked=>{root.pick-boundary(self.mouse-x/1px,self.mouse-y/1px,self.width/1px,self.height/1px);}}
                                }
                                Text { text: root.animation-status; color: UiTheme.text-soft; font-size: 11px; wrap:word-wrap; }
                                Text {text:root.result-probe-text;color:UiTheme.text-soft;font-size:11px;wrap:word-wrap;}
                                HorizontalLayout { Button { text: "SPEED"; clicked => { root.select-result-field(0); } } Button { text: "PRESSURE"; clicked => { root.select-result-field(1); } } Button { text: "VORTICITY"; clicked => { root.select-result-field(2); } } Button { text: "TEMPERATURE"; clicked => { root.select-result-field(3); } } }
                                HorizontalLayout { Button {text:"Ux";clicked=>{root.select-result-field(4);}} Button {text:"Uy";clicked=>{root.select-result-field(5);}} Button {text:"Uz";clicked=>{root.select-result-field(6);}} }
                                Rectangle { height: 1px; background: UiTheme.border; }
                                Button { text:"EXPORT CELL DATA · CSV"; enabled:!root.wb-busy; clicked=>{root.export-result-csv();} }
                                HorizontalLayout {
                                    ComboBox {model:["3D surface", "XY slice", "XZ slice", "YZ slice"];current-index <=> root.result-slice-axis;selected(value)=>{root.apply-result-style();}}
                                    SpinBox {value <=> root.result-slice-percent;minimum:1;maximum:99;}
                                    Button {text:"APPLY SLICE (%)";clicked=>{root.apply-result-style();}}
                                }
                                Text {text:"Interior slices show cell values without smoothing. Position is a percentage of the model extent; use Surface for vectors.";wrap:word-wrap;color:UiTheme.text-faint;font-size:10px;}
                                Text { text: "POST-PROCESSING STYLE"; color: UiTheme.accent; font-size: 10px; font-weight: 700; }
                                HorizontalLayout {
                                    VerticalLayout { Text { text: "Plot"; color: UiTheme.text-muted; font-size: 10px; } ComboBox { model: ["Filled field", "Contours", "Contours + vectors", "Vectors only"]; current-index <=> root.result-plot-index; } }
                                    VerticalLayout { Text { text: "Color map"; color: UiTheme.text-muted; font-size: 10px; } ComboBox { model: ["Turbo", "Viridis", "Plasma", "Blue–red"]; current-index <=> root.result-colormap-index; } }
                                    VerticalLayout { Text { text: "Levels"; color: UiTheme.text-muted; font-size: 10px; } SpinBox { value <=> root.result-contour-levels; minimum: 3; maximum: 32; } }
                                }
                                HorizontalLayout { Text { text: "Range"; color: UiTheme.text-muted; vertical-alignment: center; } LineEdit { text <=> root.result-range-min; placeholder-text: "Auto min"; } LineEdit { text <=> root.result-range-max; placeholder-text: "Auto max"; } Button { text: "APPLY RANGE"; clicked => { root.apply-result-range(); } } Button { text: "AUTO"; clicked => { root.reset-result-range(); } } }
                                HorizontalLayout { Text { text: "Vectors"; color: UiTheme.text-muted; vertical-alignment: center; } ComboBox { model: ["Low", "Medium", "High"]; current-index <=> root.result-vector-density; } LineEdit { text <=> root.result-vector-scale; placeholder-text: "Auto scale"; } }
                                HorizontalLayout { Button { text: "APPLY STYLE"; clicked => { root.apply-result-style(); } } Button { text: "SEED STREAMLINE"; clicked => { root.seed-streamline(); } } Button { text: "CLEAR STREAMLINES"; clicked => { root.clear-streamlines(); } } }
                                Text { text: "Vectors use cell-centred velocity; arrows are adaptively sampled. Seed Streamline then click a 2D result cell."; color: UiTheme.text-faint; font-size: 10px; wrap: word-wrap; }
                                HorizontalLayout { Button { text: "FIELD"; clicked => { root.show-field(); } } Button { text: "MESH"; clicked => { root.show-mesh(); } } Button { text: "PLAY / PAUSE"; clicked => { root.animation-play-pause(); } } Button { text: "NEXT"; clicked => { root.animation-next(); } } }
                            } }
                                Card { min-width: 250px; preferred-width: 330px; max-width: 390px; horizontal-stretch: 1; VerticalLayout { padding: root.compact-ui ? 14px : 18px; spacing: 10px;
                                Text { text: "RUN SUMMARY"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                Text { text: root.residual-summary; color: UiTheme.text; font-family: "monospace"; font-size: 12px; }
                                Text { text: root.force-summary; color: UiTheme.text; font-family: "monospace"; font-size: 12px; }
                                Text { text: root.field-summary; color: UiTheme.text-muted; font-size: 11px; wrap: word-wrap; }
                                Text { text: "SOLVER LOG"; color: UiTheme.accent; font-size: 11px; font-weight: 700; }
                                TextEdit { text: root.log-text; read-only: true; vertical-stretch: 1; }
                            } }
                        }
                    }
                    }
                }

                }

                // ---- RIGHT PROPERTIES INSPECTOR ----
                if root.current-step != 0 || root.inspector-mode != 0 : Rectangle {
                    min-width: root.compact-ui ? 236px : 264px;
                    preferred-width: root.compact-ui ? 260px : 292px;
                    max-width: root.compact-ui ? 288px : 320px;
                    background: UiTheme.sidebar;
                    border-color: UiTheme.border-soft;
                    border-width: 1px;

                    VerticalLayout {
                        padding: root.compact-ui ? 9px : 12px;
                        spacing: 8px;

                        Text {
                            text: "PROPERTIES";
                            color: UiTheme.text-dim;
                            font-size: 10px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.inspector-title;
                            color: UiTheme.accent;
                            font-size: 12px;
                            font-weight: 800;
                        }

                        inspector-scroll := ScrollView {
                            vertical-stretch: 1;
                            horizontal-scrollbar-policy: always-off;

                            VerticalLayout {
                                min-height: inspector-scroll.visible-height;
                                spacing: 8px;

                                // 0 — geometry entity / stage overview
                                if root.inspector-mode == 0 : VerticalLayout {
                                    spacing: 6px;
                                    InspectorValue { text: root.inspector-info; }
                                    Rectangle { height: 1px; background: UiTheme.border; }
                                    InspectorLabel { text: "NAMED SELECTION MEMBERSHIP"; }
                                    InspectorValue { text: root.ns-members == "" ? "— none" : root.ns-members; font-family: "monospace"; }
                                    Rectangle { height: 1px; background: UiTheme.border; }
                                    InspectorLabel { text: "BODY TRANSLATE (ΔX · ΔY · ΔZ)"; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        LineEdit { text <=> root.body-translate-x; placeholder-text: "ΔX"; }
                                        LineEdit { text <=> root.body-translate-y; placeholder-text: "ΔY"; }
                                        LineEdit { text <=> root.body-translate-z; placeholder-text: "ΔZ"; }
                                    }
                                    Button { text: "TRANSLATE SELECTED BODY"; enabled: !root.wb-busy; clicked => { root.translate-selected-body(); } }
                                    Rectangle { height: 1px; background: UiTheme.border; }
                                    InspectorLabel { text: "BODY ROTATE"; }
                                    InspectorLabel { text: "PIVOT (X · Y · Z)"; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        LineEdit { text <=> root.body-pivot-x; placeholder-text: "PX"; }
                                        LineEdit { text <=> root.body-pivot-y; placeholder-text: "PY"; }
                                        LineEdit { text <=> root.body-pivot-z; placeholder-text: "PZ"; }
                                    }
                                    InspectorLabel { text: "AXIS (X · Y · Z) / ANGLE °"; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        LineEdit { text <=> root.body-axis-x; placeholder-text: "AX"; }
                                        LineEdit { text <=> root.body-axis-y; placeholder-text: "AY"; }
                                        LineEdit { text <=> root.body-axis-z; placeholder-text: "AZ"; }
                                        LineEdit { text <=> root.body-angle-degrees; placeholder-text: "°"; }
                                    }
                                    Button { text: "ROTATE SELECTED BODY"; enabled: !root.wb-busy; clicked => { root.rotate-selected-body(); } }
                                    InspectorLabel { text: "Select entities in the project tree, then open NAMED SELECTIONS to group them."; wrap: word-wrap; color: rgb(126,153,170); font-size: 10px; }
                                    Button { text: "NAMED SELECTIONS →"; clicked => { root.inspector-mode = 1; } }
                                }

                                // 1 — Named Selection editor
                                if root.inspector-mode == 1 : VerticalLayout {
                                    spacing: 6px;
                                    InspectorLabel { text: "CREATE FROM SELECTED ENTITIES"; }
                                    LineEdit { text <=> root.ns-edit-name; placeholder-text: "e.g. inlet"; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button { text: "CREATE"; clicked => { root.create-named-selection(); } }
                                    }
                                    Rectangle { height: 1px; background: UiTheme.border; }
                                    InspectorLabel { text: "SELECTED GROUP"; }
                                    InspectorValue { text: root.ns-members == "" && !root.ns-has-selection ? "No Named Selection selected." : root.ns-members; font-family: "monospace"; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button { text: "RENAME"; enabled: root.ns-has-selection; clicked => { root.rename-named-selection(); } }
                                        Button { text: "DELETE"; enabled: root.ns-has-selection; clicked => { root.delete-named-selection(); } }
                                    }
                                    InspectorLabel { text: "Names must be unique, non-empty, and contain no quotes or whitespace. Groups feed Gmsh physical groups."; wrap: word-wrap; color: rgb(126,153,170); font-size: 10px; }
                                }

                                // 2 — workflow overview
                                if root.inspector-mode == 2 : VerticalLayout {
                                    spacing: 8px;
                                    InspectorValue {text:root.wb-mesh-summary;}
                                    Button {text:"OPEN MESH";clicked=>{root.select-step(1);}}
                                }

                                // 3 — workflow overview
                                if root.inspector-mode == 3 : VerticalLayout {
                                    spacing: 8px;
                                    InspectorValue {text:root.bc-assigned;}
                                    Button {text:"OPEN SETUP";clicked=>{root.select-step(2);}}
                                }

                                // 4 — workflow overview
                                if root.inspector-mode == 4 : VerticalLayout {
                                    spacing: 8px;
                                    InspectorValue {text:root.wb-solution-summary;}
                                    Button {text:"OPEN SOLUTION";clicked=>{root.select-step(3);}}
                                }

                                // 5 — results
                                if root.inspector-mode == 5 : VerticalLayout {
                                    spacing: 6px;
                                    InspectorLabel { text: "AVAILABLE FIELDS"; }
                                    InspectorValue { text: "Pressure · Velocity · Velocity magnitude (cell-centred)"; }
                                    InspectorLabel { text: "RUN REPORT"; }
                                    InspectorValue { text: root.wb-solution-summary; font-family: "monospace"; }
                                    InspectorLabel { text: "Successful workspace solves persist their VTK artifact under runs/run-NNNN/solution.vtk."; wrap: word-wrap; color: rgb(126,153,170); font-size: 10px; }
                                }

                                // 6 — persisted run record
                                if root.inspector-mode == 6 : VerticalLayout {
                                    spacing: 6px;
                                    InspectorLabel { text: "PERSISTED RUN METADATA"; }
                                    InspectorValue { text: root.inspector-info; font-family: "monospace"; }
                                    Rectangle { height: 1px; background: UiTheme.border; }
                                    Button { text: "DELETE RUN"; enabled: !root.wb-busy; clicked => { root.delete-run-wb(); } }
                                    InspectorLabel { text: "Delete is a two-step action: press once to arm confirmation, then press again to permanently remove this run's workspace artifacts."; wrap: word-wrap; color: rgb(126,153,170); font-size: 10px; }
                                }
                            }
                        }
                    }
                }
            }
        }

        StatusBar {
            compact-ui: root.compact-ui;
            project-loaded: root.project-loaded;
            current-step: root.current-step;
            threads: root.threads;
            status: root.status;
            status-cells: root.status-cells;
            status-iteration: root.status-iteration;
            status-continuity: root.status-continuity;
            project-path: root.project-path;
        }
        if root.recovery-pending : RecoveryDialog {
            compact-ui: root.compact-ui;
            workspace: root.recovery-workspace;
            recover => { root.recover-workspace(); }
            discard => { root.discard-workspace-recovery(); }
        }
        if root.unsaved-replacement-pending : UnsavedChangesDialog {
            compact-ui: root.compact-ui;
            save => { root.save-before-project-replacement(); }
            discard => { root.discard-before-project-replacement(); }
            cancel => { root.cancel-project-replacement(); }
        }
        if root.legacy-import-pending : LegacyImportDialog {
            compact-ui: root.compact-ui;
            project-name: root.legacy-import-project-name;
            recoverable-items: root.legacy-import-recoverable-items;
            skipped-items: root.legacy-import-skipped-items;
            cancel => { root.cancel-legacy-import(); }
            import-project => { root.confirm-legacy-import(); }
        }
    }
}
