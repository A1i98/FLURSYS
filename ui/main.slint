    in-out property <bool> sketch-plane-dialog-open:false;
    property <int> pending-sketch-tool:0;
    public function request-new-sketch(tool:int) {
        root.pending-sketch-tool=tool;
        root.sketch-plane-dialog-open=true;
    }
    public function start-sketch-on-plane(plane:int) {
        root.sketch-plane-dialog-open=false;
        root.geometry-cad-view-3d=true;
        if plane==3 {root.cad-command(22);}else{root.cad-sketch-plane=plane;root.cad-command(21);}
        if root.drawing-active {root.drawing-select-tool(root.pending-sketch-tool);}
        root.pending-sketch-tool=0;
    }
