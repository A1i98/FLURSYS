export component MainWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    title: root.project-loaded ? "FLURSYS — " + root.project-name : "FLURSYS — CFD Workbench";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1100px;
    min-height: 650px;
    background: UiTheme.background;

    in-out property <int> cad-workbench: 0;
    in-out property <int> cad-operation:1;
    in-out property <bool> cad-task-open:false;
    in-out property <bool> cad-auto-preview:true;
