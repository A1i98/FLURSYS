    in property <bool> profile-valid;
    in property <string> region-owner;
    in property <bool> region-grouped;
    in-out property <bool> drive-x:false;
    in-out property <bool> drive-y:false;
    in-out property <bool> drive-width:false;
    in-out property <bool> drive-height:false;
    in-out property <bool> equal-sides:false;
    in-out property <bool> centered:false;
    in property <string> constraint-status;
    in property <int> pick-role:0;
