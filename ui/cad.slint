import { Button, ComboBox, LineEdit, SpinBox, ScrollView, CheckBox } from "std-widgets.slint";
import { CadContextMenu } from "cad-context.slint";
import { CadToolButton } from "cad-tools.slint";
import { CadQuantityProperty, CadVectorProperty } from "cad-properties.slint";
import { UiTheme } from "components.slint";
export component CadTaskPanel inherits Rectangle {
    in property <[string]> selection-items;
    callback unselect(int);
    in-out property <int> workbench: 0;
    in property <int> operation:1;
    in property <string> task-title:"Pad";
    private property <bool> show-details:false;
    in-out property <int> primitive-kind: 0;
    in-out property <int> axis: 1;
    in property <bool> can-loft;
    in property <bool> can-pocket;
    in-out property <int> feature-mode:0;
    in-out property <string> name: "Body";
    in-out property <bool> finish-corner0:true;
    in-out property <bool> finish-corner1:true;
    in-out property <bool> finish-corner2:true;
    in-out property <bool> finish-corner3:true;
    in-out property <int> finish-opening:5;
    in-out property <string> size-x: "10";
