    in-out property <int> history-profile-index:0;
    in property <[string]> history-parents;
    in-out property <int> history-parent-index:0;
    in property <bool> direct-editing;
    in property <string> edit-status;
    in property <bool> task-open;
    in-out property <bool> auto-preview:true;
    in property <string> auto-status;
    in property <[string]> profiles;
