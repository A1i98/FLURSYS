    in-out property <string> axis-x:"0";
    in-out property <string> axis-y:"0";
    in-out property <string> axis-z:"1";
    private property <bool> show-history:true;
    property <string> length-label:root.length-unit==1 ? "cm" : root.length-unit==2 ? "m" : root.length-unit==3 ? "in" : "mm";
    property <string> angle-label:root.angle-unit==1 ? "rad" : "°";
    property <bool> needs-body:root.workbench==2 || root.workbench==3 || root.operation==49 || (root.operation>=53 && root.operation<=55);
    property <bool> profile-tool:root.operation==1 || root.operation==24 || root.operation==2 || root.operation==34 || root.operation==43 || root.operation==46 || root.operation==57;
    property <bool> ready:!root.face-editing && root.pick-role==0 && (root.editing-recipe || root.sketch-editing || root.editing-pad || (root.operation==20 ? root.can-loft : root.profile-tool ? root.profile-valid && ((root.operation!=24 && root.operation!=34) || root.can-pocket) : root.workbench==3 ? root.bodies.length>1 && root.source!=root.target : root.needs-body ? root.bodies.length>0 : true));
    callback units-changed();
