            color:UiTheme.text-secondary;font-size:11px;wrap:word-wrap;max-height:68px;
        }
        if root.task-open && !root.face-editing && !root.direct-editing && !(root.sketch-editing && root.edit-sketch-id==0) && root.operation!=13 : VerticalLayout {spacing:3px;
            CheckBox {text:"Automatic preview";checked <=> root.auto-preview;}
