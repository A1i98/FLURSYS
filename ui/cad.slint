            Text {text:root.face-editing ? "Face sketch" : root.task-open ? root.task-title : "Properties";color:UiTheme.accent;font-size:14px;font-weight:800;horizontal-stretch:1;wrap:word-wrap;}
            Text {text:root.busy ? "BUILDING" : root.previewing ? "PREVIEW" : root.task-open ? "EDIT" : "";color:UiTheme.text-muted;font-size:10px;vertical-alignment:center;}
        }
        if root.task-open || root.face-editing : HorizontalLayout {
            spacing:5px;
            if !root.face-editing : Button {text:root.sketch-editing && root.edit-sketch-id==0 ? (root.region-owner!="" ? "Create region" : "Create sketch") : "OK";primary:true;enabled:!root.busy && root.ready;min-width:0px;horizontal-stretch:1;max-height:34px;clicked=>{root.command(60);}}
            if !root.face-editing && !(root.sketch-editing && root.edit-sketch-id==0) && root.operation!=13 : Button {text:"Preview";enabled:!root.busy && root.ready;min-width:0px;horizontal-stretch:1;max-height:34px;clicked=>{root.command(62);}}
            Button {text:"Cancel";min-width:0px;horizontal-stretch:1;max-height:34px;clicked=>{root.command(61);}}
