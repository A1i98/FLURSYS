    in-out property <string> size-z: "6";
    in-out property <string> pos-x: "0";
    in-out property <string> pos-y: "0";
    in-out property <string> pos-z: "0";
    in-out property <string> angle: "360";
    in-out property <string> revolve-x:"0";
    in-out property <string> revolve-y:"0";
    in-out property <string> revolve-z:"0";
    in-out property <string> factor: "1.5";
    in-out property <string> tolerance: "0.001";
    in-out property <int> count: 4;
    in-out property <int> source: 0;
    in-out property <int> target: 1;
    in property <[string]> bodies;
    in property <string> inspector;
    in property <string> feedback;
    in property <bool> busy;
    in property <bool> has-profile;
    in property <bool> face-editing;
