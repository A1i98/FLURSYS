        }
        if root.pick-role!=0 : VerticalLayout {spacing:4px;
            Text {text:root.pick-role==1 ? "PICK CLOSED REGION · click its interior" : root.pick-role==2 ? "PICK AXIS · click a straight edge" : root.pick-role==3 ? "PICK SOURCE BODY" : root.pick-role==4 ? "PICK BOOLEAN TOOL BODY" : "PICK AXIS EDGE / MIRROR FACE";color:UiTheme.accent;font-size:11px;wrap:word-wrap;}
            Button {text:"Finish reference picking";enabled:!root.busy;clicked=>{root.command(90);}}
        }
        Rectangle {height:1px;background:UiTheme.border;}
        ScrollView {
            vertical-stretch:1;horizontal-scrollbar-policy:always-off;
            VerticalLayout {
                padding:2px;spacing:10px;
                if !root.face-editing && root.selection-items.length>0 : VerticalLayout {spacing:3px;
                    Text {text:"SELECTION · "+root.selection-items.length;color:UiTheme.accent;font-size:10px;font-weight:700;}
                    Text {text:"Ctrl-click to add or remove. Right-click retains the selected set.";color:UiTheme.text-muted;font-size:10px;wrap:word-wrap;}
                    for item[index] in root.selection-items : HorizontalLayout {spacing:4px;
                        Text {text:item;color:UiTheme.text-secondary;font-size:11px;overflow:elide;vertical-alignment:center;horizontal-stretch:1;}
                        CadToolButton {icon:@image-url("icons/clear.svg");label:"Remove this item from selection";enabled:!root.busy && !root.previewing;clicked=>{root.unselect(index);}}
                    }
                    Rectangle {height:1px;background:UiTheme.border;}
                }
                if !root.task-open && !root.face-editing : Text {text:"Select a design tool in the toolbar. Its properties and confirmation controls open here.";color:UiTheme.text-secondary;font-size:12px;wrap:word-wrap;}
                if root.face-editing : Text {text:"Draw Circle or Rectangle in the viewport. The second point finishes the profile. Cancel closes drawing mode.";color:UiTheme.text-secondary;font-size:12px;wrap:word-wrap;}
                if root.task-open : HorizontalLayout {
                    spacing:4px;
                    Text {text:"Units";color:UiTheme.text-muted;font-size:10px;vertical-alignment:center;}
                    ComboBox {model:["mm","cm","m","in"];current-index <=> root.length-unit;enabled:!root.busy;min-width:0px;preferred-width:1px;horizontal-stretch:1;max-height:30px;selected(value)=>{root.units-changed();}}
                    ComboBox {model:["deg","rad"];current-index <=> root.angle-unit;enabled:!root.busy;min-width:0px;preferred-width:1px;horizontal-stretch:1;max-height:30px;selected(value)=>{root.units-changed();}}
                }
                if root.task-open && root.needs-body && !root.editing-pad && !root.editing-recipe : VerticalLayout {
                    Text {text:root.workbench==3 ? "Source body" : root.operation==4 ? "BODY TO ROTATE" : root.operation==41 ? "BODY TO MIRROR" : "SOURCE BODY";color:UiTheme.text-muted;font-size:10px;}
                    ComboBox {model:root.bodies;current-index <=> root.source;enabled:!root.busy && !root.direct-editing;min-width:0px;max-height:32px;selected(value)=>{root.parameters-edited();root.select-body(self.current-index);}}
                    HorizontalLayout {spacing:4px;
                        Button {text:"Pick body…";enabled:!root.busy;min-width:0px;clicked=>{root.command(93);}}
                        Button {text:"Use selection";enabled:!root.busy;min-width:0px;clicked=>{root.command(96);}}
                    }
                }
                if root.task-open && root.profile-tool && !root.sketch-editing && !root.editing-recipe : VerticalLayout {
                    spacing:5px;
                    Text {text:root.operation==2 ? "CLOSED PROFILE TO REVOLVE" : "CLOSED FEATURE PROFILE";color:UiTheme.accent;font-size:10px;font-weight:700;}
                    Text {text:root.profile-valid ? "Assigned closed region · Face #"+root.profile-face : "Required: select a closed sketch region, not a boundary line.";color:root.profile-valid ? UiTheme.text : UiTheme.accent;font-size:11px;wrap:word-wrap;}
                    ComboBox {model:root.profiles;current-index <=> root.profile-index;enabled:!root.busy;min-width:0px;max-height:32px;selected(value)=>{root.command(88);}}
                    HorizontalLayout {spacing:4px;
                        Button {text:"Assign region";enabled:!root.busy && root.profiles.length>0;min-width:0px;clicked=>{root.command(88);}}
                        Button {text:"Clear";enabled:!root.busy && root.profile-valid;min-width:0px;clicked=>{root.command(91);}}
                    }
                    HorizontalLayout {spacing:4px;
                        Button {text:"Pick region…";enabled:!root.busy;min-width:0px;clicked=>{root.command(87);}}
                        Button {text:"Capture selection";enabled:!root.busy;min-width:0px;clicked=>{root.command(89);}}
                    }
                }
                if root.task-open && root.editing-recipe : Text {text:"Editing an existing operation. Source references are fixed; OK rebuilds this feature and its dependents.";color:UiTheme.accent;font-size:11px;wrap:word-wrap;}
                if root.task-open && root.sketch-editing : VerticalLayout {
                    spacing:8px;
                    Text {text:"SUPPORT";color:UiTheme.accent;font-size:10px;font-weight:700;}
                    ComboBox {model:["XY plane","YZ plane","ZX plane","Selected planar face"];current-index <=> root.sketch-plane;enabled:!root.busy && root.edit-sketch-id==0 && root.sketch-host=="" && root.region-owner=="";min-width:0px;max-height:32px;selected(value)=>{root.parameters-edited();}}
                    if root.sketch-host!="" : Text {text:"Attached to solid face #"+root.sketch-host+" · local coordinates";color:UiTheme.text-secondary;font-size:11px;wrap:word-wrap;}
CadQuantityProperty {label:"Plane offset";value <=> root.sketch-offset;unit:root.length-label;enabled:!root.busy && !root.direct-editing && !root.region-grouped;edited=>{root.parameters-edited();}}
                    ComboBox {model:["Circle","Rectangle"];current-index <=> root.sketch-kind;enabled:!root.busy && root.edit-sketch-id==0;min-width:0px;max-height:32px;selected(value)=>{root.parameters-edited();}}
                    if root.direct-editing : Text {text:root.edit-status;color:UiTheme.accent;font-size:11px;wrap:word-wrap;}
                    if root.sketch-kind==0 : CadQuantityProperty {label:"Radius";value <=> root.size-x;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    if root.sketch-kind==1 : VerticalLayout {spacing:8px;
CadQuantityProperty {label:"Width";value <=> root.size-x;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
CadQuantityProperty {label:"Height";value <=> root.size-y;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    }
CadVectorProperty {label:"Center / corner in sketch coordinates";x-value <=> root.pos-x;y-value <=> root.pos-y;z-value <=> root.pos-z;unit:root.length-label;three:false;enabled:!root.busy;edited=>{root.parameters-edited();}}
                }
                if root.task-open && root.sketch-editing && root.edit-sketch-id>0 : VerticalLayout {spacing:5px;
                    Text {text:"DRIVING CONSTRAINTS";color:UiTheme.accent;font-size:10px;font-weight:700;}
                    Text {text:root.constraint-status;color:UiTheme.accent;font-size:11px;wrap:word-wrap;}
                    Text {text:"Checked dimensions drive this region. Change their numeric values above; dragging respects them. Constraints are saved with OK.";color:UiTheme.text-muted;font-size:10px;wrap:word-wrap;}
                    HorizontalLayout {spacing:4px;
                        CheckBox {text:"Fix X";checked <=> root.drive-x;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                        CheckBox {text:"Fix Y";checked <=> root.drive-y;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                    }
                    CheckBox {text:root.sketch-kind==0 ? "Driving radius" : "Driving width";checked <=> root.drive-width;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                    if root.sketch-kind==1 : VerticalLayout {
                        CheckBox {text:"Driving height";checked <=> root.drive-height;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                        CheckBox {text:"Equal sides (square)";checked <=> root.equal-sides;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                    }
                    CheckBox {text:"Center on sketch origin";checked <=> root.centered;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                    if root.region-grouped : Text {text:"Regions share one support. Independent plane offset edits are disabled.";color:UiTheme.text-muted;font-size:10px;wrap:word-wrap;}
                }
                if root.task-open && !root.editing-recipe && (root.workbench==1 || root.operation==13) : CadQuantityProperty {label:"Name";value <=> root.name;enabled:!root.busy;edited=>{root.parameters-edited();}}
                if root.task-open && root.workbench==1 : VerticalLayout {spacing:8px;
                    if root.primitive-kind==0 : VerticalLayout {spacing:8px;
CadQuantityProperty {label:"Length";value <=> root.size-x;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
CadQuantityProperty {label:"Width";value <=> root.size-y;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
CadQuantityProperty {label:"Height";value <=> root.size-z;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    }
                    if root.primitive-kind!=0 : CadQuantityProperty {label:"Radius / major radius";value <=> root.size-x;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    if root.primitive-kind==1 || root.primitive-kind==3 : CadQuantityProperty {label:"Height";value <=> root.size-y;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    if root.primitive-kind==4 : CadQuantityProperty {label:"Minor radius";value <=> root.size-y;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
CadVectorProperty {label:"Position";x-value <=> root.pos-x;y-value <=> root.pos-y;z-value <=> root.pos-z;unit:root.length-label;three:true;enabled:!root.busy;edited=>{root.parameters-edited();}}
                }
                if root.task-open && !root.sketch-editing && (root.operation==1 || root.operation==24 || root.operation==34 || root.editing-pad) : VerticalLayout {spacing:8px;
CadQuantityProperty {label:"Depth";value <=> root.size-z;unit:root.length-label;enabled:!root.busy && !((root.operation==34 || root.editing-pocket) && (root.pocket-end-mode!=0 || root.through-all));edited=>{root.parameters-edited();}}
                    if root.operation==1 || root.operation==24 : CheckBox {text:"Reverse direction";checked <=> root.reverse;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                    if root.operation==34 || root.editing-pocket : VerticalLayout {spacing:6px;
                        Text {text:"END CONDITION";color:UiTheme.text-muted;font-size:9px;font-weight:700;}
                        ComboBox {model:["Blind depth","Through all","Up to face"];current-index <=> root.pocket-end-mode;enabled:!root.busy;min-width:0px;selected(value)=>{root.through-all=self.current-index==1;root.parameters-edited();}}
                        if root.pocket-end-mode==2 : HorizontalLayout {spacing:5px;
                            Button {text:root.pocket-stop-face=="" ? "Pick stop face" : "Face #"+root.pocket-stop-face;enabled:!root.busy;clicked=>{root.command(98);}}
                            Button {text:"×";enabled:!root.busy && root.pocket-stop-face!="";clicked=>{root.pocket-stop-face="";root.parameters-edited();}}
                        }
                    }
                    if root.operation==24 || root.operation==34 || root.editing-pocket : CadQuantityProperty {label:"Intersection tolerance";value <=> root.tolerance;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                }
                if root.task-open && (root.operation==2 || root.operation==57) && !root.sketch-editing : VerticalLayout {spacing:8px;
CadQuantityProperty {label:"Revolution angle";value <=> root.angle;unit:root.angle-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    Text {text:root.angle-unit==1 ? "Range: greater than 0, at most 2π rad" : "Range: greater than 0, at most 360°";color:UiTheme.text-muted;font-size:10px;wrap:word-wrap;}
                    HorizontalLayout {spacing:4px;
                        Button {text:"360°";min-width:0px;enabled:!root.busy;clicked=>{root.command(82);}}
                        Button {text:"180°";min-width:0px;enabled:!root.busy;clicked=>{root.command(83);}}
                    }
                    CheckBox {text:"Reverse revolution";checked <=> root.reverse;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                    Text {text:"REVOLUTION AXIS";color:UiTheme.accent;font-size:10px;font-weight:700;}
                    ComboBox {model:["Global / custom axis","Sketch horizontal axis","Sketch vertical axis","Straight edge reference"];current-index <=> root.axis-mode;min-width:0px;enabled:!root.busy;selected(value)=>{root.parameters-edited();}}
                    if root.axis-mode==3 : VerticalLayout {spacing:5px;
                        ComboBox {model:root.axis-edges;current-index <=> root.axis-edge-index;enabled:!root.busy && root.axis-edges.length>0;min-width:0px;selected(value)=>{root.command(78);}}
                        Button {text:"Use profile line";enabled:!root.busy && root.axis-edges.length>0;min-width:0px;clicked=>{root.command(78);}}
                        HorizontalLayout {spacing:4px;
                            Button {text:"Pick edge…";enabled:!root.busy;min-width:0px;clicked=>{root.command(80);}}
                            Button {text:"Capture selected";enabled:!root.busy;min-width:0px;clicked=>{root.command(79);}}
                        }
                        Text {text:root.axis-edge!="" ? "Linked axis: edge #"+root.axis-edge : "Select a straight line. Profile selection is retained.";color:UiTheme.text-secondary;font-size:11px;wrap:word-wrap;}
                    }
                    if root.axis-mode==0 : CadVectorProperty {label:"Point on revolution axis";x-value <=> root.revolve-x;y-value <=> root.revolve-y;z-value <=> root.revolve-z;unit:root.length-label;three:true;enabled:!root.busy;edited=>{root.parameters-edited();}}
                }
                if root.task-open && (((root.operation==2 || root.operation==57) && root.axis-mode==0) || root.operation==4 || root.operation==41 || root.operation==44) && !root.sketch-editing : VerticalLayout {spacing:8px;
                    Text {text:root.operation==41 ? "Mirror plane normal" : "Axis direction";color:UiTheme.text-muted;font-size:10px;}
                    ComboBox {model:["X","Y","Z","Custom vector"];current-index <=> root.axis;enabled:!root.busy;min-width:0px;max-height:32px;selected(value)=>{root.parameters-edited();}}
                    if root.operation!=2 : Button {text:root.operation==41 ? "Pick mirror plane…" : "Pick rotation axis…";enabled:!root.busy;min-width:0px;clicked=>{root.command(95);}}
                    if root.operation!=2 : Button {text:root.operation==41 ? "Use selected face / edge as plane normal" : "Use selected edge / face as axis";enabled:!root.busy;min-width:0px;clicked=>{root.parameters-edited();root.command(81);}}
                    if root.axis==3 : CadVectorProperty {label:"Direction (nonzero)";x-value <=> root.axis-x;y-value <=> root.axis-y;z-value <=> root.axis-z;unit:"";three:true;enabled:!root.busy;edited=>{root.parameters-edited();}}
                }
                if root.task-open && root.operation==43 : CadVectorProperty {label:"Sweep displacement";x-value <=> root.size-x;y-value <=> root.size-y;z-value <=> root.size-z;unit:root.length-label;three:true;enabled:!root.busy;edited=>{root.parameters-edited();}}
                if root.task-open && root.operation==46 : VerticalLayout {spacing:8px;
CadQuantityProperty {label:"Extrusion depth";value <=> root.size-z;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
CadQuantityProperty {label:"Top profile scale";value <=> root.factor;unit:"×";enabled:!root.busy;edited=>{root.parameters-edited();}}
                    CheckBox {text:"Reverse direction";checked <=> root.reverse;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                    Text {text:"Scale is measured about the sketch origin.";color:UiTheme.text-muted;font-size:10px;wrap:word-wrap;}
                }
                if root.task-open && root.operation==20 : VerticalLayout {spacing:6px;
                    Text {text:"ORDERED LOFT SECTIONS";color:UiTheme.accent;font-size:10px;font-weight:700;}
                    Text {text:"Ctrl-click profiles in Project, then adjust their order here. Boundary loop and edge counts must match.";color:UiTheme.text-secondary;font-size:11px;wrap:word-wrap;}
                    ComboBox {model:root.loft-sections;current-index <=> root.loft-index;min-width:0px;enabled:!root.busy;}
                    HorizontalLayout {spacing:4px;
                        Button {text:"Up";enabled:!root.busy && root.loft-index>0;min-width:0px;clicked=>{root.command(84);}}
                        Button {text:"Down";enabled:!root.busy && root.loft-index+1<root.loft-sections.length;min-width:0px;clicked=>{root.command(85);}}
                        Button {text:"Remove";enabled:!root.busy && root.loft-sections.length>0;min-width:0px;clicked=>{root.command(86);}}
                    }
                }
                if root.task-open && root.workbench==2 && root.operation!=13 : VerticalLayout {spacing:8px;
                    CadVectorProperty {label:root.operation==7 ? "Pattern step" : root.operation==3 || root.operation==6 ? "Displacement" : root.operation==41 ? "Point on mirror plane" : "Pivot";x-value <=> root.pos-x;y-value <=> root.pos-y;z-value <=> root.pos-z;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    if root.operation==4 || root.operation==44 : CadQuantityProperty {label:"Angle / angular step";value <=> root.angle;unit:root.angle-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    if root.operation==5 : CadQuantityProperty {label:"Uniform scale";value <=> root.factor;unit:"×";enabled:!root.busy;edited=>{root.parameters-edited();}}
                    if root.operation==42 : CadVectorProperty {label:"Scale factors";x-value <=> root.size-x;y-value <=> root.size-y;z-value <=> root.size-z;unit:"×";three:true;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    if root.operation==7 || root.operation==44 : VerticalLayout {
                        Text {text:"Instances (including source)";color:UiTheme.text-secondary;font-size:11px;}
                        SpinBox {value <=> root.count;minimum:2;maximum:64;enabled:!root.busy;min-width:0px;max-height:32px;edited(value)=>{root.parameters-edited();}}
                    }
                    if (root.operation==3 || root.operation==4 || root.operation==5) && !root.editing-recipe : CheckBox {text:"Create a copy";checked <=> root.transform-copy;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                    if (root.operation==41 || root.operation==42) && !root.editing-recipe : Text {text:"This operation creates a new body and retains the source.";color:UiTheme.text-muted;font-size:11px;wrap:word-wrap;}
                }
                if root.task-open && root.workbench==3 : VerticalLayout {spacing:8px;
                    if !root.editing-recipe : Text {text:"Tool body";color:UiTheme.text-muted;font-size:10px;}
                    if !root.editing-recipe : ComboBox {model:root.bodies;current-index <=> root.target;enabled:!root.busy;min-width:0px;max-height:32px;selected(value)=>{root.parameters-edited();}}
                    if !root.editing-recipe : HorizontalLayout {spacing:4px;
                        Button {text:"Pick tool…";enabled:!root.busy;min-width:0px;clicked=>{root.command(94);}}
                        Button {text:"Use selection";enabled:!root.busy;min-width:0px;clicked=>{root.command(97);}}
                    }
CadQuantityProperty {label:"Intersection tolerance";value <=> root.tolerance;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    Text {text:"Original inputs are retained. History edits rebuild dependent bodies.";color:UiTheme.text-muted;font-size:11px;wrap:word-wrap;}
                }
                if root.task-open && root.operation==56 : VerticalLayout {spacing:8px;
                    Text {text:"HOLE · SUPPORT FACE #"+root.sketch-host;color:UiTheme.accent;font-size:10px;}
                    CadQuantityProperty {label:"Diameter";value <=> root.size-x;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    CadVectorProperty {label:"Center · face local coordinates";x-value <=> root.pos-x;y-value <=> root.pos-y;z-value <=> root.pos-z;three:false;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    CheckBox {text:"Through all";checked <=> root.through-all;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                    CadQuantityProperty {label:"Depth";value <=> root.size-z;unit:root.length-label;enabled:!root.busy && !root.through-all;edited=>{root.parameters-edited();}}
                    CadQuantityProperty {label:"Intersection tolerance";value <=> root.tolerance;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    Text {text:"The circular sketch and Pocket are retained in history. Edit the source sketch to change diameter or position.";color:UiTheme.text-muted;font-size:11px;wrap:word-wrap;}
                }
                if root.task-open && root.operation==57 : CadQuantityProperty {label:"Intersection tolerance";value <=> root.tolerance;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                if root.task-open && root.operation>=53 && root.operation<=55 : VerticalLayout {spacing:8px;
                    Text {text:root.operation==55 ? "REMOVE FACE · PRISM SHELL" : "LONGITUDINAL PRISM EDGES";color:UiTheme.accent;font-size:10px;font-weight:700;}
                    CadQuantityProperty {label:root.operation==53 ? "Fillet radius" : root.operation==54 ? "Equal chamfer distance" : "Wall and floor thickness";value <=> root.size-x;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                    if root.operation!=55 : VerticalLayout {spacing:4px;
                        CheckBox {text:"Corner X0 · Y0";checked <=> root.finish-corner0;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                        CheckBox {text:"Corner Xmax · Y0";checked <=> root.finish-corner1;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                        CheckBox {text:"Corner Xmax · Ymax";checked <=> root.finish-corner2;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                        CheckBox {text:"Corner X0 · Ymax";checked <=> root.finish-corner3;enabled:!root.busy;toggled=>{root.parameters-edited();}}
                    }
                    if root.operation==55 : VerticalLayout {spacing:4px;
                        Text {text:"Face to remove · sketch local axes";color:UiTheme.text-secondary;font-size:11px;}
                        ComboBox {model:["X minimum","X maximum","Y minimum","Y maximum","Z minimum","Z maximum"];current-index <=> root.finish-opening;enabled:!root.busy;selected(value)=>{root.parameters-edited();}}
                    }
                    Text {text:"Supports Box and rectangular Pad on any plane. Ctrl-select longitudinal edges or select the shell opening before starting. Input roles are saved in history.";color:UiTheme.text-secondary;font-size:11px;wrap:word-wrap;}
                }
                if root.task-open && root.operation==49 : CadQuantityProperty {label:"Chord tolerance";value <=> root.tolerance;unit:root.length-label;enabled:!root.busy;edited=>{root.parameters-edited();}}
                if !root.task-open && !root.face-editing && root.sketches.length>0 : VerticalLayout {spacing:6px;
                    Text {text:"SKETCHES";color:UiTheme.accent;font-size:10px;font-weight:700;}
                    ComboBox {model:root.sketches;current-index <=> root.sketch-index;min-width:0px;max-height:32px;}
                    HorizontalLayout {spacing:5px;
                        Button {text:"Edit";enabled:!root.busy;min-width:0px;clicked=>{root.command(39);}}
                        Button {text:"Dimensions";enabled:!root.busy;min-width:0px;clicked=>{root.command(28);}}
                        Button {text:"+ Region";enabled:!root.busy;min-width:0px;clicked=>{root.command(92);}}
                    }
                }
                if !root.task-open && !root.face-editing && root.features.length>0 : VerticalLayout {spacing:6px;
                    Text {text:"FEATURES";color:UiTheme.accent;font-size:10px;font-weight:700;}
                    ComboBox {model:root.features;current-index <=> root.feature-index;min-width:0px;max-height:32px;}
                    Button {text:"Edit selected feature";enabled:!root.busy;min-width:0px;max-height:32px;clicked=>{root.command(30);}}
                }
                if root.bodies.length>0 : CheckBox {text:"Body details";checked <=> root.show-details;}
                if root.show-details : Text {text:root.inspector;color:UiTheme.text-secondary;font-size:11px;wrap:word-wrap;}
                if root.history!="" : CheckBox {text:"Selected feature & inputs";checked <=> root.show-history;}
                if root.show-history && !root.task-open : VerticalLayout {spacing:5px;
                    Text {text:"Select a step in Project → Model history. Double-click to edit; right-click for feature actions.";color:UiTheme.text-secondary;font-size:11px;wrap:word-wrap;}
                    HorizontalLayout {spacing:4px;
                        Button {text:"Undo";enabled:!root.busy;min-width:0px;clicked=>{root.command(75);}}
                        Button {text:"Redo";enabled:!root.busy;min-width:0px;clicked=>{root.command(76);}}
                    }
                    if root.bodies.length>0 : Text {text:root.bodies[root.source];color:UiTheme.accent;font-size:12px;wrap:word-wrap;}
                    HorizontalLayout {spacing:4px;
                        Button {text:"Edit";enabled:!root.busy && root.bodies.length>0;min-width:0px;clicked=>{root.command(64);}}
                        Button {text:"Show / hide";enabled:!root.busy && root.bodies.length>0;min-width:0px;clicked=>{root.command(12);}}
                    }
                    if root.history-profiles.length>0 : VerticalLayout {spacing:4px;
                        Text {text:"SOURCE SKETCHES";color:UiTheme.text-muted;font-size:10px;}
                        ComboBox {model:root.history-profiles;current-index <=> root.history-profile-index;min-width:0px;enabled:!root.busy;}
                        Button {text:"Edit source sketch";enabled:!root.busy;min-width:0px;clicked=>{root.command(65);}}
                    }
                    if root.history-parents.length>0 : VerticalLayout {spacing:4px;
                        Text {text:"INPUT BODIES";color:UiTheme.text-muted;font-size:10px;}
                        ComboBox {model:root.history-parents;current-index <=> root.history-parent-index;min-width:0px;enabled:!root.busy;}
                        Button {text:"Select input in history";enabled:!root.busy;min-width:0px;clicked=>{root.command(77);}}
                    }
                    Text {text:"Edit saved feature parameters or its source sketch. Dependent bodies rebuild together. Multi-profile operations: edit each sketch from Project.";color:UiTheme.text-muted;font-size:10px;wrap:word-wrap;}

                }
                Rectangle {vertical-stretch:1;}
            }
        }
    }
}
