import { UiTheme } from "components.slint";
export component NativeCadCanvas inherits Rectangle {
    in property <image> frame;
    in property <string> feedback;
    callback resize(float,float);
    callback pointer(int,float,float,int,bool,bool,bool);
    callback wheel(float,float,bool,bool,bool);
    callback key(string,bool,bool,bool,bool);
    background:UiTheme.viewport;
    changed width=>{root.resize(root.width/1px,root.height/1px);}
    changed height=>{root.resize(root.width/1px,root.height/1px);}
    Image {width:parent.width;height:parent.height;source:root.frame;image-fit:fill;}
    focus:=FocusScope {
        width:parent.width;height:parent.height;
        key-pressed(e)=>{root.key(e.text,true,e.modifiers.control,e.modifiers.shift,e.modifiers.alt);accept}
        key-released(e)=>{root.key(e.text,false,e.modifiers.control,e.modifiers.shift,e.modifiers.alt);accept}
        TouchArea {
            pointer-event(e)=>{
                if e.kind==PointerEventKind.down {focus.focus();}
                root.pointer(e.kind==PointerEventKind.down ? 1 : e.kind==PointerEventKind.up ? 2 : 3,self.mouse-x/1px,self.mouse-y/1px,e.button==PointerEventButton.right ? 1 : e.button==PointerEventButton.middle ? 2 : 0,e.modifiers.control,e.modifiers.shift,e.modifiers.alt);
            }
            moved=>{root.pointer(0,self.mouse-x/1px,self.mouse-y/1px,0,false,false,false);}
            scroll-event(e)=>{root.wheel(e.delta-x/1px,e.delta-y/1px,e.modifiers.control,e.modifiers.shift,e.modifiers.alt);accept}
        }
    }
    if root.feedback!="" : Rectangle {
        x:8px;y:parent.height - self.height - 8px;width:parent.width - 16px;height:44px;
        background:UiTheme.sidebar;border-color:UiTheme.border;border-width:1px;border-radius:4px;
        Text {x:10px;y:6px;width:parent.width - 20px;height:parent.height - 12px;text:root.feedback;color:UiTheme.text;wrap:word-wrap;}
    }
}
