import { Button } from "std-widgets.slint";
import { CadToolButton } from "cad-tools.slint";
import { UiTheme } from "components.slint";
export component SketchLineContextMenu inherits Rectangle {
    width:0px;height:0px;
    in-out property <float> pick-x;
    in-out property <float> pick-y;
    callback edit(int);
    callback utility(int);
    public function show() { popup.show(); }
    popup := PopupWindow {
        width:150px;height:120px;
        close-policy:close-on-click-outside;
        Rectangle {background:UiTheme.sidebar;border-width:1px;border-color:UiTheme.border-strong;border-radius:6px;
            VerticalLayout {padding:10px;spacing:5px;
                Text {text:"XY SKETCH LINE";color:UiTheme.accent;font-size:10px;font-weight:700;}
                HorizontalLayout {spacing:5px;
                    CadToolButton {icon:@image-url("icons/trim.svg");label:"Trim at this point";clicked=>{popup.close();root.edit(4);}}
                    CadToolButton {icon:@image-url("icons/extend.svg");label:"Extend this endpoint";clicked=>{popup.close();root.edit(5);}}
                    CadToolButton {icon:@image-url("icons/split.svg");label:"Split at this point";clicked=>{popup.close();root.edit(6);}}
                }
                HorizontalLayout {spacing:5px;
                    CadToolButton {icon:@image-url("icons/undo.svg");label:"Undo geometry edit";clicked=>{popup.close();root.utility(6);}}
                    CadToolButton {icon:@image-url("icons/fit.svg");label:"Fit all";clicked=>{popup.close();root.utility(5);}}
                    CadToolButton {icon:@image-url("icons/delete.svg");label:"Delete selected open line";clicked=>{popup.close();root.utility(4);}}
                }
            }
        }
    }
}
export component CadContextMenu inherits Rectangle {
    width:0px;height:0px;
    property <bool> confirm-delete:false;
    out property <length> menu-height:root.confirm-delete ? 186px : root.axis-task ? 104px : root.has-body ? 428px : root.has-sketch ? 278px : 202px;
    public function show() { root.confirm-delete=false;menu.show(); }
    in property <bool> can-edit-feature:true;
    in property <bool> has-source-sketch:true;
    in property <bool> has-body;
    in property <bool> planar-face;
    in property <bool> has-sketch;
    in property <bool> has-edge;
    in property <bool> axis-task;
    in property <string> selection-label:"Model body";
    in property <bool> locked;
    callback command(int);
    callback activate(int);
    callback fit();
    callback frame-selection();
    callback normal-view();
    menu := PopupWindow {
        width:270px;height:root.menu-height;
        close-policy:close-on-click-outside;
        Rectangle {background:UiTheme.sidebar;border-width:1px;border-color:UiTheme.border-strong;border-radius:6px;
            if root.confirm-delete : VerticalLayout {padding:10px;spacing:8px;
                Text {text:"Delete selected body?";color:UiTheme.accent;font-size:13px;font-weight:700;}
                Text {text:"Dependent features and attached sketches are protected. Undo restores a successful deletion.";color:UiTheme.text-secondary;font-size:11px;wrap:word-wrap;}
                Button {text:"Delete body";clicked=>{menu.close();root.command(14);}}
                Button {text:"Back";clicked=>{root.confirm-delete=false;}}
            }
            if !root.confirm-delete : VerticalLayout {padding:10px;spacing:6px;
                Text {text:root.selection-label;color:UiTheme.accent;font-size:10px;font-weight:700;overflow:elide;}
                if root.axis-task : HorizontalLayout {
                    CadToolButton {icon:@image-url("icons/edge.svg");label:"Use this edge as revolution axis";enabled:root.has-edge;clicked=>{menu.close();root.command(79);}}
                    Text {text:"Assign revolution axis";color:UiTheme.text-secondary;font-size:11px;vertical-alignment:center;}
                }
                if !root.axis-task : VerticalLayout {spacing:5px;
                    Text {text:"EDIT & SKETCH";color:UiTheme.text-muted;font-size:9px;}
                    HorizontalLayout {spacing:5px;
                        CadToolButton {icon:@image-url("icons/check.svg");label:"Selection properties";clicked=>{menu.close();root.command(71);}}
                        if root.has-body : CadToolButton {icon:@image-url("icons/sketch.svg");label:"Edit saved feature";enabled:!root.locked && root.can-edit-feature;clicked=>{menu.close();root.command(64);}}
                        if root.has-body : CadToolButton {icon:@image-url("icons/rectangle.svg");label:"Edit source sketch";enabled:!root.locked && root.has-source-sketch;clicked=>{menu.close();root.command(65);}}
                        if root.planar-face : CadToolButton {icon:@image-url("icons/new-sketch.svg");label:"Draw a new sketch on this face";enabled:!root.locked;clicked=>{menu.close();root.activate(213);}}
                        if root.has-sketch : CadToolButton {icon:@image-url("icons/sketch.svg");label:"Edit sketch in viewport";enabled:!root.locked;clicked=>{menu.close();root.command(39);}}
                        if root.has-sketch : CadToolButton {icon:@image-url("icons/measure.svg");label:"Sketch dimensions and constraints";enabled:!root.locked;clicked=>{menu.close();root.command(28);}}
                        Rectangle {horizontal-stretch:1;}
                    }
                    if root.has-sketch : HorizontalLayout {spacing:5px;
                        CadToolButton {icon:@image-url("icons/pad.svg");label:"Pad this profile";enabled:!root.locked;clicked=>{menu.close();root.activate(1);}}
                        CadToolButton {icon:@image-url("icons/revolve.svg");label:"Revolve this profile";enabled:!root.locked;clicked=>{menu.close();root.activate(2);}}
                        CadToolButton {icon:@image-url("icons/cut.svg");label:"Pocket this attached sketch";enabled:!root.locked;clicked=>{menu.close();root.activate(34);}}
                        CadToolButton {icon:@image-url("icons/revolved-cut.svg");label:"Revolved cut from attached sketch";enabled:!root.locked;clicked=>{menu.close();root.activate(57);}}
                        Rectangle {horizontal-stretch:1;}
                    }
                    if root.has-body : VerticalLayout {spacing:5px;
                        Rectangle {height:1px;background:UiTheme.border;}
                        Text {text:"PRISM FINISHING";color:UiTheme.text-muted;font-size:9px;}
                        HorizontalLayout {spacing:5px;
                            CadToolButton {icon:@image-url("icons/fillet.svg");label:"Fillet selected longitudinal prism edges";enabled:!root.locked;clicked=>{menu.close();root.activate(53);}}
                            CadToolButton {icon:@image-url("icons/chamfer.svg");label:"Chamfer selected longitudinal prism edges";enabled:!root.locked;clicked=>{menu.close();root.activate(54);}}
                            CadToolButton {icon:@image-url("icons/shell.svg");label:"Shell prism · remove selected face";enabled:!root.locked;clicked=>{menu.close();root.activate(55);}}
                            if root.planar-face : CadToolButton {icon:@image-url("icons/hole.svg");label:"Hole on this planar face";enabled:!root.locked;clicked=>{menu.close();root.activate(56);}}
                            CadToolButton {icon:@image-url("icons/check.svg");label:"Check exact solid geometry";enabled:!root.locked;clicked=>{menu.close();root.command(48);}}
                            Rectangle {horizontal-stretch:1;}
                        }
                        Text {text:"TRANSFORM";color:UiTheme.text-muted;font-size:9px;}
                        HorizontalLayout {spacing:5px;
                            CadToolButton {icon:@image-url("icons/move.svg");label:"Move body";enabled:!root.locked;clicked=>{menu.close();root.activate(3);}}
                            CadToolButton {icon:@image-url("icons/rotate.svg");label:"Rotate body";enabled:!root.locked;clicked=>{menu.close();root.activate(4);}}
                            CadToolButton {icon:@image-url("icons/mirror.svg");label:"Mirror copy";enabled:!root.locked;clicked=>{menu.close();root.activate(41);}}
                            CadToolButton {icon:@image-url("icons/scale.svg");label:"Scale body";enabled:!root.locked;clicked=>{menu.close();root.activate(5);}}
                            CadToolButton {icon:@image-url("icons/copy.svg");label:"Create translated copy";enabled:!root.locked;clicked=>{menu.close();root.activate(6);}}
                            Rectangle {horizontal-stretch:1;}
                        }
                    }
                    Rectangle {height:1px;background:UiTheme.border;}
                    HorizontalLayout {spacing:5px;
                        CadToolButton {icon:@image-url("icons/fit.svg");label:"Frame selection";clicked=>{menu.close();root.frame-selection();}}
                        if root.planar-face : CadToolButton {icon:@image-url("icons/face.svg");label:"Look normal to selected planar face";clicked=>{menu.close();root.normal-view();}}
                        Rectangle {horizontal-stretch:1;}
                    }
                    Text {text:"DISPLAY & ORGANIZE";color:UiTheme.text-muted;font-size:9px;}
                    HorizontalLayout {spacing:5px;
                        if root.has-body : CadToolButton {icon:@image-url("icons/isolate.svg");label:"Isolate selected bodies · Undo restores visibility";enabled:!root.locked;clicked=>{menu.close();root.command(66);}}
                        if root.has-body : CadToolButton {icon:@image-url("icons/eye.svg");label:"Hide selected bodies";enabled:!root.locked;clicked=>{menu.close();root.command(67);}}
                        CadToolButton {icon:@image-url("icons/show-all.svg");label:"Show all bodies";enabled:!root.locked;clicked=>{menu.close();root.command(68);}}
                        CadToolButton {icon:@image-url("icons/fit.svg");label:"Fit all";clicked=>{menu.close();root.fit();}}
                        if root.has-body : CadToolButton {icon:@image-url("icons/rename.svg");label:"Rename body";enabled:!root.locked;clicked=>{menu.close();root.activate(13);}}
                        if root.has-body : CadToolButton {icon:@image-url("icons/delete.svg");label:"Delete selected body";enabled:!root.locked;clicked=>{root.confirm-delete=true;}}
                        Rectangle {horizontal-stretch:1;}
                    }
                }
                Rectangle {vertical-stretch:1;}
                Text {text:"Hover an icon for its name";color:UiTheme.text-muted;font-size:9px;}
            }
        }
    }
}
