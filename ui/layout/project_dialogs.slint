import { Button, LineEdit, CheckBox, ComboBox, SpinBox } from "std-widgets.slint";
import { UiTheme, PropertyScroll, WorkspaceSections } from "../components.slint";

// Window-sized modal scrim; dialogs never participate in workspace layout.
component ModalFrame inherits Rectangle {
    in property <length> panel-width:460px;
    in property <length> panel-height:220px;
    background:#000000b8;
    callback close-requested();
    TouchArea {}
    FocusScope {
    width:root.width;height:root.height;
    init=>{self.focus();}
    key-pressed(event)=>{if event.text==Key.Escape {root.close-requested();accept}else{reject}}
    Rectangle {
        width:min(root.width - 24px,root.panel-width);height:min(root.height - 24px,root.panel-height);
        x:(root.width - self.width)/2;y:(root.height - self.height)/2;
        background:UiTheme.toolbar;border-color:UiTheme.border-strong;border-width:1px;border-radius:7px;
        VerticalLayout {padding:20px;spacing:12px;@children}
    }
    }
}
export component RecoveryDialog inherits ModalFrame {
    in property <bool> compact-ui;
    in property <string> workspace;
    callback recover();callback discard();
    panel-width:root.compact-ui ? 360px : 460px;
    Text {text:"Recovery available";color:UiTheme.text-title;font-size:17px;font-weight:700;}
    Text {text:"A newer autosaved workspace was found. Recover it or keep the saved project.";color:UiTheme.text-secondary;font-size:12px;wrap:word-wrap;}
    Text {text:root.workspace;color:UiTheme.text-muted;font-size:10px;overflow:elide;}
    Rectangle {vertical-stretch:1;}
    HorizontalLayout {spacing:8px;Rectangle {horizontal-stretch:1;}Button {text:"Discard recovery";clicked=>{root.discard();}}Button {text:"Recover";clicked=>{root.recover();}}}
}
export component UnsavedChangesDialog inherits ModalFrame {
    close-requested=>{root.cancel();}
    in property <bool> compact-ui;
    callback save();callback discard();callback cancel();
    panel-width:root.compact-ui ? 360px : 460px;
    Text {text:"Save project changes?";color:UiTheme.text-title;font-size:17px;font-weight:700;}
    Text {text:"Save your changes before continuing, discard them, or cancel to keep editing.";color:UiTheme.text-secondary;font-size:12px;wrap:word-wrap;}
    Rectangle {vertical-stretch:1;}
    HorizontalLayout {spacing:8px;Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}Button {text:"Discard";clicked=>{root.discard();}}Button {text:"Save";clicked=>{root.save();}}}
}
export component LegacyImportDialog inherits ModalFrame {
    close-requested=>{root.cancel();}
    in property <bool> compact-ui;
    in property <string> project-name;
    in property <string> recoverable-items;
    in property <string> skipped-items;
    callback cancel();callback import-project();
    panel-width:root.compact-ui ? 360px : 500px;panel-height:300px;
    Text {text:"Import project";color:UiTheme.text-title;font-size:17px;font-weight:700;}
    Text {text:root.project-name;color:UiTheme.text-bright;font-size:13px;}
    Text {text:"Import geometry and settings into an editable workspace.";color:UiTheme.text-secondary;font-size:12px;wrap:word-wrap;}
    Text {text:"Recovered: "+root.recoverable-items;color:UiTheme.text-bright;font-size:11px;wrap:word-wrap;}
    Text {text:"Regenerate: "+root.skipped-items;color:UiTheme.text-muted;font-size:11px;wrap:word-wrap;}
    Rectangle {vertical-stretch:1;}
    HorizontalLayout {spacing:8px;Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}Button {text:"Import";clicked=>{root.import-project();}}}
}

component MaterialField inherits VerticalLayout {
    in property <string> label;in-out property <string> value;
    vertical-stretch:0;spacing:4px;min-width:0px;
    Text {text:root.label;color:UiTheme.text-muted;font-size:11px;wrap:word-wrap;vertical-stretch:0;}
    LineEdit {text <=> root.value;min-height:32px;max-height:32px;min-width:0px;}
}
export component FluidMaterialDialog inherits ModalFrame {
    close-requested=>{root.cancel();}
    in-out property <string> density;in-out property <string> viscosity;
    in property <string> feedback;in property <bool> busy;
    in-out property <int> catalog-index;
    in-out property <string> eval-temperature;in-out property <string> eval-pressure;
    in property <string> source;
    in-out property <bool> enabled-energy;in-out property <bool> buoyancy;
    in-out property <int> wall-treatment;
    in-out property <string> relaxation;in-out property <string> tolerance;
    in-out property <string> initial;in-out property <string> cp;in-out property <string> kappa;in-out property <string> heat-source;in-out property <string> prt;
    in-out property <string> reference;in-out property <string> beta;in-out property <string> gx;in-out property <string> gy;in-out property <string> gz;
    private property <int> section:0;
    callback apply();callback cancel();callback load-catalog();
    panel-width:560px;panel-height:690px;
    Text {text:"Fluid material & thermal physics";color:UiTheme.text-title;font-size:17px;font-weight:700;vertical-stretch:0;}
    WorkspaceSections {model:["Material","Heat transfer","Buoyancy"];current-index <=> root.section;}
    PropertyScroll {section:root.section;
        if root.section==0 : VerticalLayout {spacing:8px;vertical-stretch:0;
            ComboBox {model:["User-defined","Air · idealized tutorial model","Water · liquid correlation","Ethanol · liquid correlation"];current-index <=> root.catalog-index;min-width:0px;max-height:32px;enabled:!root.busy;selected(value)=>{root.load-catalog();}}
            if root.catalog-index>0 : VerticalLayout {spacing:6px;vertical-stretch:0;
                MaterialField {label:"Evaluate at T (K) · restricted 280–330 K";value <=> root.eval-temperature;}
                MaterialField {label:"Reference pressure (Pa) · 95000–105000 Pa";value <=> root.eval-pressure;}
                Button {text:"Load property values";enabled:!root.busy;clicked=>{root.load-catalog();}}
            }
            MaterialField {label:"Density ρ (kg/m³)";value <=> root.density;}
            MaterialField {label:"Kinematic viscosity ν (m²/s)";value <=> root.viscosity;}
            Text {text:root.source;color:UiTheme.text-muted;font-size:10px;wrap:word-wrap;vertical-stretch:0;}
            Text {text:"Catalog properties are evaluated once and remain constant during this solve. Select User-defined before overriding a preset.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
        }
        if root.section==1 : VerticalLayout {spacing:8px;vertical-stretch:0;
            CheckBox {text:"Enable temperature transport";checked <=> root.enabled-energy;toggled=>{if !self.checked {root.buoyancy=false;}}}
            MaterialField {label:"Initial temperature (K)";value <=> root.initial;}
            MaterialField {label:"Specific heat cp (J/kg/K)";value <=> root.cp;}
            MaterialField {label:"Thermal conductivity k (W/m/K)";value <=> root.kappa;}
            MaterialField {label:"Volumetric heat source (W/m³)";value <=> root.heat-source;}
            MaterialField {label:"Turbulent Prandtl number";value <=> root.prt;}
            ComboBox {model:["Wall diffusivity · molecular / resolved","Wall diffusivity · equilibrium constant Prt"];current-index <=> root.wall-treatment;min-height:32px;max-height:32px;min-width:0px;}
            Text {text:"Equilibrium Prt requires the k–epsilon equilibrium momentum wall model. It is not the Jayatilleke thermal log-law model.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
            MaterialField {label:"Temperature equation relaxation (0,1]";value <=> root.relaxation;}
            MaterialField {label:"Relative temperature update tolerance";value <=> root.tolerance;}
            Text {text:"Set temperature/heat-flux conditions for each patch in Setup → Boundaries. Upwind temperature transport; turbulent diffusivity νt/Prt when RANS/LES is active.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
        }
        if root.section==2 : VerticalLayout {spacing:8px;vertical-stretch:0;
            CheckBox {text:"Boussinesq buoyancy";checked <=> root.buoyancy;enabled:root.enabled-energy;}
            MaterialField {label:"Reference temperature (K)";value <=> root.reference;}
            MaterialField {label:"Volumetric expansion β (1/K)";value <=> root.beta;}
            HorizontalLayout {spacing:6px;vertical-stretch:0;
                MaterialField {label:"gx (m/s²)";value <=> root.gx;}
                MaterialField {label:"gy (m/s²)";value <=> root.gy;}
                MaterialField {label:"gz (m/s²)";value <=> root.gz;}
            }
            Text {text:"Adds g[1 − β(T − Tref)], including reference gravity. Pressure remains kinematic gauge pressure. |βΔT| above 0.1 is rejected. This is not a compressible density or phase-change model.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
        }
    }
    Text {text:root.feedback;color:UiTheme.accent;font-size:11px;wrap:word-wrap;vertical-stretch:0;}
    HorizontalLayout {spacing:8px;vertical-stretch:0;Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}Button {text:"Apply";enabled:!root.busy;clicked=>{root.apply();}}}
}

export component SketchPlaneDialog inherits ModalFrame {
    panel-height:260px;
    in property <bool> planar-face;
    callback choose(int);callback cancel();
    close-requested=>{root.cancel();}
    Text {text:"Create sketch";color:UiTheme.text-title;font-size:17px;font-weight:700;}
    Text {text:"Choose a reference plane or a selected planar face.";color:UiTheme.text-secondary;wrap:word-wrap;}
    HorizontalLayout {spacing:8px;
        Button {text:"XY · Top";clicked=>{root.choose(0);}}
        Button {text:"YZ · Right";clicked=>{root.choose(1);}}
        Button {text:"ZX · Front";clicked=>{root.choose(2);}}
    }
    Button {text:"Selected planar face";enabled:root.planar-face;clicked=>{root.choose(3);}}
    Rectangle {vertical-stretch:1;}
    HorizontalLayout {Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}}
}

export component SettingsDialog inherits ModalFrame {
    in-out property <bool> browser:true;
    in-out property <bool> topology:false;
    in-out property <int> panel-size:1;
    callback cancel();
    callback apply(bool,bool,int);
    close-requested=>{root.cancel();}
    panel-width:540px;panel-height:410px;
    Text {text:"Settings";font-size:20px;font-weight:700;color:UiTheme.text-title;}
    Text {text:"Application preferences · saved for this user";font-size:12px;color:UiTheme.text-muted;}
    Rectangle {height:1px;background:UiTheme.border;}
    Text {text:"WORKSPACE LAYOUT";font-size:11px;font-weight:700;color:UiTheme.accent;}
    CheckBox {text:"Show Browser";checked <=> root.browser;}
    CheckBox {text:"Show topology inspector";checked <=> root.topology;}
    HorizontalLayout {spacing:12px;
        Text {text:"Properties panel width";color:UiTheme.text;vertical-alignment:center;}
        ComboBox {model:["Compact","Standard","Wide"];current-index <=> root.panel-size;}
    }
    Text {text:"Applies to CFD workspace panels. Geometry editing keeps its contextual CAD panels. Mesh, fluid and solver settings belong to each project.";font-size:11px;color:UiTheme.text-muted;wrap:word-wrap;}
    Rectangle {vertical-stretch:1;}
    HorizontalLayout {spacing:8px;
        Button {text:"Restore defaults";clicked=>{root.browser=true;root.topology=false;root.panel-size=1;}}
        Rectangle {horizontal-stretch:1;}
        Button {text:"Cancel";clicked=>{root.cancel();}}
        Button {text:"Apply";clicked=>{root.apply(root.browser,root.topology,root.panel-size);}}
    }
}

export struct EquationDraft {
    name:string, pressure:bool, absolute:string, relative:string, iterations:int, preconditioner:int,
}
export component EquationControlsDialog inherits ModalFrame {
    in-out property <[EquationDraft]> rows;
    in property <string> feedback;
    in property <bool> busy;
    callback apply();callback cancel();
    close-requested=>{root.cancel();}
    panel-width:700px;panel-height:690px;
    Text {text:"Equation solver controls";color:UiTheme.text-title;font-size:17px;font-weight:700;vertical-stretch:0;}
    Text {text:"Pressure: CG/PCG or GAMG/GCR · Transport: BiCGSTAB. Stop when L2 residual ≤ max(absTol, relTol × initial residual). These are linear criteria, separate from coupled convergence.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
    PropertyScroll {
        VerticalLayout {spacing:12px;vertical-stretch:0;
            for row in root.rows : VerticalLayout {spacing:4px;vertical-stretch:0;
                Text {text:row.name;color:UiTheme.accent;font-weight:600;vertical-stretch:0;}
                HorizontalLayout {spacing:8px;vertical-stretch:0;
                    MaterialField {label:"Absolute tolerance";value <=> row.absolute;}
                    MaterialField {label:"Relative tolerance";value <=> row.relative;}
                }
                HorizontalLayout {spacing:8px;vertical-stretch:0;
                    VerticalLayout {vertical-stretch:0;
                        Text {text:"Maximum linear iterations";color:UiTheme.text-secondary;vertical-stretch:0;}
                        SpinBox {value <=> row.iterations;minimum:1;maximum:1000000;min-height:32px;max-height:32px;min-width:0px;}
                    }
                    VerticalLayout {vertical-stretch:0;
                        Text {text:"Linear method / preconditioner";color:UiTheme.text-secondary;vertical-stretch:0;}
                        ComboBox {model:row.pressure ? ["None","Jacobi","IC0","GAMG / GCR","Auto · IC0 → Jacobi"] : ["None","Jacobi"];current-index <=> row.preconditioner;min-height:32px;max-height:32px;min-width:0px;}
                    }
                }
            }
        }
    }
    Text {text:root.feedback;color:UiTheme.accent;wrap:word-wrap;vertical-stretch:0;}
    HorizontalLayout {spacing:8px;vertical-stretch:0;Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}Button {text:"Apply";enabled:!root.busy;clicked=>{root.apply();}}}
}
