import { TextEdit, Button, LineEdit, CheckBox, ComboBox, SpinBox, Slider } from "std-widgets.slint";
import { UiTheme, PropertyScroll, WorkspaceSections, InteractiveGeometryPreview } from "../components.slint";

// Window-sized modal scrim; dialogs never participate in workspace layout.
component ModalFrame inherits Rectangle {
    in property <length> panel-width:460px;
    in property <length> panel-height:220px;
    background:#000000b8;
    callback close-requested();
    TouchArea {}
    FocusScope {
    width:root.width;height:root.height;
    init=>{self.focus();}
    key-pressed(event)=>{if event.text==Key.Escape {root.close-requested();accept}else{reject}}
    Rectangle {
        width:min(root.width - 24px,root.panel-width);height:min(root.height - 24px,root.panel-height);
        x:(root.width - self.width)/2;y:(root.height - self.height)/2;
        background:UiTheme.toolbar;border-color:UiTheme.border-strong;border-width:1px;border-radius:7px;
        VerticalLayout {padding:20px;spacing:12px;@children}
    }
    }
}
export component RecoveryDialog inherits ModalFrame {
    in property <bool> compact-ui;
    in property <string> workspace;
    callback recover();callback discard();
    panel-width:root.compact-ui ? 360px : 460px;
    Text {text:"Recovery available";color:UiTheme.text-title;font-size:17px;font-weight:700;}
    Text {text:"A newer autosaved workspace was found. Recover it or keep the saved project.";color:UiTheme.text-secondary;font-size:12px;wrap:word-wrap;}
    Text {text:root.workspace;color:UiTheme.text-muted;font-size:10px;overflow:elide;}
    Rectangle {vertical-stretch:1;}
    HorizontalLayout {spacing:8px;Rectangle {horizontal-stretch:1;}Button {text:"Discard recovery";clicked=>{root.discard();}}Button {text:"Recover";clicked=>{root.recover();}}}
}
export component UnsavedChangesDialog inherits ModalFrame {
    close-requested=>{root.cancel();}
    in property <bool> compact-ui;
    callback save();callback discard();callback cancel();
    panel-width:root.compact-ui ? 360px : 460px;
    Text {text:"Save project changes?";color:UiTheme.text-title;font-size:17px;font-weight:700;}
    Text {text:"Save your changes before continuing, discard them, or cancel to keep editing.";color:UiTheme.text-secondary;font-size:12px;wrap:word-wrap;}
    Rectangle {vertical-stretch:1;}
    HorizontalLayout {spacing:8px;Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}Button {text:"Discard";clicked=>{root.discard();}}Button {text:"Save";clicked=>{root.save();}}}
}


component MaterialField inherits VerticalLayout {
    in property <string> label;in-out property <string> value;in property <bool> editable:true;
    vertical-stretch:0;spacing:4px;min-width:0px;
    Text {text:root.label;color:UiTheme.text-muted;font-size:11px;wrap:word-wrap;vertical-stretch:0;}
    LineEdit {text <=> root.value;enabled:root.editable;min-height:32px;max-height:32px;min-width:0px;}
}
export component FluidMaterialDialog inherits ModalFrame {
    close-requested=>{root.cancel();}
    in-out property <string> density;in-out property <string> viscosity;
    in property <string> feedback;in property <bool> busy;
    in-out property <int> catalog-index;
    in property <[string]> catalog-names;
    in-out property <string> eval-temperature;in-out property <string> eval-pressure;
    in property <string> source;
    in-out property <bool> enabled-energy;in-out property <bool> buoyancy;
    in property <bool> three-d;
    in-out property <string> max-fraction;
    in-out property <int> wall-treatment;
    in-out property <string> relaxation;in-out property <string> tolerance;
    in-out property <string> initial;in-out property <string> cp;in-out property <string> kappa;in-out property <string> heat-source;in-out property <string> prt;
    in-out property <string> reference;in-out property <string> beta;in-out property <string> gx;in-out property <string> gy;in-out property <string> gz;
    private property <int> section:0;
    callback apply();callback cancel();callback load-catalog();callback import-catalog();callback backup-catalog();
    panel-width:560px;panel-height:690px;
    Text {text:"Fluid material & thermal physics";color:UiTheme.text-title;font-size:17px;font-weight:700;vertical-stretch:0;}
    WorkspaceSections {model:["Material","Heat transfer","Buoyancy"];current-index <=> root.section;}
    PropertyScroll {section:root.section;
        if root.section==0 : VerticalLayout {spacing:8px;vertical-stretch:0;
            ComboBox {model:root.catalog-names;current-index <=> root.catalog-index;min-width:0px;max-height:32px;enabled:!root.busy;selected(value)=>{root.load-catalog();}}
            HorizontalLayout {spacing:6px;vertical-stretch:0;
                Button {text:"Import JSON library…";enabled:!root.busy;clicked=>{root.import-catalog();}}
                Button {text:"Back up catalogue…";enabled:!root.busy;clicked=>{root.backup-catalog();}}
            }
            if root.catalog-index>0 : VerticalLayout {spacing:6px;vertical-stretch:0;
                MaterialField {label:"Evaluate at T (K) · within model validity";value <=> root.eval-temperature;}
                MaterialField {label:"Reference pressure (Pa) · within model validity";value <=> root.eval-pressure;}
                Button {text:"Load property values";enabled:!root.busy;clicked=>{root.load-catalog();}}
            }
            MaterialField {label:"Density ρ (kg/m³)";value <=> root.density;}
            MaterialField {label:"Kinematic viscosity ν (m²/s)";value <=> root.viscosity;}
            Text {text:root.source;color:UiTheme.text-muted;font-size:10px;wrap:word-wrap;vertical-stretch:0;}
            Text {text:"Catalog properties are evaluated once and remain constant during this solve. Select User-defined before overriding a preset.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
        }
        if root.section==1 : VerticalLayout {spacing:8px;vertical-stretch:0;
            CheckBox {text:"Enable temperature transport";checked <=> root.enabled-energy;toggled=>{if !self.checked {root.buoyancy=false;}}}
            MaterialField {label:"Initial temperature (K)";value <=> root.initial;}
            MaterialField {label:"Specific heat cp (J/kg/K)";value <=> root.cp;}
            MaterialField {label:"Thermal conductivity k (W/m/K)";value <=> root.kappa;}
            MaterialField {label:"Volumetric heat source (W/m³)";value <=> root.heat-source;}
            MaterialField {label:"Turbulent Prandtl number";value <=> root.prt;}
            ComboBox {model:["Wall diffusivity · molecular / resolved","Wall diffusivity · equilibrium constant Prt"];current-index <=> root.wall-treatment;min-height:32px;max-height:32px;min-width:0px;}
            Text {text:"Equilibrium Prt requires the k–epsilon equilibrium momentum wall model. It is not the Jayatilleke thermal log-law model.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
            MaterialField {label:"Temperature equation relaxation (0,1]";value <=> root.relaxation;}
            MaterialField {label:"Relative temperature update tolerance";value <=> root.tolerance;}
            Text {text:"Set temperature/heat-flux conditions for each patch in Setup → Boundaries. Upwind temperature transport; turbulent diffusivity νt/Prt when RANS/LES is active.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
        }
        if root.section==2 : VerticalLayout {spacing:8px;vertical-stretch:0;
            CheckBox {text:"Boussinesq buoyancy";checked <=> root.buoyancy;enabled:root.enabled-energy;}
            Text {text:"Gravity uses model coordinates, independent of the camera. Set the direction in which a freely falling object accelerates.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
            ComboBox {
                model:root.three-d ? ["Set gravity direction…","Down −Y","Down −X","Down −Z","Down +Y","Down +X","Down +Z","Zero gravity"] : ["Set gravity direction…","Down −Y","Down −X","Down +Y","Down +X","Zero gravity"];
                current-index:0;enabled:!root.busy;min-width:0px;max-height:32px;
                selected(index)=>{
                    if index>0 {
                        root.gx="0";root.gy="0";root.gz="0";
                        if index==1 {root.gy="-9.81";}
                        else if index==2 {root.gx="-9.81";}
                        else if root.three-d && index==3 {root.gz="-9.81";}
                        else if (root.three-d && index==4) || (!root.three-d && index==3) {root.gy="9.81";}
                        else if (root.three-d && index==5) || (!root.three-d && index==4) {root.gx="9.81";}
                        else if root.three-d && index==6 {root.gz="9.81";}
                        self.current-index=0;
                    }
                }
            }
            MaterialField {label:"Reference temperature (K)";value <=> root.reference;}
            MaterialField {label:"Volumetric expansion β (1/K)";value <=> root.beta;}
            HorizontalLayout {spacing:6px;vertical-stretch:0;
                MaterialField {label:"gx (m/s²)";value <=> root.gx;}
                MaterialField {label:"gy (m/s²)";value <=> root.gy;}
                MaterialField {label:"gz (m/s²)";value <=> root.gz;}
            }
            MaterialField {label:"Maximum |β(T − Tref)| (0–0.2; default 0.1)";value <=> root.max-fraction;}
            Text {text:root.three-d ? "Hotter fluid (β>0) has a relative buoyancy force opposite g; colder fluid follows g. Jet inlet momentum can initially dominate the trajectory." : "2D is the XY plane: gz must be zero. Hotter fluid (β>0) rises opposite g; changing the camera does not change gravity.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
            Text {text:"The solver uses g[1 − β(T − Tref)], including reference gravity balanced by hydrostatic pressure. Pressure is p/ρref, not p_rgh. The density-variation limit is checked for initial, prescribed and solved temperatures. No variable-density or phase-change model.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}

        }
    }
    Text {text:root.feedback;color:UiTheme.accent;font-size:11px;wrap:word-wrap;vertical-stretch:0;}
    HorizontalLayout {spacing:8px;vertical-stretch:0;Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}Button {text:"Apply";enabled:!root.busy;clicked=>{root.apply();}}}
}

export component SketchPlaneDialog inherits ModalFrame {
    panel-height:260px;
    in property <bool> planar-face;
    callback choose(int);callback cancel();
    close-requested=>{root.cancel();}
    Text {text:"Create sketch";color:UiTheme.text-title;font-size:17px;font-weight:700;}
    Text {text:"Choose a reference plane or a selected planar face.";color:UiTheme.text-secondary;wrap:word-wrap;}
    HorizontalLayout {spacing:8px;
        Button {text:"XY · Top";clicked=>{root.choose(0);}}
        Button {text:"YZ · Right";clicked=>{root.choose(1);}}
        Button {text:"ZX · Front";clicked=>{root.choose(2);}}
    }
    Button {text:"Selected planar face";enabled:root.planar-face;clicked=>{root.choose(3);}}
    Rectangle {vertical-stretch:1;}
    HorizontalLayout {Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}}
}

export component SettingsDialog inherits ModalFrame {
    in-out property <string> gmsh-path;
    callback browse-gmsh();
    callback compute();
    in-out property <bool> browser:true;
    in-out property <bool> topology:false;
    in-out property <int> panel-size:1;
    callback cancel();
    callback apply(bool,bool,int,string);
    close-requested=>{root.cancel();}
    panel-width:540px;panel-height:560px;
    Text {text:"Settings";font-size:20px;font-weight:700;color:UiTheme.text-title;}
    Text {text:"Application preferences · saved for this user";font-size:12px;color:UiTheme.text-muted;}
    Rectangle {height:1px;background:UiTheme.border;}
    Text {text:"GMSH EXECUTABLE";font-size:11px;font-weight:700;color:UiTheme.accent;}
    HorizontalLayout {spacing:6px; LineEdit {text <=> root.gmsh-path;placeholder-text:"Automatic · gmsh on PATH";min-width:0px;} Button {text:"Browse…";clicked=>{root.browse-gmsh();}} }
    Text {text:"Select gmsh.exe on Windows or the gmsh executable on Linux/macOS. Leave empty for automatic discovery.";font-size:11px;color:UiTheme.text-muted;wrap:word-wrap;}
    Button {text:"Compute & rendering…";clicked=>{root.compute();}}
    Text {text:"WORKSPACE LAYOUT";font-size:11px;font-weight:700;color:UiTheme.accent;}
    CheckBox {text:"Show Browser";checked <=> root.browser;}
    CheckBox {text:"Show topology inspector";checked <=> root.topology;}
    HorizontalLayout {spacing:12px;
        Text {text:"Properties panel width";color:UiTheme.text;vertical-alignment:center;}
        ComboBox {model:["Compact","Standard","Wide"];current-index <=> root.panel-size;}
    }
    Text {text:"Applies to CFD workspace panels. Geometry editing keeps its contextual CAD panels. Mesh, fluid and solver settings belong to each project.";font-size:11px;color:UiTheme.text-muted;wrap:word-wrap;}
    Rectangle {vertical-stretch:1;}
    HorizontalLayout {spacing:8px;
        Button {text:"Restore defaults";clicked=>{root.browser=true;root.topology=false;root.panel-size=1;root.gmsh-path="";}}
        Rectangle {horizontal-stretch:1;}
        Button {text:"Cancel";clicked=>{root.cancel();}}
        Button {text:"Apply";clicked=>{root.apply(root.browser,root.topology,root.panel-size,root.gmsh-path);}}
    }
}

export struct EquationDraft {
    name:string, pressure:bool, absolute:string, relative:string, iterations:int, preconditioner:int,
}
export component EquationControlsDialog inherits ModalFrame {
    in-out property <[EquationDraft]> rows;
    in property <string> feedback;
    in property <bool> busy;
    callback apply();callback cancel();
    close-requested=>{root.cancel();}
    panel-width:700px;panel-height:690px;
    Text {text:"Equation solver controls";color:UiTheme.text-title;font-size:17px;font-weight:700;vertical-stretch:0;}
    Text {text:"Pressure: CG/PCG or GAMG/GCR · Transport: BiCGSTAB. Stop when L2 residual ≤ max(absTol, relTol × initial residual). These are linear criteria, separate from coupled convergence.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
    PropertyScroll {
        VerticalLayout {spacing:12px;vertical-stretch:0;
            for row in root.rows : VerticalLayout {spacing:4px;vertical-stretch:0;
                Text {text:row.name;color:UiTheme.accent;font-weight:600;vertical-stretch:0;}
                HorizontalLayout {spacing:8px;vertical-stretch:0;
                    MaterialField {label:"Absolute tolerance";value <=> row.absolute;}
                    MaterialField {label:"Relative tolerance";value <=> row.relative;}
                }
                HorizontalLayout {spacing:8px;vertical-stretch:0;
                    VerticalLayout {vertical-stretch:0;
                        Text {text:"Maximum linear iterations";color:UiTheme.text-secondary;vertical-stretch:0;}
                        SpinBox {value <=> row.iterations;minimum:1;maximum:1000000;min-height:32px;max-height:32px;min-width:0px;}
                    }
                    VerticalLayout {vertical-stretch:0;
                        Text {text:"Linear method / preconditioner";color:UiTheme.text-secondary;vertical-stretch:0;}
                        ComboBox {model:row.pressure ? ["None","Jacobi","IC0","GAMG / GCR","Auto · IC0 → Jacobi"] : ["None","Jacobi"];current-index <=> row.preconditioner;min-height:32px;max-height:32px;min-width:0px;}
                    }
                }
            }
        }
    }
    Text {text:root.feedback;color:UiTheme.accent;wrap:word-wrap;vertical-stretch:0;}
    HorizontalLayout {spacing:8px;vertical-stretch:0;Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}Button {text:"Apply";enabled:!root.busy;clicked=>{root.apply();}}}
}

export struct VolumeModelDraft {
    rotation_enabled:bool, resistance_enabled:bool, bounded:bool,
    omega-x:string,
    omega-y:string,
    omega-z:string,
    origin-x:string,
    origin-y:string,
    origin-z:string,
    minimum-x:string,
    minimum-y:string,
    minimum-z:string,
    maximum-x:string,
    maximum-y:string,
    maximum-z:string,
    darcy:string,
    forchheimer:string,
}
export component VolumeModelsDialog inherits ModalFrame {
    in-out property <VolumeModelDraft> draft;
    in property <string> feedback;
    in property <bool> busy;
    callback apply();callback cancel();
    close-requested=>{root.cancel();}
    panel-width:650px;panel-height:660px;
    Text {text:"Volume momentum models · experimental";color:UiTheme.text-title;font-size:17px;font-weight:700;vertical-stretch:0;}
    PropertyScroll {
        VerticalLayout {spacing:10px;vertical-stretch:0;
            CheckBox {text:"Global rotating frame · relative velocity";checked <=> root.draft.rotation-enabled;enabled:!root.busy;}
            if root.draft.rotation-enabled : VerticalLayout {spacing:6px;vertical-stretch:0;
                Text {text:"3D only. All inlet, wall, initial and displayed velocities are relative to this frame. No stationary/rotating zone interface or moving mesh.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
                Text {text:"Angular velocity vector · rad/s";color:UiTheme.text-secondary;vertical-stretch:0;}
                HorizontalLayout {spacing:6px;vertical-stretch:0;
                    MaterialField {label:"X";value <=> root.draft.omega-x;}
                    MaterialField {label:"Y";value <=> root.draft.omega-y;}
                    MaterialField {label:"Z";value <=> root.draft.omega-z;}
                }
                Text {text:"Rotation origin · m";color:UiTheme.text-secondary;vertical-stretch:0;}
                HorizontalLayout {spacing:6px;vertical-stretch:0;
                    MaterialField {label:"X";value <=> root.draft.origin-x;}
                    MaterialField {label:"Y";value <=> root.draft.origin-y;}
                    MaterialField {label:"Z";value <=> root.draft.origin-z;}
                }
            }
            CheckBox {text:"Isotropic Darcy–Forchheimer momentum resistance";checked <=> root.draft.resistance-enabled;enabled:!root.busy;}
            if root.draft.resistance-enabled : VerticalLayout {spacing:6px;vertical-stretch:0;
                Text {text:"Sink: −(ν D + ½ F |U|) U. No porosity storage or porous heat-transfer model.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
                HorizontalLayout {spacing:6px;vertical-stretch:0;
                    MaterialField {label:"Darcy D · 1/m²";value <=> root.draft.darcy;}
                    MaterialField {label:"Forchheimer F · 1/m";value <=> root.draft.forchheimer;}
                }
                CheckBox {text:"Restrict to a box of cell centres";checked <=> root.draft.bounded;enabled:!root.busy;}
                if root.draft.bounded : VerticalLayout {spacing:6px;vertical-stretch:0;
                Text {text:"Box minimum · m";color:UiTheme.text-secondary;vertical-stretch:0;}
                HorizontalLayout {spacing:6px;vertical-stretch:0;
                    MaterialField {label:"X";value <=> root.draft.minimum-x;}
                    MaterialField {label:"Y";value <=> root.draft.minimum-y;}
                    MaterialField {label:"Z";value <=> root.draft.minimum-z;}
                }
                Text {text:"Box maximum · m";color:UiTheme.text-secondary;vertical-stretch:0;}
                HorizontalLayout {spacing:6px;vertical-stretch:0;
                    MaterialField {label:"X";value <=> root.draft.maximum-x;}
                    MaterialField {label:"Y";value <=> root.draft.maximum-y;}
                    MaterialField {label:"Z";value <=> root.draft.maximum-z;}
                }
                }
            }
        }
    }
    Text {text:root.feedback;color:UiTheme.accent;wrap:word-wrap;vertical-stretch:0;}
    HorizontalLayout {spacing:8px;vertical-stretch:0;Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}Button {text:"Apply";enabled:!root.busy;clicked=>{root.apply();}}}
}

export component CyclicPairsDialog inherits ModalFrame {
    in property <[string]> patches;
    in property <[string]> pairs;
    in-out property <int> first-index:0;
    in-out property <int> second-index:1;
    in-out property <int> pair-index:-1;
    in-out property <string> tx:"0";
    in-out property <string> ty:"0";
    in-out property <string> tz:"0";
    in-out property <string> tolerance:"1e-8";
    in property <string> feedback;
    in property <bool> busy;
    callback add();callback remove();callback apply();callback cancel();
    close-requested=>{root.cancel();}
    panel-width:620px;panel-height:550px;
    Text {text:"Conformal translational Cyclic · experimental";color:UiTheme.text-title;font-size:17px;font-weight:700;vertical-stretch:0;}
    PropertyScroll {
        VerticalLayout {spacing:10px;vertical-stretch:0;
            Text {text:"Laminar, isothermal, first-order upwind; inertial frame. Matching faces are required. No AMI or rotational transform.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
            Text {text:"First patch → second patch";color:UiTheme.text;vertical-stretch:0;}
            ComboBox {model:root.patches;current-index <=> root.first-index;min-width:0px;max-height:32px;}
            ComboBox {model:root.patches;current-index <=> root.second-index;min-width:0px;max-height:32px;}
            Text {text:"Translation from first to second · metres";color:UiTheme.text-secondary;vertical-stretch:0;}
            HorizontalLayout {spacing:6px;vertical-stretch:0;
                MaterialField {label:"X";value <=> root.tx;}
                MaterialField {label:"Y";value <=> root.ty;}
                MaterialField {label:"Z";value <=> root.tz;}
            }
            MaterialField {label:"Absolute matching tolerance · m";value <=> root.tolerance;}
            Button {text:"Add pair to draft";enabled:!root.busy;clicked=>{root.add();}}
            ComboBox {model:root.pairs;current-index <=> root.pair-index;min-width:0px;max-height:32px;}
            Button {text:"Remove selected draft pair";enabled:!root.busy && root.pair-index>=0;clicked=>{root.remove();}}
            Text {text:"Apply replaces physical conditions on paired patches. Removing a pair requires assigning physical conditions again. Mesh generation is unchanged; opposite mesh partitions must already match.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
        }
    }
    Text {text:root.feedback;color:UiTheme.accent;wrap:word-wrap;vertical-stretch:0;}
    HorizontalLayout {spacing:8px;vertical-stretch:0;Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}Button {text:"Apply pairs";enabled:!root.busy;clicked=>{root.apply();}}}
}

export component ProjectNameDialog inherits ModalFrame {
    in-out property <string> name;
    in property <string> feedback;
    callback cancel();callback apply();
    panel-width:460px;panel-height:240px;close-requested=>{root.cancel();}
    Text {text:"Project name";font-size:20px;font-weight:700;color:UiTheme.text-title;}
    LineEdit {text <=> root.name;placeholder-text:"Analysis name";min-width:0px;accepted=>{root.apply();}}
    Text {text:"Changes the analysis title, not its workspace folder.";color:UiTheme.text-muted;font-size:11px;wrap:word-wrap;}
    Text {text:root.feedback;color:UiTheme.accent;font-size:11px;wrap:word-wrap;}
    Rectangle {vertical-stretch:1;}
    HorizontalLayout {Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}Button {text:"Rename";clicked=>{root.apply();}}}
}

export component ComputeDialog inherits ModalFrame {
    in-out property <int> backend;
    in-out property <int> threads;
    in-out property <int> gpu-index;
    in-out property <bool> fallback;
    in-out property <int> parallel-rows;
    in-out property <int> gpu-rows;
    in-out property <int> preconditioner;
    in-out property <int> restart;
    in-out property <int> inner;
    in-out property <int> sweeps;
    in-out property <int> timeout;
    in-out property <int> basis-mb;
    in-out property <int> memory-percent;
    in-out property <bool> cpu-display;
    in-out property <int> display-index;
    in-out property <int> fps;
    in property <[string]> adapters;
    in property <string> information;
    in property <string> feedback;
    callback apply();callback cancel();
    close-requested=>{root.cancel();}
    panel-width:650px;panel-height:760px;
    Text {text:"Compute & rendering";font-size:20px;font-weight:700;color:UiTheme.text-title;vertical-stretch:0;}
    PropertyScroll {
        VerticalLayout {spacing:10px;vertical-stretch:0;
            Text {text:"SOLVER · SAVED WITH PROJECT";color:UiTheme.accent;font-weight:700;vertical-stretch:0;}
            ComboBox {model:["CPU · serial · f64","CPU · parallel · f64","GPU · mixed precision · experimental"];current-index <=> root.backend;min-height:32px;max-height:32px;}
            Text {text:"CPU workers (0 = automatic)";color:UiTheme.text-secondary;vertical-stretch:0;}
            SpinBox {value <=> root.threads;minimum:0;maximum:1024;min-height:32px;max-height:32px;}
            Text {text:"Compute GPU";color:UiTheme.text-secondary;vertical-stretch:0;}
            ComboBox {model:root.adapters;current-index <=> root.gpu-index;min-height:32px;max-height:32px;}
            CheckBox {text:"Allow CPU fallback for small systems / GPU failures";checked <=> root.fallback;}
            Text {text:"CPU f64 FGMRES verifies the original residual. GPU AMG preconditions eligible pressure systems; GPU Krylov preconditions transport. Assembly stays on CPU. CPU fallback uses configured equation methods.";color:UiTheme.text-muted;wrap:word-wrap;vertical-stretch:0;}
            Text {text:"GPU preconditioner";color:UiTheme.text-secondary;vertical-stretch:0;}
            ComboBox {model:["Auto · AMG symmetric / Krylov transport","Jacobi / Krylov for all equations"];current-index <=> root.preconditioner;min-height:32px;max-height:32px;}
            HorizontalLayout {spacing:8px;
                VerticalLayout {vertical-stretch:0;Text {text:"FGMRES restart length";color:UiTheme.text-secondary;wrap:word-wrap;}SpinBox {value <=> root.restart;minimum:2;maximum:64;min-height:32px;max-height:32px;}}
                VerticalLayout {vertical-stretch:0;Text {text:"GPU inner iterations";color:UiTheme.text-secondary;wrap:word-wrap;}SpinBox {value <=> root.inner;minimum:1;maximum:64;min-height:32px;max-height:32px;}}
            }
            HorizontalLayout {spacing:8px;
                VerticalLayout {vertical-stretch:0;Text {text:"AMG pre/post sweeps";color:UiTheme.text-secondary;wrap:word-wrap;}SpinBox {value <=> root.sweeps;minimum:1;maximum:8;min-height:32px;max-height:32px;}}
                VerticalLayout {vertical-stretch:0;Text {text:"Device timeout (ms)";color:UiTheme.text-secondary;wrap:word-wrap;}SpinBox {value <=> root.timeout;minimum:100;maximum:60000;min-height:32px;max-height:32px;}}
            }
            HorizontalLayout {spacing:8px;
                VerticalLayout {vertical-stretch:0;Text {text:"CPU parallel minimum rows";color:UiTheme.text-secondary;wrap:word-wrap;}SpinBox {value <=> root.parallel-rows;minimum:1;maximum:10000000;min-height:32px;max-height:32px;}}
                VerticalLayout {vertical-stretch:0;Text {text:"CPU crossover rows (fallback only)";color:UiTheme.text-secondary;wrap:word-wrap;}SpinBox {value <=> root.gpu-rows;minimum:1;maximum:10000000;min-height:32px;max-height:32px;}}
            }
            Text {text:"CPU FGMRES basis budget (MiB)";color:UiTheme.text-secondary;vertical-stretch:0;}
            SpinBox {value <=> root.basis-mb;minimum:16;maximum:16384;min-height:32px;max-height:32px;}
            Text {text:"GPU resource budget (% of adapter buffer limit; not free VRAM)";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
            SpinBox {value <=> root.memory-percent;minimum:1;maximum:100;min-height:32px;max-height:32px;}
            Rectangle {height:1px;background:UiTheme.border;}
            Text {text:"DISPLAY · SAVED FOR THIS USER";color:UiTheme.accent;font-weight:700;vertical-stretch:0;}
            CheckBox {text:"CPU rendering for CFD views";checked <=> root.cpu-display;}
            ComboBox {model:root.adapters;current-index <=> root.display-index;min-height:32px;max-height:32px;}
            Text {text:"Maximum CAD frame rate";color:UiTheme.text-secondary;vertical-stretch:0;}
            SpinBox {value <=> root.fps;minimum:5;maximum:120;min-height:32px;max-height:32px;}
            Text {text:"Display selection is independent of the solver. Restart to switch the CAD adapter; CFD views switch immediately. CAD requires a graphics adapter. Frames still pass through the Slint image bridge.";color:UiTheme.text-muted;wrap:word-wrap;vertical-stretch:0;}
            Text {text:root.information;color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
        }
    }
    Text {text:root.feedback;color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
    HorizontalLayout {Rectangle {horizontal-stretch:1;}Button {text:"Cancel";clicked=>{root.cancel();}}Button {text:"Apply";clicked=>{root.apply();}}}
}

export struct TransportDraft {
    coordinates:int, origin:string, dt:string, steps:int, every:int,
    alpha:string, temperature:string,
    rho1:string, cp1:string, k1:string, rho2:string, cp2:string, k2:string,
    courant:string, subcycles:int,
}
export struct TransportBoundaryDraft {name:string, kind:int, value:string, ambient:string, incoming:string}
export struct TransportRegionDraft {solid:bool, xmin:string,ymin:string,zmin:string,xmax:string,ymax:string,zmax:string,alpha:string,temperature:string,rho:string,cp:string,k:string,source:string}
export struct TransportContactDraft {face:string,resistance:string}
export component TransportDialog inherits ModalFrame {
    in-out property <TransportDraft> draft;
    in-out property <[TransportBoundaryDraft]> boundaries;
    in-out property <[TransportRegionDraft]> regions;
    in-out property <[TransportContactDraft]> contacts;
    in property <bool> running;in property <bool> paused;in property <bool> three-d;in property <bool> ready;
    in property <string> status;in property <string> progress;in property <string> output;
    in property <bool> has-restart;
    in property <image> preview;in property <image> orientation;in-out property <int> view-axis:3;
    in-out property <int> field:0;in-out property <bool> edges:false;
    in-out property <int> cut:0;in-out property <float> cut-position:50;in-out property <bool> cut-reverse:false;
    in-out property <int> frame:0;in property <int> frames:0;
    in-out property <bool> playing:false;
    in-out property <string> range-min;in-out property <string> range-max;
    private property <int> section:0;
    callback close();callback apply();callback start();callback stop();callback pause();callback resume();callback initialize();
    callback import-settings();callback export-settings();callback use-flow();callback load-restart();callback open-archive();
    callback add-region();callback remove-region(int);callback add-contact();callback remove-contact(int);
    callback refresh-view();callback show-frame(int);callback orbit(float,float,float,float);callback zoom(float);callback home();callback pick-orientation(float,float);callback orbit-end();callback pan(float,float,float,float);callback axis(int);
    panel-width:1000px;panel-height:760px;
    close-requested=>{root.close();}
    Text {text:"Phase & heat transport";color:UiTheme.text-title;font-size:17px;font-weight:700;vertical-stretch:0;}
    WorkspaceSections {model:["Domain","Fluids","Regions","Boundaries","Contacts","Run","Results"];current-index <=> root.section;}
    Text {text:"Prescribed-flow scalar transport · phase fraction and solid/fluid energy. No variable-density momentum, capillary force or axisymmetric momentum coupling.";color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
    if root.section!=6 : PropertyScroll {section:root.section;
        VerticalLayout {spacing:8px;vertical-stretch:0;
            if root.section==0 : VerticalLayout {spacing:8px;vertical-stretch:0;
                Text {text:"Coordinate system";color:UiTheme.text-secondary;}
                ComboBox {model:["Cartesian","Axisymmetric · around X (radius Y)","Axisymmetric · around Y (radius X)"];current-index <=> root.draft.coordinates;enabled:!root.running && root.ready;max-height:32px;}
                if root.draft.coordinates!=0 : MaterialField {editable:!root.running;label:"Radial origin (m); entire meridian must have nonnegative radius";value <=> root.draft.origin;}
                Text {text:root.three-d ? "A 3D mesh supports Cartesian transport. Axisymmetric scalar transport requires a 2D XY meridian." : "2D Cartesian inventories are per unit depth. Axisymmetric inventories use the complete 2π revolution.";color:UiTheme.text-muted;wrap:word-wrap;}
                HorizontalLayout {spacing:8px;Button {text:"Load settings…";enabled:!root.running && root.ready;clicked=>{root.import-settings();}}Button {text:"Save settings…";enabled:!root.running && root.ready;clicked=>{root.export-settings();}}}
                Button {text:"Use completed CFD face flux";enabled:!root.running && root.ready;clicked=>{root.use-flow();}}
                Text {text:"Without a supplied flux, the run is quiescent conduction. A copied CFD flux stays fixed throughout transport; buoyancy and phase density do not change it.";color:UiTheme.text-muted;wrap:word-wrap;}
            }
            if root.section==1 : VerticalLayout {spacing:8px;vertical-stretch:0;
                Text {text:"Phase 1 · SI properties";color:UiTheme.accent;}
                MaterialField {editable:!root.running;label:"Density (kg/m³)";value <=> root.draft.rho1;}
                MaterialField {editable:!root.running;label:"Specific heat (J/kg/K)";value <=> root.draft.cp1;}
                MaterialField {editable:!root.running;label:"Conductivity (W/m/K)";value <=> root.draft.k1;}
                Text {text:"Phase 2 · SI properties";color:UiTheme.accent;}
                MaterialField {editable:!root.running;label:"Density (kg/m³)";value <=> root.draft.rho2;}
                MaterialField {editable:!root.running;label:"Specific heat (J/kg/K)";value <=> root.draft.cp2;}
                MaterialField {editable:!root.running;label:"Conductivity (W/m/K)";value <=> root.draft.k2;}
                Text {text:"Catalogue selections loaded from settings are evaluated and frozen before editing these explicit values.";color:UiTheme.text-muted;wrap:word-wrap;}
            }
            if root.section==2 : VerticalLayout {spacing:8px;vertical-stretch:0;
                MaterialField {editable:!root.running;label:"Default phase-1 fraction (0–1)";value <=> root.draft.alpha;}
                MaterialField {editable:!root.running;label:"Default temperature (K)";value <=> root.draft.temperature;}
                Button {text:"Add box region";enabled:!root.running && root.ready;clicked=>{root.add-region();}}
                Text {text:"Regions select existing cells by their centres; they do not cut the mesh. Material interfaces must align with mesh faces. Overlapping boxes are rejected.";color:UiTheme.text-muted;wrap:word-wrap;}
                for row[index] in root.regions : VerticalLayout {spacing:5px;vertical-stretch:0;
                    HorizontalLayout {CheckBox {text:"Solid region " + (index+1);checked <=> row.solid;enabled:!root.running && root.ready;}Button {text:"Remove";enabled:!root.running && root.ready;clicked=>{root.remove-region(index);}}}
                    HorizontalLayout {MaterialField {editable:!root.running;label:"Min X (m)";value <=> row.xmin;}MaterialField {editable:!root.running;label:"Min Y (m)";value <=> row.ymin;}MaterialField {editable:!root.running;label:"Min Z (m)";value <=> row.zmin;}}
                    HorizontalLayout {MaterialField {editable:!root.running;label:"Max X (m)";value <=> row.xmax;}MaterialField {editable:!root.running;label:"Max Y (m)";value <=> row.ymax;}MaterialField {editable:!root.running;label:"Max Z (m)";value <=> row.zmax;}}
                    HorizontalLayout {MaterialField {editable:!root.running;label:"Initial T (K)";value <=> row.temperature;}MaterialField {editable:!root.running;label:"Phase-1 fraction";value <=> row.alpha;}MaterialField {editable:!root.running;label:"Heat source (W/m³)";value <=> row.source;}}
                    if row.solid : HorizontalLayout {MaterialField {editable:!root.running;label:"Solid density";value <=> row.rho;}MaterialField {editable:!root.running;label:"Solid Cp";value <=> row.cp;}MaterialField {editable:!root.running;label:"Solid conductivity";value <=> row.k;}}
                }
            }
            if root.section==3 : VerticalLayout {spacing:8px;vertical-stretch:0;
                for row[index] in root.boundaries : VerticalLayout {spacing:5px;vertical-stretch:0;
                    Text {text:row.name;color:UiTheme.accent;}
                    ComboBox {model:["Adiabatic","Fixed temperature","Inlet / outlet temperature","Inward heat flux","External convection","Enclosure radiation"];current-index <=> row.kind;enabled:!root.running && root.ready;max-height:32px;}
                    if row.kind!=0 : MaterialField {editable:!root.running;label:row.kind==3 ? "Inward heat flux (W/m²)" : row.kind==4 ? "Film coefficient (W/m²/K)" : row.kind==5 ? "Emissivity (0–1)" : "Temperature (K)";value <=> row.value;}
                    if row.kind>=4 : MaterialField {editable:!root.running;label:"Ambient temperature (K)";value <=> row.ambient;}
                    MaterialField {editable:!root.running;label:"Incoming phase-1 fraction (for inflow/backflow)";value <=> row.incoming;}
                }
            }
            if root.section==4 : VerticalLayout {spacing:8px;vertical-stretch:0;
                Button {text:"Add thermal contact";enabled:!root.running && root.ready;clicked=>{root.add-contact();}}
                Text {text:"Advanced: assign a conformal internal mesh face. Resistance is area-specific, m² K/W; zero means perfect thermal contact. A boundary face is not an internal solid/fluid interface.";color:UiTheme.text-muted;wrap:word-wrap;}
                for row[index] in root.contacts : HorizontalLayout {MaterialField {editable:!root.running;label:"Internal face index";value <=> row.face;}MaterialField {editable:!root.running;label:"Resistance (m² K/W)";value <=> row.resistance;}Button {text:"Remove";enabled:!root.running && root.ready;clicked=>{root.remove-contact(index);}}}
            }
            if root.section==5 : VerticalLayout {spacing:8px;vertical-stretch:0;
                MaterialField {editable:!root.running;label:"Time step (s)";value <=> root.draft.dt;}
                Text {text:"Additional physical steps";color:UiTheme.text-secondary;}SpinBox {value <=> root.draft.steps;minimum:1;maximum:1000000;enabled:!root.running && root.ready;}
                Text {text:"Record every N accepted steps";color:UiTheme.text-secondary;}SpinBox {value <=> root.draft.every;minimum:1;maximum:1000000;enabled:!root.running && root.ready;}
                MaterialField {editable:!root.running;label:"Maximum phase Courant number (0–1)";value <=> root.draft.courant;}
                Text {text:"Maximum phase subcycles";color:UiTheme.text-secondary;}SpinBox {value <=> root.draft.subcycles;minimum:1;maximum:100000;enabled:!root.running && root.ready;}
                HorizontalLayout {Button {text:"Load restart…";enabled:!root.running && root.ready;clicked=>{root.load-restart();}}Button {text:"Reset initial state";enabled:!root.running && root.ready;clicked=>{root.initialize();}}}
                Text {text:root.has-restart ? "Restart retained: next Run adds steps and physical time. Changing dt/output budget is allowed; changing physics requires reset." : "Next Run starts from the configured initial fields.";color:UiTheme.text-secondary;wrap:word-wrap;}
                Text {text:"Output: " + root.output;color:UiTheme.text-muted;wrap:word-wrap;}
            }
        }
    }
    if root.section==6 : VerticalLayout {spacing:6px;
        HorizontalLayout {ComboBox {model:["Temperature (K)","Phase-1 fraction","Density (kg/m³)","Solid regions"];current-index <=> root.field;selected(value)=>{root.refresh-view();}}CheckBox {text:"Cell edges";checked <=> root.edges;toggled=>{root.refresh-view();}}Button {text:"Open archive…";enabled:!root.running;clicked=>{root.open-archive();}}}
        HorizontalLayout {MaterialField {label:"Colour minimum (empty = archive range)";value <=> root.range-min;}MaterialField {label:"Colour maximum";value <=> root.range-max;}Button {text:"Apply range";clicked=>{root.refresh-view();}}Button {text:"Auto";clicked=>{root.range-min="";root.range-max="";root.refresh-view();}}}
        if root.three-d : HorizontalLayout {
            ComboBox {model:["Surface","Whole-cell cutaway · XY","Whole-cell cutaway · XZ","Whole-cell cutaway · YZ"];current-index <=> root.cut;selected(value)=>{root.refresh-view();}}
            Slider {minimum:0;maximum:100;value <=> root.cut-position;changed(value)=>{root.refresh-view();}enabled:root.cut!=0;}
            CheckBox {text:"Reverse cut";checked <=> root.cut-reverse;toggled=>{root.refresh-view();}enabled:root.cut!=0;}
        }
        Rectangle {height:12px;vertical-stretch:0;background:@linear-gradient(90deg,rgb(68,1,84) 0%,rgb(59,82,139) 25%,rgb(33,145,140) 50%,rgb(94,201,98) 75%,rgb(253,231,37) 100%);}
        InteractiveGeometryPreview {preview-image:root.preview;orientation-image:root.orientation;view-axis:root.view-axis;navigation-3d:true;planar-navigation:!root.three-d;show-fit-control:false;help-text:root.three-d ? "SCALAR FIELDS · DRAG: ORBIT · WHEEL: ZOOM · HOME: RESET" : "SCALAR FIELDS · DRAG: PAN · WHEEL: ZOOM · HOME: RESET";orbit(x,y,w,h)=>{root.orbit(x,y,w,h);}zoom(delta)=>{root.zoom(delta);}reset-view=>{root.home();}orbit-end=>{root.orbit-end();}pan(x,y,w,h)=>{root.pan(x,y,w,h);}select-view-axis(axis)=>{root.axis(axis);}pick-orientation(x,y)=>{root.pick-orientation(x,y);}}
        HorizontalLayout {Button {text:root.playing ? "Pause frames" : "Play frames";enabled:root.frames>1;clicked=>{root.playing=!root.playing;}}Slider {minimum:0;maximum:max(0,root.frames - 1);value:root.frame;changed(value)=>{root.show-frame(round(value));}}Text {text:(root.frames>0 ? root.frame+1 : 0)+" / "+root.frames;color:UiTheme.text-secondary;}}
    }
    Text {text:root.progress;color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
    Text {text:root.status;color:UiTheme.accent;wrap:word-wrap;vertical-stretch:0;}
    HorizontalLayout {spacing:6px;vertical-stretch:0;
        Button {text:"Close";clicked=>{root.close();}}
        Rectangle {horizontal-stretch:1;}
        Button {text:"Save setup";enabled:!root.running && root.ready;clicked=>{root.apply();}}
        Button {text:"Stop · retain checkpoint";enabled:root.running;clicked=>{root.stop();}}
        Button {text:root.paused ? "Resume" : "Pause";enabled:root.running;clicked=>{if root.paused {root.resume();}else{root.pause();}}}
        Button {text:root.has-restart ? "Run / Continue" : "Run";enabled:!root.running && root.ready;clicked=>{root.start();}}
    }
}
export struct LibraryMaterialDraft {name:string,phase:int,rho:string,mu:string,cp:string,k:string,beta:string,tmin:string,tmax:string,pmin:string,pmax:string,citation:string,url:string,revision:string,note:string}
export component MaterialLibraryDialog inherits ModalFrame {
    in-out property <[string]> entries;in-out property <int> selected;
    in-out property <string> filter;in property <string> details;in property <string> feedback;in property <bool> busy;
    in-out property <LibraryMaterialDraft> draft;
    in-out property <int> quantity:0;in-out property <string> tmin;in-out property <string> tmax;in-out property <string> pressure;
    in property <image> curve;
    private property <int> section:0;
    callback close();callback refresh();callback choose();callback evaluate();callback create();callback copy();
    panel-width:880px;panel-height:750px;close-requested=>{root.close();}
    Text {text:"Material library";color:UiTheme.text-title;font-size:17px;font-weight:700;vertical-stretch:0;}
    WorkspaceSections {model:["Browse & sources","Property curve","New revision"];current-index <=> root.section;}
    if root.section!=2 : HorizontalLayout {spacing:6px;vertical-stretch:0;
        LineEdit {placeholder-text:"Filter material names";text <=> root.filter;accepted=>{root.refresh();}}
        Button {text:"Filter";enabled:!root.busy;clicked=>{root.refresh();}}
        ComboBox {model:root.entries;current-index <=> root.selected;enabled:!root.busy;selected(value)=>{root.choose();}min-width:240px;}
    }
    PropertyScroll {section:root.section;
        if root.section==0 : VerticalLayout {spacing:8px;vertical-stretch:0;
            Text {text:root.details;color:UiTheme.text-secondary;wrap:word-wrap;vertical-stretch:0;}
            Button {text:"Copy values into a new revision";enabled:!root.busy;clicked=>{root.copy();root.section=2;}}
            Text {text:"Catalogue records are immutable. A new revision creates new IDs and retains existing project snapshots.";color:UiTheme.text-muted;wrap:word-wrap;vertical-stretch:0;}
        }
        if root.section==1 : VerticalLayout {spacing:8px;vertical-stretch:0;
            ComboBox {model:["Density · kg/m³","Dynamic viscosity · Pa·s","Specific heat · J/kg/K","Conductivity · W/m/K","Volumetric expansion · 1/K"];current-index <=> root.quantity;enabled:!root.busy;max-height:32px;}
            HorizontalLayout {MaterialField {label:"Minimum T (K)";value <=> root.tmin;}MaterialField {label:"Maximum T (K)";value <=> root.tmax;}MaterialField {label:"Pressure (Pa)";value <=> root.pressure;}}
            Button {text:"Evaluate property curve";enabled:!root.busy;clicked=>{root.evaluate();}}
            Image {source:root.curve;image-fit:contain;min-height:280px;max-height:350px;}
            Text {text:"This previews the stored property model. It does not enable variable properties during a flow solve. No extrapolation is performed.";color:UiTheme.text-muted;wrap:word-wrap;}
        }
        if root.section==2 : VerticalLayout {spacing:6px;vertical-stretch:0;
            MaterialField {label:"Material name";value <=> root.draft.name;editable:!root.busy;}
            ComboBox {model:["Gas","Liquid","Solid"];current-index <=> root.draft.phase;enabled:!root.busy;max-height:32px;}
            HorizontalLayout {MaterialField {label:"Density (kg/m³)";value <=> root.draft.rho;editable:!root.busy;}MaterialField {label:"Cp (J/kg/K)";value <=> root.draft.cp;editable:!root.busy;}MaterialField {label:"Conductivity (W/m/K)";value <=> root.draft.k;editable:!root.busy;}}
            if root.draft.phase!=2 : HorizontalLayout {MaterialField {label:"Dynamic viscosity (Pa·s)";value <=> root.draft.mu;editable:!root.busy;}MaterialField {label:"Expansion (1/K)";value <=> root.draft.beta;editable:!root.busy;}}
            HorizontalLayout {MaterialField {label:"Valid T minimum (K)";value <=> root.draft.tmin;editable:!root.busy;}MaterialField {label:"Valid T maximum (K)";value <=> root.draft.tmax;editable:!root.busy;}}
            HorizontalLayout {MaterialField {label:"Valid p minimum (Pa)";value <=> root.draft.pmin;editable:!root.busy;}MaterialField {label:"Valid p maximum (Pa)";value <=> root.draft.pmax;editable:!root.busy;}}
            MaterialField {label:"Source / citation (required)";value <=> root.draft.citation;editable:!root.busy;}
            MaterialField {label:"Source URL (optional)";value <=> root.draft.url;editable:!root.busy;}
            MaterialField {label:"Revision";value <=> root.draft.revision;editable:!root.busy;}
            MaterialField {label:"Model limitations / notes";value <=> root.draft.note;editable:!root.busy;}
            Text {text:"Creates constant, isotropic properties in SI units. Use library import for T/p sample tables, contacts, pair properties and reference data. Unknown uncertainty/licence remain unknown.";color:UiTheme.text-muted;wrap:word-wrap;}
            Button {text:"Create material revision";enabled:!root.busy;clicked=>{root.create();}}
        }
    }
    Text {text:root.feedback;color:UiTheme.accent;wrap:word-wrap;vertical-stretch:0;}
    Button {text:"Close";clicked=>{root.close();}vertical-stretch:0;}
}

export component ScriptEditorDialog inherits ModalFrame {
    in property <[string]> names;
    in-out property <int> index;
    in-out property <string> script-name;
    in-out property <string> source;
    in-out property <bool> timed;
    in-out property <string> function-name;
    in-out property <string> parameters;
    in-out property <int> quantity;
    in property <string> patch;
    in property <string> feedback;
    in property <bool> busy;
    in-out property <string> preview-position;
    in-out property <string> preview-time;
    callback load(int);callback new-template();callback save();callback attach();
    callback detach();callback delete();callback preview();
    panel-width:900px;panel-height:780px;
    Text {text:"Boundary scripts · Rhai";color:UiTheme.text-title;font-size:18px;font-weight:700;}
    Text {text:"Boundary: " + root.patch;color:UiTheme.text-secondary;}
    PropertyScroll {
        VerticalLayout {spacing:8px;
            HorizontalLayout {
                ComboBox {model:root.names;current-index <=> root.index;selected(i)=>{root.load(self.current-index);}enabled:!root.busy;horizontal-stretch:1;}
                Button {text:"New template";enabled:!root.busy;clicked=>{root.new-template();}}
            }
            Text {text:"Script name / stable project ID";color:UiTheme.text-secondary;}
            LineEdit {text <=> root.script-name;enabled:!root.busy;}
            HorizontalLayout {
                ComboBox {model:["Velocity · m/s","Pressure p/ρ · m²/s²","Temperature · K"];current-index <=> root.quantity;enabled:!root.busy;horizontal-stretch:1;}
                CheckBox {text:"Physical-time dependent";checked <=> root.timed;enabled:!root.busy;}
            }
            Text {text:root.timed ? "Signature: fn profile(x, y, z, t). Coordinates: m; time: s. Transient only." : "Signature: fn profile(x, y, z). Coordinates: m. Steady or transient.";color:UiTheme.text-secondary;wrap:word-wrap;}
            Text {text:"Return vec3(Ux, Uy, Uz) for velocity; a number for pressure or temperature. Use params.name and PI. Global statements do not run. No file, process or network API.";color:UiTheme.text-muted;wrap:word-wrap;}
            TextEdit {text <=> root.source;min-height:230px;max-height:230px;enabled:!root.busy;}
            HorizontalLayout {
                Text {text:"Function";color:UiTheme.text-secondary;vertical-alignment:center;}
                LineEdit {text <=> root.function-name;enabled:!root.busy;horizontal-stretch:1;}
            }
            Text {text:"Binding parameters · JSON object, e.g. {\"base_speed\":1.0}";color:UiTheme.text-secondary;wrap:word-wrap;}
            LineEdit {text <=> root.parameters;enabled:!root.busy;}
            HorizontalLayout {
                LineEdit {text <=> root.preview-position;placeholder-text:"x,y,z (m)";horizontal-stretch:1;}
                LineEdit {text <=> root.preview-time;placeholder-text:"Time (s)";enabled:root.timed;horizontal-stretch:1;}
                Button {text:"Check / preview";enabled:!root.busy;clicked=>{root.preview();}}
            }
            Text {text:"Supported: velocity inlet, pressure outlet (including backflow), fixed / inlet-outlet temperature. Remove a patch's time table before attaching scripts. Apply physical conditions first.";color:UiTheme.text-muted;wrap:word-wrap;}
            Text {text:root.feedback;color:UiTheme.text-secondary;wrap:word-wrap;}
        }
    }
    HorizontalLayout {spacing:8px;
        Button {text:"Save code";enabled:!root.busy;clicked=>{root.save();}}
        Button {text:"Attach / update";enabled:!root.busy && root.patch!="";clicked=>{root.attach();}}
        Button {text:"Detach quantity";enabled:!root.busy && root.patch!="";clicked=>{root.detach();}}
        Button {text:"Delete code";enabled:!root.busy;clicked=>{root.delete();}}
        Button {text:"Close";clicked=>{root.close-requested();}}
    }
}
