import { Button, ComboBox } from "std-widgets.slint";
import { UiTheme } from "../components.slint";


component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled:true;
    callback clicked();
    height:29px;
    background:hit.has-hover && root.enabled ? UiTheme.border-soft : transparent;
    border-radius:3px;
    Text {x:9px;width:parent.width - 18px;height:parent.height;text:root.text;color:root.enabled ? UiTheme.text : UiTheme.text-muted;font-size:12px;vertical-alignment:center;overflow:elide;}
    hit:=TouchArea {enabled:root.enabled;mouse-cursor:pointer;clicked=>{root.clicked();}}
}
component MenuLabel inherits Rectangle {
    in property <string> text;
    callback clicked();
    width:52px;height:30px;background:hit.has-hover ? UiTheme.border-soft : transparent;border-radius:3px;
    Text {text:root.text;color:UiTheme.text;font-size:12px;horizontal-alignment:center;vertical-alignment:center;}
    hit:=TouchArea {mouse-cursor:pointer;clicked=>{root.clicked();}}
}

export component TopBar inherits Rectangle {
    in property <bool> compact-ui;
    in property <bool> project-loaded;
    in property <bool> wb-busy;
    in property <string> project-name;
    in property <string> status;
    in property <int> current-step;
    in property <[string]> recent-project-model;
    in-out property <int> recent-project-index;
    in-out property <bool> show-browser:true;
    in-out property <bool> show-history:true;
    in-out property <bool> show-topology:false;
    callback refresh-browser();callback fit-view();
    callback new-project(); callback show-examples(); callback open-project();
    callback open-recent-project(int); callback save-project(); callback save-project-as();
    callback save-template(); callback select-step(int);

    min-height:70px;preferred-height:70px;max-height:70px;
    background:UiTheme.topbar;border-color:UiTheme.border-strong;border-width:1px;
    VerticalLayout {
        spacing:0px;
        HorizontalLayout {
            height:36px;spacing:3px;padding-left:8px;padding-right:8px;
            Image {source:@image-url("../assets/flursys-logo.svg");width:32px;height:32px;image-fit:contain;}
            Text {text:"FLURSYS";color:UiTheme.text-title;font-size:20px;font-weight:800;vertical-alignment:center;}
            Rectangle {width:1px;height:22px;background:UiTheme.border;}
            Text {text:"CFD WORKBENCH";color:UiTheme.text-label;font-size:10px;vertical-alignment:center;}
            file-button := MenuLabel {text:"File";clicked=>{file-menu.show();}}
            view-button := MenuLabel {text:"View";clicked=>{view-menu.show();}}
            tools-button := MenuLabel {text:"Tools";clicked=>{tools-menu.show();}}
            Rectangle {width:1px;height:22px;background:UiTheme.border;}
            Text {text:root.project-loaded ? root.project-name : "Untitled Project";color:UiTheme.text-project;font-size:11px;min-width:0px;horizontal-stretch:1;overflow:elide;horizontal-alignment:right;vertical-alignment:center;}
            if root.project-loaded : Text {text:"●";color:UiTheme.accent;font-size:9px;vertical-alignment:center;}
        }
        HorizontalLayout {
            height:33px;spacing:2px;padding-left:10px;padding-right:8px;
            Rectangle {width:58px;}
            for page[index] in ["Geometry", "Mesh", "Setup", "Solution", "Results"] : Rectangle {
                width:root.compact-ui ? 76px : 88px;height:32px;
                background:root.current-step==index ? UiTheme.sidebar : transparent;
                Rectangle {x:0px;y:29px;width:parent.width;height:2px;background:root.current-step==index ? UiTheme.accent : transparent;}
                Text {text:page;color:root.current-step==index ? UiTheme.text-title : UiTheme.text-label;font-size:11px;font-weight:root.current-step==index ? 700 : 500;horizontal-alignment:center;vertical-alignment:center;}
                TouchArea {mouse-cursor:pointer;clicked=>{root.select-step(index);}}
            }
            Rectangle {horizontal-stretch:1;}
            Text {text:root.wb-busy ? "● "+root.status : root.status; color:root.wb-busy ? UiTheme.accent : UiTheme.text-label;font-size:10px;vertical-alignment:center;max-width:190px;overflow:elide;}
        }
    }

    file-menu := PopupWindow {
        x:file-button.x;y:36px;width:245px;height:root.recent-project-model.length>0 ? 310px : 230px;close-policy:close-on-click-outside;
        Rectangle {background:UiTheme.sidebar;border-width:1px;border-color:UiTheme.border-strong;border-radius:4px;
            VerticalLayout {padding:6px;spacing:1px;
                MenuItem {text:"New project";enabled:!root.wb-busy;clicked=>{file-menu.close();root.new-project();}}
                MenuItem {text:"Open project…";enabled:!root.wb-busy;clicked=>{file-menu.close();root.open-project();}}
                Rectangle {height:1px;background:UiTheme.border;}
                MenuItem {text:"Save";clicked=>{file-menu.close();root.save-project();}}
                MenuItem {text:"Save as…";clicked=>{file-menu.close();root.save-project-as();}}
                MenuItem {text:"Save template…";clicked=>{file-menu.close();root.save-template();}}
                Rectangle {height:1px;background:UiTheme.border;}
                MenuItem {text:"Examples…";enabled:!root.wb-busy;clicked=>{file-menu.close();root.show-examples();}}
                if root.recent-project-model.length>0 : VerticalLayout {spacing:4px;
                    Text {text:"RECENT PROJECTS";color:UiTheme.text-muted;font-size:9px;}
                    ComboBox {model:root.recent-project-model;current-index <=> root.recent-project-index;min-width:0px;}
                    MenuItem {text:"Open selected recent";enabled:root.recent-project-index>=0 && !root.wb-busy;clicked=>{file-menu.close();root.open-recent-project(root.recent-project-index);}}
                }
            }
        }
    }
    view-menu := PopupWindow {
        x:view-button.x;y:36px;width:220px;height:78px;close-policy:close-on-click-outside;
        Rectangle {background:UiTheme.sidebar;border-width:1px;border-color:UiTheme.border-strong;border-radius:4px;
            VerticalLayout {padding:6px;spacing:2px;
                MenuItem {text:root.show-browser ? "✓ Browser" : "Browser";clicked=>{root.show-browser=!root.show-browser;view-menu.close();}}
                MenuItem {text:"Fit view";enabled:root.current-step!=3;clicked=>{view-menu.close();root.fit-view();}}
            }
        }
    }
    tools-menu := PopupWindow {
        x:tools-button.x;y:36px;width:230px;height:80px;close-policy:close-on-click-outside;
        Rectangle {background:UiTheme.sidebar;border-width:1px;border-color:UiTheme.border-strong;border-radius:4px;
            VerticalLayout {padding:6px;spacing:2px;
                MenuItem {text:root.show-topology ? "✓ Topology inspector" : "Topology inspector";clicked=>{root.show-topology=!root.show-topology;root.refresh-browser();tools-menu.close();}}
                MenuItem {text:"Examples…";enabled:!root.wb-busy;clicked=>{tools-menu.close();root.show-examples();}}
            }
        }
    }
}
