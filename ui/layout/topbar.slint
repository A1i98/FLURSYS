import { Button, ComboBox } from "std-widgets.slint";
import { UiTheme } from "../components.slint";

export component TopBar inherits Rectangle {
    in property <bool> compact-ui;
    in property <bool> project-loaded;
    in property <bool> wb-busy;
    in property <bool> can-run-workbench;
    in property <string> project-name;
    in property <string> status;
    in property <[string]> recent-project-model;
    in-out property <int> recent-project-index;
    callback new-project();
    callback show-examples();
    callback open-project();
    callback open-recent-project(int);
    callback save-project();
    callback save-project-as();
    callback save-template();
    callback select-step(int);
    callback run-workbench();

    min-height:88px;preferred-height:88px;max-height:88px;
    background:UiTheme.topbar;border-color:UiTheme.border-strong;border-width:1px;
    VerticalLayout {
        padding:8px;spacing:5px;
        HorizontalLayout {
            height:33px;spacing:7px;
            Text {text:"FLURSYS";color:UiTheme.text-title;font-size:21px;font-weight:800;vertical-alignment:center;}
            if !root.compact-ui : Text {text:"CFD WORKBENCH";color:UiTheme.text-label;font-size:11px;vertical-alignment:center;}
            Button {min-width:0px;text:root.compact-ui ? "NEW" : "NEW PROJECT";clicked=>{root.new-project();}}
            Button {min-width:0px;text:"EXAMPLES";clicked=>{root.show-examples();}}
            Button {min-width:0px;text:"OPEN";clicked=>{root.open-project();}}
            Button {min-width:0px;text:"SAVE";clicked=>{root.save-project();}}
            Button {min-width:0px;text:"SAVE AS…";clicked=>{root.save-project-as();}}
            if !root.compact-ui : Button {min-width:0px;text:"SAVE TEMPLATE…";clicked=>{root.save-template();}}
            if !root.compact-ui && root.recent-project-model.length>0 : ComboBox {model:root.recent-project-model;current-index <=> root.recent-project-index;min-width:0px;preferred-width:150px;}
            if !root.compact-ui && root.recent-project-index>=0 : Button {min-width:0px;text:"OPEN RECENT";clicked=>{root.open-recent-project(root.recent-project-index);}}
            Text {text:root.project-loaded ? root.project-name : "No project loaded";color:UiTheme.text-project;font-size:11px;min-width:0px;horizontal-stretch:1;overflow:elide;horizontal-alignment:right;vertical-alignment:center;}
        }
        HorizontalLayout {
            height:32px;spacing:7px;
            Text {text:"WORKFLOW";color:UiTheme.text-label;font-size:10px;vertical-alignment:center;}
            Button {min-width:0px;text:"GEOMETRY";clicked=>{root.select-step(0);}}
            Button {min-width:0px;text:"MESH";clicked=>{root.select-step(1);}}
            Button {min-width:0px;text:"SETUP";clicked=>{root.select-step(2);}}
            Button {min-width:0px;text:"SOLUTION";clicked=>{root.select-step(3);}}
            Button {min-width:0px;text:"RESULTS";clicked=>{root.select-step(4);}}
            Rectangle {horizontal-stretch:1;}
            Text {text:root.status;color:UiTheme.accent;font-size:11px;font-weight:700;vertical-alignment:center;max-width:160px;overflow:elide;}
            Button {min-width:0px;text:root.wb-busy ? "BUSY…" : "RUN";enabled:root.can-run-workbench && !root.wb-busy;clicked=>{root.run-workbench();}}
        }
    }
}
