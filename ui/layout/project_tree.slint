import { ListView, Button } from "std-widgets.slint";
import { ProjectTreeRow, TreeRowView, UiTheme } from "../components.slint";

import { CadContextMenu } from "../cad-context.slint";

export component ProjectTree inherits Rectangle {
    in property <bool> compact-ui;
    in property <[ProjectTreeRow]> project-tree-model;
    callback select-tree-row(int, bool);
    callback toggle-tree-row(int);
    callback edit-tree-row(int);
    callback context-tree-row(int)->bool;
    callback expand-history(bool);
    callback command(int);
    callback activate(int);
    in property <bool> can-edit-feature;
    in property <bool> has-source-sketch;
    in property <bool> has-body;
    in property <bool> has-sketch;
    in property <bool> planar-face;
    in property <bool> has-edge;
    in property <string> selection-label;
    in property <bool> locked;
    property <length> menu-x:0px;
    property <length> menu-y:0px;
    tree-menu := CadContextMenu {
        x:root.menu-x;y:root.menu-y;
        can-edit-feature:root.can-edit-feature;has-source-sketch:root.has-source-sketch;
        has-body:root.has-body;has-sketch:root.has-sketch;planar-face:root.planar-face;has-edge:root.has-edge;
        selection-label:root.selection-label;locked:root.locked;
        command(action)=>{root.command(action);}
        activate(action)=>{root.activate(action);}
        fit=>{root.command(72);}
    }

    min-width: root.compact-ui ? 176px : 208px;
    preferred-width: root.compact-ui ? 200px : 244px;
    max-width: root.compact-ui ? 220px : 268px;
    background: UiTheme.sidebar;
    border-color: UiTheme.border-soft;
    border-width: 1px;
    VerticalLayout {
        padding: root.compact-ui ? 9px : 12px;
        spacing: root.compact-ui ? 6px : 8px;
        HorizontalLayout {spacing:4px;
            Text {text:"MODEL & PROJECT";color:UiTheme.text-dim;font-size:10px;font-weight:700;vertical-alignment:center;horizontal-stretch:1;}
            Button {text:"▾";preferred-width:25px;min-width:25px;max-height:25px;clicked=>{root.expand-history(true);}}
            Button {text:"▸";preferred-width:25px;min-width:25px;max-height:25px;clicked=>{root.expand-history(false);}}
        }
        tree-frame := Rectangle {
            vertical-stretch: 1;
            border-color: UiTheme.border-soft;
            border-width: 1px;
            border-radius: 3px;
            background: rgb(12, 21, 28);
            tree-list := ListView { for row[visible-index] in root.project-tree-model : TreeRowView {
                entry:row;
                select(additive)=>{root.select-tree-row(row.index,additive);}
                toggle=>{root.toggle-tree-row(row.index);}
                activate=>{root.edit-tree-row(row.index);}
                context-menu(x,y)=>{
                    if root.context-tree-row(row.index) {
                        root.menu-x=x*1px;
                        root.menu-y=max(0px,min(tree-frame.y+tree-list.viewport-y+visible-index*34px+y*1px,root.height - tree-menu.menu-height));
                        tree-menu.show();
                    }
                }
            }}
        }
        Rectangle { height: 1px; background: UiTheme.border-soft; }
        if !root.compact-ui : Text { text: "Active numerical core"; color: UiTheme.text-label; font-size: 10px; }
        Text { text: root.compact-ui ? "2D FVM · 3D preview" : "Unstructured Gmsh FVM\n2D structured FVM · 3D preview"; color: UiTheme.text-mid; font-size: 10px; wrap: word-wrap; }
    }
}
