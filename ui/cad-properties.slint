import { LineEdit } from "std-widgets.slint";
import { UiTheme } from "components.slint";

export component CadQuantityProperty inherits Rectangle {
    in property <string> label;
    in property <string> unit;
    in-out property <string> value;
    in property <bool> enabled:true;
    callback edited();
    min-height:53px;preferred-height:53px;max-height:53px;
    VerticalLayout {spacing:3px;
        Text {text:root.label;color:UiTheme.text-secondary;font-size:11px;wrap:word-wrap;}
        HorizontalLayout {spacing:5px;
            LineEdit {text <=> root.value;enabled:root.enabled;min-width:0px;preferred-width:1px;horizontal-stretch:1;min-height:32px;max-height:32px;edited(value)=>{root.edited();}}
            if root.unit!="" : Text {text:root.unit;color:UiTheme.text-muted;font-size:11px;min-width:24px;vertical-alignment:center;}
        }
    }
}
export component CadVectorProperty inherits Rectangle {
    in property <string> label;
    in property <string> unit;
    in-out property <string> x-value;
    in-out property <string> y-value;
    in-out property <string> z-value;
    in property <bool> three:true;
    in property <bool> enabled:true;
    callback edited();
    min-height:72px;preferred-height:72px;max-height:72px;
    VerticalLayout {spacing:3px;
        Text {text:root.label+(root.unit!="" ? " ("+root.unit+")" : "");color:UiTheme.text-secondary;font-size:11px;wrap:word-wrap;}
        HorizontalLayout {spacing:5px;
            VerticalLayout {spacing:2px;Text {text:"X";color:#e99c9c;font-size:10px;}LineEdit {text <=> root.x-value;enabled:root.enabled;min-width:0px;preferred-width:1px;horizontal-stretch:1;min-height:32px;max-height:32px;edited(value)=>{root.edited();}}}
            VerticalLayout {spacing:2px;Text {text:"Y";color:#9bd9a8;font-size:10px;}LineEdit {text <=> root.y-value;enabled:root.enabled;min-width:0px;preferred-width:1px;horizontal-stretch:1;min-height:32px;max-height:32px;edited(value)=>{root.edited();}}}
            if root.three : VerticalLayout {spacing:2px;Text {text:"Z";color:#9dbff0;font-size:10px;}LineEdit {text <=> root.z-value;enabled:root.enabled;min-width:0px;preferred-width:1px;horizontal-stretch:1;min-height:32px;max-height:32px;edited(value)=>{root.edited();}}}
        }
    }
}
