import {SectionProperties} from "section-properties.slint";
import {PropertyAction, PropertyCaption} from "components.slint";
import {Button,ComboBox,SpinBox,CheckBox,LineEdit} from "std-widgets.slint";
import {UiTheme, WorkspaceSections} from "components.slint";
component Label inherits PropertyCaption {}
component Action inherits PropertyAction {}
export component PlaneMonitorPanel inherits VerticalLayout {
    private property <int> section:0;
    in property <[string]> names;
    in-out property <int> index;
    in-out property <int> every:10;
    in-out property <bool> record:false;
    in-out property <int> field:0;
    in-out property <int> palette:1;
    in-out property <int> density:1;
    in-out property <string> scale:"1";
    in-out property <int> plot:0;
    in-out property <int> levels:12;
    in-out property <bool> streamlines:false;
    in-out property <bool> vectors:true;
    in-out property <bool> edges:false;
    in-out property <bool> normalize:true;
    in-out property <bool> normal-marks:false;
    in-out property <string> range-min;
    in-out property <string> range-max;
    in property <bool> busy;
    in property <string> details;
    in property <string> status;
    callback profile(string,string,string,string,int,int);
    callback select(int);callback apply();callback view();callback style();callback export(int);
    vertical-stretch:0;spacing:7px;
    Label {text:"SECTION";color:UiTheme.accent;font-weight:700;}
    ComboBox {model:root.names;current-index <=> root.index;max-height:32px;min-width:0px;selected(value)=>{root.select(self.current-index);}}
    Label {text:root.details;}
    SectionProperties {field <=> root.field;plot <=> root.plot;palette <=> root.palette;density <=> root.density;scale <=> root.scale;levels <=> root.levels;streamlines <=> root.streamlines;vectors <=> root.vectors;edges <=> root.edges;normalize <=> root.normalize;normal-marks <=> root.normal-marks;range-min <=> root.range-min;range-max <=> root.range-max;every <=> root.every;record <=> root.record;busy:root.busy;style=>{root.style();}apply=>{root.apply();}export(i)=>{root.export(i);}profile(a,b,c,d,n,k)=>{root.profile(a,b,c,d,n,k);}}
    Action {text:"Show section";enabled:root.names.length>0;clicked=>{root.view();}}
    Label {text:root.status;max-height:68px;overflow:elide;}
}
