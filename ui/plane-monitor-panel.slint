import {Button,ComboBox,SpinBox,CheckBox,LineEdit} from "std-widgets.slint";
import {UiTheme} from "components.slint";
component Label inherits Text {vertical-stretch:0;color:UiTheme.text-muted;font-size:10px;wrap:word-wrap;}
component Action inherits Button {min-width:0px;min-height:30px;max-height:32px;}
export component PlaneMonitorPanel inherits VerticalLayout {
    in property <[string]> names;
    in-out property <int> index;
    in-out property <int> every:10;
    in-out property <bool> record:false;
    in-out property <int> field:0;
    in-out property <bool> vectors:true;
    in-out property <bool> edges:false;
    in-out property <bool> normalize:true;
    in-out property <bool> normal-marks:false;
    in-out property <string> range-min;
    in-out property <string> range-max;
    in property <bool> busy;
    in property <string> details;
    in property <string> status;
    callback select(int);callback apply();callback view();callback style();callback export(int);
    vertical-stretch:0;spacing:7px;
    Text {text:"CAD SECTION · FIELDS";color:UiTheme.accent;font-size:11px;font-weight:700;vertical-stretch:0;}
    ComboBox {model:root.names;current-index <=> root.index;max-height:32px;min-width:0px;selected(value)=>{root.select(self.current-index);}}
    Label {text:root.details;}
    Label {text:"COLOUR FIELD";}
    ComboBox {model:["Speed |U| · m/s","Pressure p/ρ · m²/s²","Velocity X · m/s","Velocity Y · m/s","Velocity Z · m/s","Normal velocity · m/s"];current-index <=> root.field;max-height:32px;min-width:0px;selected(value)=>{root.style();}}
    HorizontalLayout {vertical-stretch:0;CheckBox {min-height:30px;max-height:30px;text:"Vectors";checked <=> root.vectors;toggled=>{root.style();}} CheckBox {min-height:30px;max-height:30px;text:"Cell edges";checked <=> root.edges;toggled=>{root.style();}}}
    CheckBox {min-height:30px;max-height:30px;text:"Normalize arrow length";checked <=> root.normalize;toggled=>{root.style();}}
    CheckBox {min-height:30px;max-height:30px;text:"Normal flow markers";checked <=> root.normal-marks;toggled=>{root.style();}}
    Label {text:"COLOUR RANGE · empty = automatic";}
    HorizontalLayout {vertical-stretch:0;spacing:4px;
        LineEdit {min-width:0px;max-height:32px;text <=> root.range-min;placeholder-text:"Minimum";accepted=>{root.style();}}
        LineEdit {min-width:0px;max-height:32px;text <=> root.range-max;placeholder-text:"Maximum";accepted=>{root.style();}}
    }
    HorizontalLayout {vertical-stretch:0;Action {text:"Apply range";clicked=>{root.style();}} Action {text:"Auto";clicked=>{root.range-min="";root.range-max="";root.style();}}}
    Action {text:"Show section in Results";enabled:root.names.length>0;clicked=>{root.view();}}
    HorizontalLayout {vertical-stretch:0;spacing:4px;
        Action {text:"CSV ↓";clicked=>{root.export(0);}} Action {text:"PNG ↓";clicked=>{root.export(1);}} Action {text:"SVG ↓";clicked=>{root.export(2);}}
    }
    Rectangle {height:1px;background:UiTheme.border;}
    CheckBox {min-height:30px;max-height:30px;text:"Record all velocity + pressure fields";checked <=> root.record;enabled:!root.busy;}
    HorizontalLayout {vertical-stretch:0;spacing:6px;
        Label {text:"Every N iterations / time steps";horizontal-stretch:1;}
        SpinBox {value <=> root.every;minimum:1;maximum:1000000;max-height:32px;preferred-width:100px;min-width:0px;enabled:!root.busy;}
    }
    Action {text:"Apply recording settings";enabled:!root.busy && root.names.length>0;clicked=>{root.apply();}}
    Label {text:root.status;max-height:68px;overflow:elide;}
    Label {text:"CSV always contains p/ρ and all three velocity components. Scheduled SVG uses the display selected before Run. Steady: iteration history. Transient: accepted physical time levels.";}
}
