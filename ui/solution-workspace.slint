import {SectionProperties} from "section-properties.slint";
import {PropertyAction, PropertyCaption} from "components.slint";
import {SectionViewport} from "section-viewport.slint";
import {PlanePlayback} from "plane-playback.slint";
import {CheckBox,ComboBox,Button,LineEdit,SpinBox,ProgressIndicator,TextEdit,ScrollView} from "std-widgets.slint";
import {UiTheme, PropertiesPanel, PropertyScroll, WorkspaceSections} from "components.slint";
component Tool inherits PropertyAction {}
component Label inherits PropertyCaption {}
export component SolutionWorkspace inherits Rectangle {
    in property <int> plane-frame;
    in property <int> plane-count;
    in property <bool> plane-playing;
    in-out property <int> plane-fps:10;
    in-out property <bool> plane-loop:false;
    in-out property <int> plane-first:1;
    in-out property <int> plane-last:0;
    callback playback(int);
    in-out property <int> plane-palette:1;
    in-out property <int> plane-density:1;
    in-out property <string> plane-scale:"1";
    in-out property <int> plane-plot:0;
    in-out property <int> plane-levels:12;
    in-out property <bool> plane-streamlines:false;
    in-out property <int> plane-field;
    in-out property <bool> plane-vectors;
    in-out property <bool> plane-edges;
    in-out property <bool> plane-normalize;
    in-out property <bool> plane-normal-marks;
    in-out property <string> plane-min;
    in-out property <string> plane-max;
    callback plane-profile(string,string,string,string,int,int);
    callback style-plane();

    in-out property <int> chart-kind;
    callback refresh-chart();
    in-out property <bool> continuity:true;
    in-out property <bool> momentum:true;
    in-out property <bool> velocity:true;
    in-out property <bool> pressure:true;
    in-out property <bool> logarithmic:true;
    in-out property <bool> normalized:false;
    in-out property <bool> legend:true;
    in-out property <int> history-window:0;
    in property <string> readout;
    callback resize-chart(float,float);
    callback hover-chart(float);
    in-out property <bool> show-plane:false;
    in property <image> plane-image;
    in property <string> plane-readout;
    callback plane-navigate(int,float,float,float,float);
    in property <[string]> plane-names;
    in-out property <int> plane-index;
    in-out property <int> plane-every;
    in-out property <bool> plane-enabled;
    in property <string> plane-details;
    in property <string> plane-status;
    callback export-plane(int);
    callback select-plane(int);callback apply-plane();callback view-plane();
    in property <image> chart;
    in property <string> caption;
    in property <string> monitor;
    in property <string> balance;
    in property <string> convergence-summary;
    in property <string> summary;
    in property <string> readiness;
    in property <string> preflight;
    in property <bool> mapping-busy;
    in-out property <string> box-xmin;in-out property <string> box-ymin;in-out property <string> box-zmin;
    in-out property <string> box-xmax;in-out property <string> box-ymax;in-out property <string> box-zmax;
    callback review();callback repair-stage(int);callback manage-plane(int);
    in property <string> log;
    in property <string> material;
    in property <bool> paused;
    in property <bool> three-d;
    in-out property <string> initial-x;
    in-out property <string> initial-y;
    in-out property <string> initial-z;
    in-out property <string> initial-p;
    in-out property <int> properties-section:0;
    in property <string> wall-summary;
    in-out property <string> target-courant;
    in-out property <string> min-time-step;
    in-out property <string> max-time-step;
    in-out property <string> time-growth;
    in-out property <int> coupling-algorithm;
    in-out property <int> pressure-correctors;
    in-out property <int> nonorthogonal-correctors;
    in-out property <string> nonorthogonal-limiter;
    in-out property <int> time-mode;
    in-out property <string> time-step;
    in-out property <int> time-steps;
    in-out property <string> end-time;
    in-out property <string> turbulence-relaxation;in-out property <string> turbulence-tolerance;
    in-out property <int> turbulence-model;
    in-out property <string> nu-tilda;
    in-out property <int> wall-treatment;
    in-out property <string> turbulence-epsilon;
    in-out property <string> turbulence-k;
    in-out property <string> turbulence-omega;
    callback control(int);
    in property <bool> busy;
    in property <bool> can-run;
    in property <float> progress;
    in-out property <int> iterations;
    in-out property <int> checkpoint-every:100;
    in-out property <int> cpu-threads;
    in property <int> cpu-limit:1;
    in-out property <string> velocity-relaxation;
    in-out property <int> convection-index;
    in-out property <string> pressure-relaxation;
    in-out property <string> continuity-tolerance;
    in-out property <string> coupling-tolerance;
    in-out property <bool> show-log:false;
    in-out property <bool> solver-panel-open:true;
    in-out property <bool> report-panel-open:false;
    in-out property <int> export-format:0;
    callback apply();callback run();callback cancel();callback edit-material();callback edit-equations();callback edit-volume-models();callback export-history();callback export-chart();callback export-vector();
    background:UiTheme.background;
    VerticalLayout {padding:12px;spacing:9px;
        HorizontalLayout {height:34px;spacing:8px;
            Rectangle {horizontal-stretch:1;}
            Tool {text:"Review case";enabled:!root.busy;clicked=>{root.review();root.properties-section=4;}}
            Tool {text:"Load restart…";enabled:root.can-run && !root.busy;clicked=>{root.control(2);}}
            Tool {text:"Initialization";enabled:root.can-run && !root.busy;clicked=>{root.properties-section=0;}}
            Tool {text:root.paused ? "Resume" : "Pause";icon:root.paused ? @image-url("assets/icons/play.svg") : @image-url("assets/icons/pause.svg");enabled:root.busy;clicked=>{root.control(1);}}
            Tool {text:"Stop · retain fields";icon:@image-url("assets/icons/stop.svg");enabled:root.busy;clicked=>{root.cancel();}}
            Tool {text:root.busy ? "Solving…" : "Run / Continue";icon:@image-url("assets/icons/play.svg");enabled:root.can-run && !root.busy;clicked=>{root.run();}}
        }
        Text {text:root.paused ? "PAUSED · solver state retained · use Resume to continue" : root.monitor;color:UiTheme.text;font-size:12px;max-height:28px;overflow:elide;vertical-stretch:0;}
        WorkspaceSections {model:["Initialize","Models","Time","Methods","Reports","Display"];current-index <=> root.properties-section;selected(i)=>{if i==5 {root.show-plane=true;root.show-log=false;}}}
        HorizontalLayout {spacing:10px;
            PropertiesPanel {
                VerticalLayout {padding:0px;spacing:0px;
                    PropertyScroll {section:root.properties-section;
if root.properties-section==0 : VerticalLayout {spacing:6px;vertical-stretch:0;
                            Label {text:"Uniform velocity · X / Y / Z (m/s)";}
                            HorizontalLayout {spacing:4px;
                                LineEdit {text <=> root.initial-x;min-width:0px;}
                                LineEdit {text <=> root.initial-y;min-width:0px;}
                                LineEdit {text <=> root.initial-z;min-width:0px;}
                            }
                            Label {text:"Kinematic gauge pressure p/ρ (m²/s²)";}
                            LineEdit {text <=> root.initial-p;min-width:0px;}
                            Label {text:"Replaces retained fields. Boundary values are applied when Run starts.";}
                            if root.mapping-busy : Label {text:"Preparing initial fields in background…";color:UiTheme.accent;}
                            if root.mapping-busy : Tool {text:"Cancel mapping";clicked=>{root.control(5);}}
                            Label {text:"MAP FROM PREVIOUS MESH";color:UiTheme.accent;font-weight:700;}
                            Tool {text:"Map selected result";enabled:root.can-run && !root.busy;clicked=>{root.control(3);}}
                            Tool {text:"Map VTK file…";enabled:root.can-run && !root.busy;clicked=>{root.control(4);}}
                            Label {text:"U and p/ρ only; same coordinates and convex source cells. No extrapolation. Starts a new solve at time/iteration zero; other fields and flux are rebuilt."; }
                            Tool {text:"Initialize fields";enabled:root.can-run && !root.busy;clicked=>{root.control(0);}}
                            Label {text:"BOX PATCH · metres";color:UiTheme.accent;font-weight:700;}
                            HorizontalLayout {spacing:4px;LineEdit {text <=> root.box-xmin;placeholder-text:"X min";min-width:0px;}LineEdit {text <=> root.box-xmax;placeholder-text:"X max";min-width:0px;}}
                            HorizontalLayout {spacing:4px;LineEdit {text <=> root.box-ymin;placeholder-text:"Y min";min-width:0px;}LineEdit {text <=> root.box-ymax;placeholder-text:"Y max";min-width:0px;}}
                            HorizontalLayout {spacing:4px;LineEdit {text <=> root.box-zmin;placeholder-text:"Z min";min-width:0px;}LineEdit {text <=> root.box-zmax;placeholder-text:"Z max";min-width:0px;}}
                            Tool {text:"Patch U / p inside box";enabled:root.can-run && !root.busy;clicked=>{root.control(6);}}
                            Label {text:"Uses the U and p/ρ values above for enclosed cell centres. Outside retains queued fields, or zero if none. Flux and other physical fields are rebuilt at Run."; }

                        }
                        if root.properties-section==1 : VerticalLayout {spacing:8px;vertical-stretch:0;
                            Label {text:root.material;}
                            Tool {text:"Fluid material…";enabled:!root.busy;clicked=>{root.edit-material();}}
Label {text:"Momentum transport model · experimental";}
                        ComboBox {model:["Laminar","RANS · k–ω (wall resolved)","RANS · k–ω SST (wall resolved)","LES · Smagorinsky","LES · WALE","RANS · k–ε (experimental)","RANS · SA-noft2 (wall resolved)","RANS · RNG k–ε (experimental)","RANS · Realizable k–ε (experimental)"];current-index <=> root.turbulence-model;enabled:!root.busy;min-width:0px;}
                        if root.turbulence-model>0 : VerticalLayout {spacing:6px;vertical-stretch:0;
                            Label {text:"Turbulence equation relaxation (0,1]";}
                            LineEdit {text <=> root.turbulence-relaxation;max-height:32px;min-width:0px;}
                            Label {text:"Relative turbulence update tolerance";}
                            LineEdit {text <=> root.turbulence-tolerance;max-height:32px;min-width:0px;}
                        }
                        if root.turbulence-model==6 : VerticalLayout {spacing:6px;vertical-stretch:0;
                            Label {text:"Initial / default incoming SA ν̃ · m²/s";}
                            LineEdit {text <=> root.nu-tilda;enabled:!root.busy;max-height:32px;min-width:0px;}
                            Label {text:"SA-noft2, wall-resolved: ν̃=0 at walls. Target y+ ≈ 1. No transition, roughness or SA-neg extension. Experimental.";}
                        }
                        if root.turbulence-model==1 || root.turbulence-model==2 : VerticalLayout {spacing:6px;vertical-stretch:0;
                            Label {text:"Initial / inlet k (m²/s²)";}
                            LineEdit {text <=> root.turbulence-k;enabled:!root.busy;min-width:0px;}
                            Label {text:"Initial / inlet ω (1/s)";}
                            LineEdit {text <=> root.turbulence-omega;enabled:!root.busy;min-width:0px;}
                            Label {text:"Wall treatment";}
                            ComboBox {model:["Wall resolved","Blended smooth omega wall functions"];current-index <=> root.wall-treatment;enabled:!root.busy;min-height:32px;max-height:32px;min-width:0px;}
                            Label {text:root.wall-treatment==0 ? "Resolve the viscous sublayer: target y+ ≈ 1." : "Experimental equilibrium smooth-wall model. Inspect y+ and separation; no roughness or validated buffer-layer accuracy.";}
                        }
                        if root.turbulence-model==5 || root.turbulence-model==7 || root.turbulence-model==8 : VerticalLayout {spacing:6px;vertical-stretch:0;
                            Label {text:"Initial / inlet k (m²/s²)";}LineEdit {text <=> root.turbulence-k;min-width:0px;}
                            Label {text:"Initial / inlet ε (m²/s³)";}LineEdit {text <=> root.turbulence-epsilon;min-width:0px;}
                            Label {text:"Wall treatment";}
                            ComboBox {model:["Free shear / no wall model","Smooth equilibrium wall functions"];current-index <=> root.wall-treatment;enabled:!root.busy;min-height:32px;max-height:32px;min-width:0px;}
                            Label {text:"Equilibrium smooth-wall model: inspect y+. Target log-layer cells (typically y+ > 30); buffer-layer, separation and heat-transfer accuracy are not validated. No rough-wall model.";}

                        }
                        if root.turbulence-model==3 || root.turbulence-model==4 : Label {text:"LES requires transient flow and a sufficiently resolved 3D mesh. Filter width is cube root of cell volume. No dynamic SGS model.";}


                        }
                        if root.properties-section==2 : VerticalLayout {spacing:8px;vertical-stretch:0;
Label {text:"Time integration";}
                        ComboBox {model:["Steady","Transient · fixed Euler Δt","Transient · adaptive Euler Δt","Transient · BDF2 fixed Δt","Transient · adaptive BDF2 Δt"];current-index <=> root.time-mode;enabled:!root.busy;min-width:0px;}
                        if root.time-mode>0 : VerticalLayout {spacing:6px;vertical-stretch:0;
                            Label {text:(root.time-mode==2 || root.time-mode==4) ? "Initial time step Δt (s)" : "Physical time step Δt (s)";}
                            LineEdit {text <=> root.time-step;enabled:!root.busy;min-width:0px;}
                            Label {text:"Absolute end time (s; blank = step budget)";}
                            LineEdit {text <=> root.end-time;enabled:!root.busy;min-width:0px;}
                            Label {text:"Maximum additional physical time steps";}
                            SpinBox {value <=> root.time-steps;minimum:1;maximum:1000000;enabled:!root.busy;}
                            if root.time-mode==2 || root.time-mode==4 : VerticalLayout {spacing:6px;vertical-stretch:0;
                                Label {text:"Target maximum Courant number";}
                                LineEdit {text <=> root.target-courant;enabled:!root.busy;min-width:0px;}
                                Label {text:"Minimum / maximum Δt (s)";}
                                HorizontalLayout {spacing:4px;LineEdit {text <=> root.min-time-step;min-width:0px;enabled:!root.busy;}LineEdit {text <=> root.max-time-step;min-width:0px;enabled:!root.busy;}}
                                Label {text:"Maximum step growth factor (1–2)";}
                                LineEdit {text <=> root.time-growth;enabled:!root.busy;min-width:0px;}
                                Label {text:"Oversized Courant or unconverged steps are rolled back and retried at smaller Δt. Physical time advances only after acceptance.";}
                            }
                            Label {text:"Record every N means N accepted time steps. Actual Δt, Courant and rejected attempts are reported in the solver log.";}
                        }

                        }
                        if root.properties-section==3 : VerticalLayout {spacing:8px;vertical-stretch:0;
Label {text:"CPU worker threads (0 = automatic)";}
                        SpinBox {max-height:32px;value <=> root.cpu-threads;minimum:0;maximum:root.cpu-limit;enabled:!root.busy;}
                        Label {text:"Available logical CPUs: "+root.cpu-limit+". Parallel work currently covers the velocity components.";}
                        Label {text:"Save restart fields every N iterations (0 = off)";}
                        SpinBox {max-height:32px;value <=> root.checkpoint-every;minimum:0;maximum:1000000;enabled:!root.busy;}
                        Label {text:root.time-mode==0 ? "Iterations to run / add" : "Maximum coupled correctors per time step";}
                        SpinBox {max-height:32px;value <=> root.iterations;minimum:1;maximum:1000000;enabled:!root.busy;}
                        Label {text:"Momentum convection";}
                        ComboBox {model:["First-order upwind","Limited linear upwind","Central (unbounded)","Van Leer (bounded)"];current-index <=> root.convection-index;enabled:!root.busy;max-height:32px;min-width:0px;}
                        Label {text:"Pressure–velocity coupling · experimental"; }
                        ComboBox {model:["SIMPLE","PIMPLE · transient only","SIMPLEC"];current-index <=> root.coupling-algorithm;enabled:!root.busy;max-height:32px;min-width:0px;}
                        if root.coupling-algorithm==1 : VerticalLayout {vertical-stretch:0;spacing:5px;
                            Label {text:"Inner pressure correctors per outer iteration";}
                            SpinBox {value <=> root.pressure-correctors;minimum:1;maximum:8;enabled:!root.busy;max-height:32px;}
                            Label {text:"Select a transient time scheme above. Outer iterations retain the same physical-time history.";}
                        }
                        Label {text:"Extra non-orthogonal pressure passes";}
                        SpinBox {value <=> root.nonorthogonal-correctors;minimum:0;maximum:8;enabled:!root.busy;max-height:32px;}
                        if root.nonorthogonal-correctors>0 : VerticalLayout {vertical-stretch:0;spacing:5px;
                            Label {text:"Non-orthogonal limiter · 0 off / 1 unlimited";}
                            LineEdit {text <=> root.nonorthogonal-limiter;enabled:!root.busy;max-height:32px;min-width:0px;}
                            Label {text:"Limited deferred pressure flux; does not repair poor mesh quality.";}
                        }
                        Tool {text:"Volume momentum models…";enabled:!root.busy;clicked=>{root.edit-volume-models();}}
                        Tool {text:"Equation solver controls…";enabled:!root.busy;clicked=>{root.edit-equations();}}
                        if root.three-d : Label {text:"3D: Gauss pressure gradient · limited non-orthogonal diffusion";}
                        Label {text:"Velocity relaxation αu";}
                        LineEdit {max-height:32px;text <=> root.velocity-relaxation;min-width:0px;enabled:!root.busy;}
                        Label {text:"Pressure relaxation αp";}
                        LineEdit {max-height:32px;text <=> root.pressure-relaxation;min-width:0px;enabled:!root.busy;}
                        Label {text:"Absolute continuity tolerance";}
                        LineEdit {max-height:32px;text <=> root.continuity-tolerance;min-width:0px;enabled:!root.busy;}
                        Label {text:"Relative momentum / velocity tolerance";}
                        LineEdit {max-height:32px;text <=> root.coupling-tolerance;min-width:0px;enabled:!root.busy;}

                        Label {text:root.can-run ? "Ready: use Run solver to start." : root.readiness;color:root.can-run ? UiTheme.text-muted : UiTheme.accent;}

                        }
if root.properties-section==4 : VerticalLayout {spacing:8px;vertical-stretch:0;
                        Label {text:"PRE-RUN REVIEW";color:UiTheme.accent;font-weight:700;}
                        Text {text:root.preflight;color:UiTheme.text;font-size:11px;wrap:word-wrap;vertical-stretch:0;}
                        HorizontalLayout {spacing:4px;
                            Tool {text:"Mesh settings";enabled:!root.busy;clicked=>{root.repair-stage(1);}}
                            Tool {text:"Boundary / fluid";enabled:!root.busy;clicked=>{root.repair-stage(2);}}
                        }
                        Label {text:"Continuity, momentum reduction and a stable velocity field are all required; a small continuity residual alone does not establish convergence.";}
                        Text {text:root.convergence-summary;color:UiTheme.text;font-size:11px;wrap:word-wrap;}
                        Label {text:"WALL RESOLUTION / SHEAR";color:UiTheme.accent;font-weight:700;}
                        Text {text:root.wall-summary;color:UiTheme.text;font-size:11px;wrap:word-wrap;vertical-stretch:0;}
                        Label {text:"RUN REPORT";color:UiTheme.accent;font-weight:700;}
                        Text {text:root.summary;color:UiTheme.text;font-size:11px;wrap:word-wrap;}
                        Text {text:root.balance;color:UiTheme.text-soft;font-size:11px;wrap:word-wrap;}
                        }
if root.properties-section==5 : VerticalLayout {vertical-stretch:0;spacing:7px;
    ComboBox {model:root.plane-names;current-index <=> root.plane-index;max-height:32px;min-width:0px;selected(value)=>{root.select-plane(self.current-index);}}
    Label {text:root.plane-details;}
SectionProperties {manage(i)=>{root.manage-plane(i);}field <=> root.plane-field;plot <=> root.plane-plot;palette <=> root.plane-palette;density <=> root.plane-density;scale <=> root.plane-scale;
    levels <=> root.plane-levels;streamlines <=> root.plane-streamlines;vectors <=> root.plane-vectors;edges <=> root.plane-edges;normalize <=> root.plane-normalize;normal-marks <=> root.plane-normal-marks;range-min <=> root.plane-min;range-max <=> root.plane-max;
    every <=> root.plane-every;record <=> root.plane-enabled;busy:root.busy;style=>{root.style-plane();}apply=>{root.apply-plane();}export(i)=>{root.export-plane(i);}profile(a,b,c,d,n,k)=>{root.plane-profile(a,b,c,d,n,k);}}
}

                    }
                    if root.properties-section>=1 && root.properties-section<=3 : Tool {
                        text:"Apply settings";enabled:!root.busy;min-height:34px;
                        clicked=>{root.apply();}
                    }
                }
            }

            VerticalLayout {spacing:8px;
                HorizontalLayout {height:30px;spacing:6px;
                    Tool {text:"Convergence";checkable:true;checked:!root.show-log && !root.show-plane;clicked=>{root.show-log=false;root.show-plane=false;}}
                    Tool {text:"Plane fields";checkable:true;checked:root.show-plane;clicked=>{root.show-log=false;root.show-plane=true;root.properties-section=5;}}
                    Tool {text:"Solver log";checkable:true;checked:root.show-log;clicked=>{root.show-log=true;root.show-plane=false;}}
                    Rectangle {horizontal-stretch:1;}
                    if !root.show-plane : ComboBox {model:root.show-plane ? ["Plane CSV","Plane PNG","Plane SVG"] : ["History CSV","Chart PNG","Chart SVG"];current-index <=> root.export-format;min-width:0px;preferred-width:125px;max-height:30px;}
                    if !root.show-plane : Tool {text:"Export";icon:@image-url("assets/icons/export_tray.svg");clicked=>{if root.show-plane {root.export-plane(root.export-format);}else if root.export-format==0 {root.export-history();}else if root.export-format==1 {root.export-chart();}else{root.export-vector();}}}
                }
                if root.show-plane : PlanePlayback {plane-frame:root.plane-frame;plane-count:root.plane-count;plane-playing:root.plane-playing;plane-fps <=> root.plane-fps;loop <=> root.plane-loop;first <=> root.plane-first;last <=> root.plane-last;playback(i)=>{root.playback(i);}}
                if !root.show-log && !root.show-plane : HorizontalLayout {height:30px;spacing:5px;
                    ComboBox {model:["Continuity RMS","Momentum relative","Velocity change","Pressure (inner)","All residuals","Plane mean speed","Plane mean p/ρ","Plane volume flux"];current-index <=> root.chart-kind;min-width:0px;preferred-width:145px;max-height:30px;selected(value)=>{root.refresh-chart();}}
                    if root.chart-kind<5 : CheckBox {text:"Log";checked <=> root.logarithmic;toggled=>{root.refresh-chart();}}
                    if root.chart-kind<5 : CheckBox {text:"Normalize";checked <=> root.normalized;toggled=>{root.refresh-chart();}}
                    if root.chart-kind<5 : ComboBox {model:["Full history","Last 400","Last 100"];current-index <=> root.history-window;min-width:0px;preferred-width:115px;max-height:30px;selected(value)=>{root.refresh-chart();}}
                    if root.chart-kind<5 : CheckBox {text:"Legend";checked <=> root.legend;toggled=>{root.refresh-chart();}}
                }
                if !root.show-log && !root.show-plane && root.chart-kind>=5 : ComboBox {model:root.plane-names;current-index <=> root.plane-index;min-width:0px;max-height:32px;selected(value)=>{root.select-plane(self.current-index);root.refresh-chart();}}
                if !root.show-log && !root.show-plane && root.chart-kind==4 : HorizontalLayout {height:28px;spacing:7px;
                    Rectangle {width:8px;height:8px;background:#58c4f6;}
                    CheckBox {text:"Continuity";checked <=> root.continuity;toggled=>{root.refresh-chart();}}
                    Rectangle {width:8px;height:8px;background:#f5b85b;}
                    CheckBox {text:"Momentum";checked <=> root.momentum;toggled=>{root.refresh-chart();}}
                    Rectangle {width:8px;height:8px;background:#65d49c;}
                    CheckBox {text:"Δ velocity";checked <=> root.velocity;toggled=>{root.refresh-chart();}}
                    Rectangle {width:8px;height:8px;background:#c49bff;}
                    CheckBox {text:"Pressure";checked <=> root.pressure;toggled=>{root.refresh-chart();}}
                    Rectangle {horizontal-stretch:1;}
                }
                plot:=Rectangle {vertical-stretch:1;min-height:200px;background:UiTheme.viewport;border-color:UiTheme.border;border-width:1px;
                    changed width=>{if !root.show-log {root.resize-chart(self.width/1px,self.height/1px);}}
                    changed height=>{if !root.show-log {root.resize-chart(self.width/1px,self.height/1px);}}
                    if !root.show-log && !root.show-plane : Image {source:root.chart;width:parent.width;height:parent.height;image-fit:fill;}
                    if !root.show-log && !root.show-plane : TouchArea {
                        moved=>{root.hover-chart(self.mouse-x/1px);}
                        if root.chart-kind<5 && self.has-hover && self.mouse-x>96px && self.mouse-x<self.width - 24px : Rectangle {
                            x:parent.mouse-x;y:root.legend ? 100px : 44px;width:1px;height:max(0px,parent.height - self.y - 62px);background:#ffffff55;
                        }
                    }
                    if root.show-plane : SectionViewport {source:root.plane-image;readout:root.plane-readout;navigate(a,x,y,w,h)=>{root.plane-navigate(a,x,y,w,h);}width:parent.width;height:parent.height;}

                    if root.show-log : TextEdit {text:root.log;read-only:true;width:parent.width;height:parent.height;}
                }
                if root.show-plane && root.plane-readout!="" : Label {text:root.plane-readout;max-height:42px;overflow:elide;}
                if root.show-plane : Label {text:root.plane-status;max-height:38px;overflow:elide;}
                if !root.show-log && !root.show-plane : Label {text:root.readout;max-height:32px;overflow:elide;color:UiTheme.text;font-size:10px;}
                if !root.show-log && !root.show-plane : Label {text:root.caption;max-height:38px;overflow:elide;font-size:10px;}
                if !root.show-plane : HorizontalLayout {height:16px;spacing:8px;
                    Label {text:"Iteration budget";font-size:10px;vertical-alignment:center;}
                    ProgressIndicator {progress:root.progress;max-height:10px;horizontal-stretch:1;}
                    Label {text:"≠ convergence %";font-size:10px;vertical-alignment:center;}
                }
                if !root.can-run && !root.busy : Label {text:root.readiness;max-height:28px;overflow:elide;}
            }

        }
    }
}
