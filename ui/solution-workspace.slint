import {ComboBox,Button,LineEdit,SpinBox,ProgressIndicator,TextEdit,ScrollView} from "std-widgets.slint";
import {UiTheme} from "components.slint";
component Tool inherits Button {min-width:0px;min-height:30px;max-height:34px;}
component Label inherits Text {font-size:11px;color:UiTheme.text-muted;wrap:word-wrap;}
export component SolutionWorkspace inherits Rectangle {
    in-out property <int> chart-kind;
    callback refresh-chart();
    in property <image> chart;
    in property <string> caption;
    in property <string> monitor;
    in property <string> balance;
    in property <string> convergence-summary;
    in property <string> summary;
    in property <string> readiness;
    in property <string> log;
    in property <string> material;
    in property <bool> busy;
    in property <bool> can-run;
    in property <float> progress;
    in-out property <int> iterations;
    in-out property <int> cpu-threads;
    in property <int> cpu-limit:1;
    in-out property <string> velocity-relaxation;
    in-out property <string> pressure-relaxation;
    in-out property <string> continuity-tolerance;
    in-out property <string> coupling-tolerance;
    in-out property <bool> show-log:false;
    in-out property <int> export-format:0;
    callback apply();callback run();callback cancel();callback results();callback edit-material();callback export-history();callback export-chart();callback export-vector();
    background:UiTheme.background;
    VerticalLayout {padding:12px;spacing:9px;
        HorizontalLayout {height:34px;spacing:8px;
            Text {text:"04  Solution";color:UiTheme.text;font-size:20px;font-weight:700;vertical-alignment:center;}
            Rectangle {horizontal-stretch:1;}
            Tool {text:root.busy ? "Solving…" : "▶ Run solver";enabled:root.can-run && !root.busy;clicked=>{root.run();}}
            Tool {text:"Results →";enabled:!root.busy;clicked=>{root.results();}}
        }
        Text {text:root.monitor;color:UiTheme.text;font-size:12px;wrap:word-wrap;}
        HorizontalLayout {spacing:10px;
            Rectangle {width:300px;background:UiTheme.sidebar;border-color:UiTheme.border;border-width:1px;border-radius:4px;
                panel:=ScrollView {width:parent.width;height:parent.height;horizontal-scrollbar-policy:always-off;
                    VerticalLayout {width:panel.visible-width;padding:12px;spacing:9px;
                        Label {text:"STEADY INCOMPRESSIBLE · SIMPLE";color:UiTheme.accent;font-weight:700;}
                        Label {text:root.material;}
                        Tool {text:"Edit fluid material";enabled:!root.busy;clicked=>{root.edit-material();}}
                        Label {text:"CPU worker threads (0 = automatic)";}
                        SpinBox {value <=> root.cpu-threads;minimum:0;maximum:root.cpu-limit;enabled:!root.busy;}
                        Label {text:"Available logical CPUs: "+root.cpu-limit+". Parallel work currently covers the velocity components.";}
                        Label {text:"Maximum outer iterations";}
                        SpinBox {value <=> root.iterations;minimum:1;maximum:1000000;enabled:!root.busy;}
                        Label {text:"Velocity relaxation αu";}
                        LineEdit {text <=> root.velocity-relaxation;min-width:0px;enabled:!root.busy;}
                        Label {text:"Pressure relaxation αp";}
                        LineEdit {text <=> root.pressure-relaxation;min-width:0px;enabled:!root.busy;}
                        Label {text:"Absolute continuity tolerance";}
                        LineEdit {text <=> root.continuity-tolerance;min-width:0px;enabled:!root.busy;}
                        Label {text:"Relative momentum / velocity tolerance";}
                        LineEdit {text <=> root.coupling-tolerance;min-width:0px;enabled:!root.busy;}
                        Tool {text:"Apply settings only";enabled:!root.busy;clicked=>{root.apply();}}
                        Label {text:root.can-run ? "Settings applied? Use Run solver above to start." : root.readiness;color:root.can-run ? UiTheme.text-muted : UiTheme.accent;}
                        Label {text:"Convergence requires continuity, momentum reduction and a stable velocity field. A smaller continuity residual alone does not establish steady convergence.";}
                        Rectangle {height:1px;background:UiTheme.border;}
                        Text {text:root.convergence-summary;color:UiTheme.text;font-size:11px;wrap:word-wrap;}
                        Label {text:"RUN REPORT";color:UiTheme.accent;font-weight:700;}
                        Text {text:root.summary;color:UiTheme.text;font-size:11px;wrap:word-wrap;}
                        Text {text:root.balance;color:UiTheme.text-soft;font-size:11px;wrap:word-wrap;}
                    }
                }
            }
            VerticalLayout {spacing:8px;
                HorizontalLayout {height:34px;spacing:7px;
                    if !root.show-log : ComboBox {model:["Continuity RMS","Momentum relative","Velocity change","Pressure linear residual"];current-index <=> root.chart-kind;min-width:0px;preferred-width:180px;selected(value)=>{root.refresh-chart();}}
                    Tool {text:!root.show-log ? "● Convergence" : "Convergence";clicked=>{root.show-log=false;}}
                    Tool {text:root.show-log ? "● Solver log" : "Solver log";clicked=>{root.show-log=true;}}
                    Rectangle {horizontal-stretch:1;}
                    ComboBox {model:["History CSV","Chart PNG","Chart SVG"];current-index <=> root.export-format;min-width:0px;preferred-width:135px;}
                    Tool {text:"Export ↓";clicked=>{if root.export-format==0 {root.export-history();}else if root.export-format==1 {root.export-chart();}else{root.export-vector();}}}
                }
                Rectangle {vertical-stretch:1;background:UiTheme.viewport;border-color:UiTheme.border;border-width:1px;
                    if !root.show-log : Image {source:root.chart;width:parent.width;height:parent.height;image-fit:contain;}
                    if root.show-log : TextEdit {text:root.log;read-only:true;width:parent.width;height:parent.height;}
                }
                Label {text:root.caption;}
                ProgressIndicator {progress:root.progress;}
                Label {text:"Iteration budget used; this is not an estimate of convergence completion.";}
                Label {text:root.readiness;}
                HorizontalLayout {height:36px;spacing:8px;
                    Tool {text:"■ Cancel solve";enabled:root.busy;clicked=>{root.cancel();}}
                    Rectangle {horizontal-stretch:1;}
                    Tool {text:"View results →";enabled:!root.busy;clicked=>{root.results();}}
                }
            }
        }
    }
}
