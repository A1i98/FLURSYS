import { EntitySelectionBar } from "entity-selection.slint";
import { Button, ComboBox, LineEdit, SpinBox, ScrollView, ListView, ProgressIndicator, CheckBox } from "std-widgets.slint";
import { UiTheme, PropertiesPanel, PropertyScroll, WorkspaceSections, InteractiveGeometryPreview } from "components.slint";

component ToolButton inherits Button {
    min-width:0px; min-height:30px; max-height:34px;
}
component Label inherits Text {
    color:UiTheme.text-muted;font-size:11px;wrap:word-wrap;vertical-stretch:0;
}
component Field inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    callback changed();
    spacing:4px;vertical-stretch:0;min-width:0px;
    Label {text:root.label;}
    LineEdit {edited=>{root.changed();}text <=> root.value;min-width:0px;min-height:32px;max-height:32px;vertical-stretch:0;}
}

// Geometry grouping and mesh controls share one viewport, with a bounded task pane.
export component MeshWorkspace inherits Rectangle {
    in property <bool> busy;
    in property <bool> meshing;
    in property <float> progress;
    in property <string> stage;
    in-out property <int> cpu-threads;
    in property <int> cpu-limit:1;
    in-out property <int> task;
    in-out property <int> dimension;
    in property <int> entity-mode;
    in property <bool> spatial;
    in property <bool> geometry-view;
    in property <string> selection;
    in property <string> coverage;
    in property <[string]> groups;
    in property <[string]> group-names;
    in-out property <int> local-group-index;
    in property <int> group-index;
    in-out property <string> group-name;
    in property <string> feedback;
    in property <string> domain;
    in property <string> readiness;
    in property <string> summary;
    in property <string> gmsh;
    in property <string> plan;
    in property <string> cad-route;
    in-out property <string> size-growth;
    in-out property <int> edge-cells;
    in-out property <string> edge-growth;
    in-out property <bool> edge-reverse;
    in-out property <bool> edge-symmetric;
    callback add-edges();
    callback calculate-transition();
    in-out property <int> method;
    in-out property <int> divisions-i;
    in-out property <int> divisions-j;
    in-out property <int> divisions-k;
    in-out property <string> progression-i;
    in-out property <string> progression-j;
    in-out property <int> algorithm2d;
    in-out property <int> algorithm3d;
    in-out property <int> curvature;
    in-out property <int> smoothing;
    in-out property <bool> optimize;
    in-out property <bool> netgen;
    in-out property <bool> extend;
    in-out property <string> optimize-threshold;
    in-out property <string> global-size;
    in-out property <string> min-size;
    in-out property <string> max-size;
    in-out property <bool> clip-enabled;
    in-out property <int> clip-axis;
    in-out property <int> clip-position;
    in-out property <bool> clip-invert;
    in property <[float]> quality-bins;
    in property <string> quality-stats;
    in property <string> quality-low;
    in property <string> quality-high;
    in-out property <string> box-min;
    in-out property <string> box-max;
    in-out property <string> box-size;
    in-out property <string> box-transition;
    callback inspect(int);
    callback add-region();
    callback region-bounds();
    in-out property <int> scope-mode;
    in-out property <int> control-kind;
    in-out property <string> control-name;
    in property <string> edit-id;
    in-out property <int> layer-mode;
    in property <string> layer-summary;
    callback control-action(int,int);
    callback layer-preview();
    in-out property <string> local-target;
    in-out property <string> local-size;
    in-out property <string> refine-min;
    in-out property <string> refine-max;
    in-out property <string> refine-distance;
    in-out property <string> refine-start;
    in-out property <int> refine-sampling;
    in-out property <string> layer-first;
    in-out property <string> layer-growth;
    in-out property <int> layer-count;
    in property <[string]> controls;
    in-out property <int> display-mode;
    in-out property <int> color-mode;
    in-out property <int> quality-mode;
    in-out property <string> quality-threshold;
    in property <string> inspection;
    in property <[string]> bad-cells;
    in property <image> preview;
    private property <bool> quality-open:false;
    private property <int> control-index:0;
    callback apply-settings();
    callback task-changed(int);
    callback select-filter(int);
    callback show-geometry(bool);
    callback pick(float,float,float,float,bool);
    callback pick-mesh(float,float,float,float);
    callback select-group(int);
    callback edit-condition(int);
    callback group-action(int);
    callback use-face();callback check();callback generate();callback cancel();
    callback preset(int);callback add-local();callback add-refinement();callback add-layers();
    callback display(int);callback select-color(int);callback quality(int);callback threshold();callback select-bad(int);
    callback hover(float,float,float,float);
    in property <image> orientation;
    in property <int> view-axis:3;
    callback pan(float,float,float,float);
    callback view(int);
    callback pick-orientation(float,float);
    callback drag(float,float,float,float,float,float);callback drag-end();callback zoom(float);callback fit();
    background:UiTheme.background;
    VerticalLayout {
        padding:12px;spacing:10px;
        WorkspaceSections {model:["Boundaries","Sizing","Quality","Refinement","View","Method"];current-index <=> root.task;selected(i)=>{root.task-changed(i);}}
        HorizontalLayout {
            spacing:10px;
            PropertiesPanel {
                VerticalLayout {padding:8px;spacing:8px;
                PropertyScroll {section:root.task;
                        if root.task==4 : VerticalLayout {spacing:8px;vertical-stretch:0;
                        Label {text:"DISPLAY";color:UiTheme.accent;}
                        ComboBox {min-height:32px;max-height:32px;model:["Geometry for scoping","Generated mesh"];current-index:root.geometry-view ? 0 : 1;selected(value)=>{root.show-geometry(self.current-index==0);}}
                        if !root.geometry-view : VerticalLayout {vertical-stretch:0;spacing:6px;
                            ComboBox {min-height:32px;max-height:32px;model:["Wireframe · transparent","Surface","Surface + edges"];current-index <=> root.display-mode;selected(value)=>{root.display(self.current-index);}}
                            ComboBox {min-height:32px;max-height:32px;model:["Neutral","Boundary zones","Quality"];current-index <=> root.color-mode;selected(value)=>{root.select-color(self.current-index);}}
                        }
                        Rectangle {height:1px;background:UiTheme.border;}
                        Label {text:"DOMAIN DIMENSION";}
                            ComboBox {min-height:32px;max-height:32px;vertical-stretch:0;model:["2D planar domain","3D fluid volume"];current-index <=> root.dimension;enabled:!root.busy;selected(value)=>{root.select-filter(root.dimension==0 ? 1 : 0);}}

                        if root.dimension==1 && !root.geometry-view : VerticalLayout {vertical-stretch:0;spacing:6px;
                            Label {text:"3D CELL CUTAWAY";color:UiTheme.accent;}
                            CheckBox {text:"Enable cutaway";checked <=> root.clip-enabled;}
                            ComboBox {min-height:32px;max-height:32px;model:["X axis","Y axis","Z axis"];current-index <=> root.clip-axis;}
                            HorizontalLayout {vertical-stretch:0;
                                Label {text:"Position (%)";horizontal-stretch:1;}
                                SpinBox {min-height:32px;max-height:32px;min-width:0px;preferred-width:100px;maximum:100;minimum:0;value <=> root.clip-position;}
                            }
                            CheckBox {text:"Keep upper side";checked <=> root.clip-invert;}
                            Label {text:"Whole cells are kept by centre position. The exposed cut is stepped; this is not a geometric plane section.";}
                            HorizontalLayout {vertical-stretch:0;
                                ToolButton {text:"Apply cut";clicked=>{root.inspect(0);}}
                                ToolButton {text:"Reset cut";clicked=>{root.inspect(1);}}
                            }
                            Rectangle {height:1px;background:UiTheme.border;}
                        }
                        }
                        if root.task==0 : VerticalLayout {vertical-stretch:0;
                            spacing:9px;
                            Text {vertical-stretch:0;text:"NAMED BOUNDARIES";color:UiTheme.accent;font-size:12px;font-weight:700;}
                            Label {text:"Name the original geometry before generating the mesh. Shift-click adds edges (2D) or surfaces (3D).";}
                            Text {vertical-stretch:0;text:root.selection;color:UiTheme.text;font-size:11px;wrap:word-wrap;}
                            HorizontalLayout {vertical-stretch:0;
                                ToolButton {text:"Clear selection";enabled:!root.busy;clicked=>{root.group-action(0);}}
                                ToolButton {text:"Ungrouped";enabled:!root.busy;clicked=>{root.group-action(5);}}
                            }
                            Field {label:"Boundary name";value <=> root.group-name;}
                            ToolButton {text:"+ Create boundary group";enabled:!root.busy && root.group-name!="" && root.group-index<0;clicked=>{root.group-action(1);}}
                            Label {text:"Groups define mesh zones. Assign wall, inlet or outlet conditions in Setup.";}
                            Rectangle {height:1px;background:UiTheme.border;}
                            Label {text:"EXISTING GROUPS";}
                            if root.groups.length==0 : Label {text:"No named groups yet.";}
                            if root.groups.length>0 : VerticalLayout {spacing:3px;vertical-stretch:0;
                                for group[index] in root.groups : ToolButton {
                                    text:(index==root.group-index ? "● " : "○ ")+group;
                                    enabled:!root.busy;clicked=>{root.select-group(index);}
                                }
                            }
                            if root.group-index>=0 : VerticalLayout {vertical-stretch:0;
                                spacing:6px;
                                ToolButton {text:"Set boundary condition →";enabled:!root.busy;clicked=>{root.edit-condition(root.group-index);}}
                                ToolButton {text:"Replace members with selection";enabled:!root.busy;clicked=>{root.group-action(2);}}
                                HorizontalLayout {vertical-stretch:0;
                                    ToolButton {text:"Rename";enabled:!root.busy;clicked=>{root.group-action(3);}}
                                    ToolButton {text:"Delete group";enabled:!root.busy;clicked=>{root.group-action(4);}}
                                }
                            }
                            Text {vertical-stretch:0;text:root.coverage;color:UiTheme.text-soft;font-size:11px;wrap:word-wrap;}
                            Rectangle {height:1px;background:UiTheme.border;}
                            Label {text:"FLUID DOMAIN";}
                            Text {vertical-stretch:0;text:root.domain;color:UiTheme.text;font-size:11px;wrap:word-wrap;}
                            ToolButton {text:"Use selected face as 2D domain";enabled:!root.busy && root.dimension==0;clicked=>{root.use-face();}}
                        }
                        if root.task==5 : VerticalLayout {vertical-stretch:0;spacing:8px;
                            Label {text:"MESH TOPOLOGY";color:UiTheme.accent;font-weight:700;}
                            ComboBox {min-height:32px;max-height:32px;model:["Automatic triangles / tetrahedra","Quad-dominant · 2D","Mapped quadrilateral · 2D","O-grid · 2D circular hole","Hexahedral block · 3D box","Surface sweep · prisms · 3D","Mapped surface sweep · hex · 3D"];current-index <=> root.method;enabled:!root.busy;}
                            if root.method==1 : Label {text:"Recombines triangles into quads. Some triangles can remain; this is not a structured mesh.";}
                            if root.method>=2 : VerticalLayout {vertical-stretch:0;spacing:6px;
                                Label {text:root.method==3 ? "Four conformal blocks around one exact circular hole. Outer boundary: four straight edges. Circumference cells = 4 × I." : root.method>=5 ? "Analytic extrusion only. Sweeps the source profile to its opposite face using K layers. Faceted CAD solids are not supported." : root.method==4 ? "Six-face axis-aligned box (including CAD). I/J/K follow global X/Y/Z. Boundary names are preserved." : "One convex four-edge face, no holes. Opposite edges share matching cell counts.";}
                                if root.method!=5 : VerticalLayout {vertical-stretch:0;spacing:6px;
                                Label {text:root.method==3 ? "Cells per arc (I)" : "Cells in I";}
                                SpinBox {value <=> root.divisions-i;minimum:1;maximum:10000;min-height:32px;max-height:32px;}
                                Label {text:root.method==3 ? "Radial cells (J)" : "Cells in J";}
                                SpinBox {value <=> root.divisions-j;minimum:1;maximum:10000;min-height:32px;max-height:32px;}
                                }
                                if root.method>=4 : VerticalLayout {vertical-stretch:0;spacing:4px;
                                    Label {text:root.method>=5 ? "Sweep layers (K)" : "Cells in K";}
                                    SpinBox {value <=> root.divisions-k;minimum:1;maximum:10000;min-height:32px;max-height:32px;}
                                }
                                if root.method==2 || root.method==6 : Field {label:"I cell growth · 1 = uniform";value <=> root.progression-i;}
                                if root.method!=4 && root.method!=5 : Field {label:root.method==3 ? "Radial growth · >1 grows away from cylinder" : "J cell growth · 1 = uniform";value <=> root.progression-j;}
                                Label {text:"Explicit divisions determine cell sizes; global min/max do not clamp mapped cells. Disable other refinement/inflation controls. Excessive grading is rejected.";}
                                Label {text:root.method==3 ? "Estimated cells: "+(4.0*root.divisions-i*root.divisions-j) : root.method==5 ? "Prisms = source triangles × K" : root.method>=4 ? "Estimated cells: "+(1.0*root.divisions-i*root.divisions-j*root.divisions-k) : "Estimated cells: "+(1.0*root.divisions-i*root.divisions-j);}
                            }
                            Label {text:root.cad-route;}
                            Label {text:root.plan;}
                            ToolButton {text:"Validate mesh plan";enabled:!root.busy;clicked=>{root.check();}}
                            ToolButton {text:"Apply topology method";enabled:!root.busy;clicked=>{root.apply-settings();}}
                        }
                        if root.task==1 : VerticalLayout {vertical-stretch:0;
                            spacing:9px;
                            Text {vertical-stretch:0;text:"EXECUTION";color:UiTheme.accent;font-size:12px;font-weight:700;}
                            HorizontalLayout {vertical-stretch:0;spacing:8px;
                                Label {text:"CPU threads";vertical-alignment:center;horizontal-stretch:1;}
                                SpinBox {min-height:32px;max-height:32px;vertical-stretch:0;min-width:0px;preferred-width:110px;max-width:110px;value <=> root.cpu-threads;minimum:0;maximum:root.cpu-limit;enabled:!root.busy;}
                            }
                            Label {text:"0 = automatic · "+root.cpu-limit+" logical CPUs available";}
                            if root.dimension==0 : Label {text:"A single 2D surface may mesh mostly serially.";}
                            Rectangle {height:1px;background:UiTheme.border;}
                            Text {vertical-stretch:0;text:"GLOBAL SIZING";color:UiTheme.accent;font-size:12px;font-weight:700;}
                            Field {label:"Target element size (m)";value <=> root.global-size;}
                            HorizontalLayout {vertical-stretch:0;
                                Field {label:"Minimum (m)";value <=> root.min-size;}
                                Field {label:"Maximum (m)";value <=> root.max-size;}
                            }
                            HorizontalLayout {vertical-stretch:0;
                                ToolButton {text:"Coarse";enabled:!root.busy;clicked=>{root.preset(0);}}
                                ToolButton {text:"Medium";enabled:!root.busy;clicked=>{root.preset(1);}}
                                ToolButton {text:"Fine";enabled:!root.busy;clicked=>{root.preset(2);}}
                            }
                            Label {text:"Required: minimum ≤ target ≤ maximum. Local sizes and distance fields must also fit these bounds. Presets are optional and replace only size inputs.";}
                            ToolButton {text:"Uniform size: min = max = target";enabled:!root.busy;clicked=>{root.min-size=root.global-size;root.max-size=root.global-size;}}
                            Rectangle {height:1px;background:UiTheme.border;}
                            ToolButton {text:root.quality-open ? "▾ Algorithm & quality" : "▸ Algorithm & quality";clicked=>{root.quality-open=!root.quality-open;}}
                            if root.quality-open : VerticalLayout {vertical-stretch:0;spacing:8px;
                            if root.dimension==0 : VerticalLayout {vertical-stretch:0;spacing:4px;
                                Label {text:"Triangle algorithm";}
                                ComboBox {min-height:32px;max-height:32px;model:["Frontal-Delaunay","Delaunay","MeshAdapt"];current-index <=> root.algorithm2d;enabled:!root.busy;}
                            }
                            if root.dimension==1 : VerticalLayout {vertical-stretch:0;spacing:4px;
                                Label {text:"Tetrahedron algorithm";}
                                ComboBox {min-height:32px;max-height:32px;model:["Delaunay","Frontal","HXT"];current-index <=> root.algorithm3d;enabled:!root.busy;}
                                Label {text:"HXT supports parallel meshing when available in your Gmsh build.";}
                            }
                            HorizontalLayout {vertical-stretch:0;
                                Label {text:"Elements per full circle · 0 = off";horizontal-stretch:1;}
                                SpinBox {min-height:32px;max-height:32px;minimum:0;maximum:1000;value <=> root.curvature;enabled:!root.busy;}
                            }
                            HorizontalLayout {vertical-stretch:0;
                                Label {text:"Smoothing steps";horizontal-stretch:1;}
                                SpinBox {min-height:32px;max-height:32px;minimum:0;maximum:100;value <=> root.smoothing;enabled:!root.busy;}
                            }
                            CheckBox {text:"Extend boundary sizes into domain";checked <=> root.extend;enabled:!root.busy;}
                            if root.dimension==1 : VerticalLayout {vertical-stretch:0;spacing:6px;
                                CheckBox {text:"Optimize tetrahedron quality";checked <=> root.optimize;enabled:!root.busy;}
                                CheckBox {text:"Additional Netgen optimization";checked <=> root.netgen;enabled:!root.busy;}
                                Field {label:"Optimization threshold · 0–1";value <=> root.optimize-threshold;}
                                Label {text:"Gmsh quality threshold; this is not the solver non-orthogonality angle. Optimization does not guarantee a good CFD mesh.";}
                            }
                            }
                            ToolButton {text:"Apply mesh settings";enabled:!root.busy;clicked=>{root.apply-settings();}}

                            Rectangle {height:1px;background:UiTheme.border;}
                        }
                        if root.task==3 : VerticalLayout {spacing:8px;vertical-stretch:0;
                            Text {vertical-stretch:0;text:"SCOPED MESH CONTROLS";color:UiTheme.accent;font-size:12px;font-weight:700;}
                            Label {text:"Select geometry in the viewport, then choose a control. Boundary names and mesh controls are independent.";}
                            if root.edit-id!="" : Label {text:"Editing control #"+root.edit-id; color:UiTheme.accent;}
                            ToolButton {text:"+ New control";enabled:!root.busy;clicked=>{root.control-action(3,0);}}
                            Field {label:"Control name (optional)";value <=> root.control-name;}
                            if root.control-kind!=3 : Label {text:"Scope";}
                            if root.control-kind!=3 : ComboBox {min-height:32px;max-height:32px;vertical-stretch:0;model:["Named boundary group","Current geometry selection"];current-index <=> root.scope-mode;enabled:!root.busy;selected(value)=>{if self.current-index==1 {root.show-geometry(true);}}}
                            if root.scope-mode==0 && root.control-kind!=3 : ComboBox {min-height:32px;max-height:32px;vertical-stretch:0;model:root.group-names;current-index <=> root.local-group-index;enabled:!root.busy && root.group-names.length>0;selected(value)=>{root.local-target=value;}}
                            if root.scope-mode==1 && root.control-kind!=3 : Label {text:root.selection;}
                            Label {text:"Control type";}
                            ComboBox {min-height:32px;max-height:32px;vertical-stretch:0;model:["Edge / surface sizing","Distance refinement","Inflation (2D)","Volume refinement box","Exact edge divisions · 2D"];current-index <=> root.control-kind;enabled:!root.busy;selected(value)=>{root.layer-preview();}}
                            if root.control-kind==4 : VerticalLayout {vertical-stretch:0;spacing:7px;
                                Label {text:"Exact cells on each analytic boundary edge in the scope. Uses the curve's stored start → end direction.";}
                                SpinBox {minimum:1;maximum:10000;value <=> root.edge-cells;min-height:32px;max-height:32px;}
                                CheckBox {text:"Refine both ends (Bump)";checked <=> root.edge-symmetric;}
                                Field {label:root.edge-symmetric ? "Bump coefficient · 0.01–1 (not a growth ratio)" : "Cell growth · 1 = uniform";value <=> root.edge-growth;}
                                if !root.edge-symmetric : CheckBox {text:"Reverse direction";checked <=> root.edge-reverse;}
                                Label {text:"Use Automatic or Quad-dominant. Mapped methods use their I/J counts. Overlapping enabled scopes are rejected.";}
                                ToolButton {text:root.edit-id=="" ? "Apply edge divisions" : "Update edge divisions";enabled:!root.busy && root.dimension==0;clicked=>{root.add-edges();}}
                            }
                            if root.control-kind==0 : VerticalLayout {vertical-stretch:0;spacing:7px;
                                Field {label:"Element size (m)";value <=> root.local-size;}
                                ToolButton {text:root.edit-id=="" ? "Apply sizing to scope" : "Update sizing";enabled:!root.busy;clicked=>{root.add-local();}}
                            }
                            if root.control-kind==1 : VerticalLayout {vertical-stretch:0;spacing:7px;
                                HorizontalLayout {vertical-stretch:0;Field {label:"Near size (m)";value <=> root.refine-min;} Field {label:"Far size (m)";value <=> root.refine-max;}}
                                Field {label:"Fine region distance (m)";value <=> root.refine-start;}
                                Field {label:"Transition end distance (m)";value <=> root.refine-distance;}
                                Field {label:"Distance-field growth limit · empty = off";value <=> root.size-growth;}
                                ToolButton {text:"Calculate minimum transition";enabled:!root.busy;clicked=>{root.calculate-transition();}}
                                Label {text:"Growth 1.01–2 checks the linear size-field slope. This is not a guarantee of adjacent cell-volume ratios. Apply mesh settings to save the limit.";}
                                Label {text:"A wider transition interval gives gentler refinement around the selected edges or surfaces.";}
                                HorizontalLayout {vertical-stretch:0;
                                    Label {text:"Distance sampling";horizontal-stretch:1;}
                                    SpinBox {min-height:32px;max-height:32px;minimum:10;maximum:1000;value <=> root.refine-sampling;}
                                }
                                ToolButton {text:root.edit-id=="" ? "Apply refinement to scope" : "Update refinement";enabled:!root.busy;clicked=>{root.add-refinement();}}
                            }
                            if root.control-kind==2 && root.dimension==1 : Label {text:"Prismatic inflation for arbitrary 3D CAD is not implemented. Distance refinement works on selected 3D surfaces, but does not produce prism layers.";}
                            if root.control-kind==2 && root.dimension==0 : VerticalLayout {vertical-stretch:0;spacing:7px;
                                Label {text:"Inflation definition";}
                                ComboBox {min-height:32px;max-height:32px;model:["First layer height","Total thickness"];current-index <=> root.layer-mode;selected(value)=>{root.layer-preview();}}
                                Field {label:root.layer-mode==0 ? "First layer height (m)" : "Total thickness (m)";value <=> root.layer-first;changed=>{root.layer-preview();}}
                                Field {label:"Growth ratio (1–3)";value <=> root.layer-growth;changed=>{root.layer-preview();}}
                                HorizontalLayout {vertical-stretch:0;
                                    Label {text:"Target layers";horizontal-stretch:1;}
                                    SpinBox {min-height:32px;max-height:32px;min-width:0px;preferred-width:100px;max-width:100px;value <=> root.layer-count;minimum:1;maximum:64;edited(value)=>{root.layer-preview();}}
                                }
                                Label {text:root.layer-summary;}
                                Label {text:"Quadrilateral layers on selected 2D boundary edges. Multiple enabled scopes currently require matching layer parameters.";}
                                ToolButton {text:root.edit-id=="" ? "Apply inflation to scope" : "Update inflation";enabled:!root.busy;clicked=>{root.add-layers();}}
                            }
                            if root.control-kind==3 : VerticalLayout {vertical-stretch:0;spacing:7px;
                                Label {text:"Axis-aligned box in model coordinates (metres). Useful for wake refinement; no boundary group is required.";}
                                ToolButton {text:"Start from model bounds";enabled:!root.busy;clicked=>{root.region-bounds();}}
                                Field {label:"Minimum X, Y, Z (m)";value <=> root.box-min;}
                                Field {label:"Maximum X, Y, Z (m)";value <=> root.box-max;}
                                Field {label:"Inside element size (m)";value <=> root.box-size;}
                                Field {label:"Outside transition thickness (m)";value <=> root.box-transition;}
                                Label {text:"Combined with other refinements by minimum requested size. Use a positive transition for a gradual change.";}
                                ToolButton {text:root.edit-id=="" ? "Apply volume refinement" : "Update volume refinement";enabled:!root.busy && root.dimension==1;clicked=>{root.add-region();}}
                            }
                            Rectangle {height:1px;background:UiTheme.border;}
                            if root.controls.length>0 : VerticalLayout {vertical-stretch:0;spacing:6px;
                                Label {text:"MESH CONTROLS · ● enabled / ○ suppressed";}
                                VerticalLayout {spacing:3px;vertical-stretch:0;
                                    for control[index] in root.controls : ToolButton {
                                        text:(root.control-index==index ? "▸ " : "")+control;
                                        enabled:!root.busy;clicked=>{root.control-index=index;root.control-action(0,index);}
                                    }
                                }
                                HorizontalLayout {vertical-stretch:0;
                                    ToolButton {text:"Edit";enabled:!root.busy;clicked=>{root.control-action(0,root.control-index);}}
                                    ToolButton {text:"On / off";enabled:!root.busy;clicked=>{root.control-action(1,root.control-index);}}
                                    ToolButton {text:"Delete";enabled:!root.busy;clicked=>{root.control-action(2,root.control-index);root.control-index=0;}}
                                }
                            }

                        }
                        if root.task==2 : VerticalLayout {vertical-stretch:0;
                            spacing:9px;
                            Text {vertical-stretch:0;text:"MESH QUALITY";color:UiTheme.accent;font-size:12px;font-weight:700;}
                            Label {text:root.summary;}
                            Label {text:"Wireframe colours the edges. Choose Surface + edges to inspect filled quality colours.";}
                            Label {text:"Metric";}
                            ComboBox {min-height:32px;max-height:32px;vertical-stretch:0;model:["Aspect ratio","Skewness","Non-orthogonality","Cell measure","Adjacent cell-size ratio"];current-index <=> root.quality-mode;selected(value)=>{root.quality(self.current-index);}}
                            Label {text:root.quality-stats;}
                            Rectangle {height:12px;background:root.display-mode==0 ? @linear-gradient(90deg, rgb(115,206,171) 0%,rgb(255,112,112) 100%) : @linear-gradient(90deg,rgb(40,180,125) 0%,rgb(255,35,35) 100%);}
                            HorizontalLayout {vertical-stretch:0;
                                Label {text:root.quality-low;horizontal-stretch:1;}
                                Label {text:root.quality-high;}
                            }
                            HorizontalLayout {height:72px;spacing:3px;vertical-stretch:0;
                                for value[index] in root.quality-bins : Rectangle {
                                    background:transparent;horizontal-stretch:1;
                                    Rectangle {x:0px;y:parent.height*(1-value);width:parent.width;height:parent.height*value;background:UiTheme.accent;}
                                }
                            }
                            Label {text:"Histogram height = relative bin count; bins follow the legend left → right. Cell measure uses descending values. Counts include hidden cells.";}
                            Field {label:root.quality-mode==3 ? "Highlight cells below measure" : "Highlight cells above threshold";value <=> root.quality-threshold;}
                            ToolButton {text:"Apply threshold";clicked=>{root.threshold();}}
                            Label {text:root.quality-mode==4 ? "For each cell: largest max(Vowner/Vneighbour, Vneighbour/Vowner) across internal faces. In 2D, V is area." : root.quality-mode==3 ? "Small cell measures can indicate a restrictive time step. Units: m² in 2D, m³ in 3D." : "Metrics are implementation-specific; they are not interchangeable with similarly named metrics in other meshers.";}
                            HorizontalLayout {vertical-stretch:0;
                                ToolButton {text:"Isolate poor cells · 3D";enabled:root.dimension==1;clicked=>{root.inspect(2);}}
                                ToolButton {text:"Show all";clicked=>{root.inspect(1);}}
                            }
                            HorizontalLayout {vertical-stretch:0;
                                ToolButton {text:"Cell quality CSV…";clicked=>{root.inspect(4);}}
                                ToolButton {text:"Mesh report JSON…";clicked=>{root.inspect(5);}}
                            }
                            ToolButton {text:"Focus worst cell";clicked=>{root.inspect(6);}}
                            Label {text:"Focusing a 3D cell isolates that cell. Show all restores the complete mesh; topology is unchanged.";}
                            Label {text:root.inspection;}
                            if root.bad-cells.length>0 : VerticalLayout {spacing:3px;vertical-stretch:0;
                                for cell[index] in root.bad-cells : ToolButton {text:cell;clicked=>{root.select-bad(index);}}
                            }
                            Label {text:root.gmsh;}
                        }


                }
                }
            }

            VerticalLayout {
                spacing:8px;


                InteractiveGeometryPreview {
                    vertical-stretch:1;preview-image:root.preview;
                    navigation-3d:true;show-fit-control:false;planar-navigation:!root.spatial;orientation-image:root.orientation;view-axis:root.view-axis;
                    select-view-axis(axis)=>{root.view(axis);}pick-orientation(x,y)=>{root.pick-orientation(x,y);}
                    pan(dx,dy,w,h)=>{root.pan(dx,dy,w,h);}
                    help-text:root.geometry-view ? "CLICK: SELECT · SHIFT-CLICK: ADD / REMOVE · DRAG: PAN (2D) / ORBIT (3D) · MIDDLE: PAN · WHEEL: ZOOM" : root.dimension==0 ? "CLICK: INSPECT FACE · DRAG: PAN · WHEEL: ZOOM" : "CLICK: INSPECT · DRAG: ORBIT · MIDDLE / SHIFT-DRAG: PAN · WHEEL: ZOOM";
                    pick-modified(x,y,w,h,additive)=>{if root.geometry-view {root.pick(x,y,w,h,additive);} else {root.pick-mesh(x,y,w,h);}}
                    hover(x,y,w,h)=>{root.hover(x,y,w,h);}
                    orbit(x,y,px,py)=>{root.drag(x,y,px,py,self.width/1px,self.height/1px);}
                    orbit-end=>{root.drag-end();}
                    zoom(delta)=>{root.zoom(delta);}
                    reset-view=>{root.fit();}
                }
                HorizontalLayout {height:34px;spacing:6px;
                EntitySelectionBar {mode:root.entity-mode;enabled:!root.busy;select(mode)=>{root.select-filter(mode);}clear=>{root.group-action(0);}}
                }

                Text {text:root.feedback;color:UiTheme.text-soft;font-size:11px;wrap:word-wrap;max-height:48px;overflow:elide;}
                Label {text:root.readiness;}
                if root.meshing : VerticalLayout {
                    spacing:4px;
                    Label {text:root.stage;}
                    ProgressIndicator {progress:root.progress;}
                    Label {text:"Stage progress; not an estimate of time remaining.";}
                }
                HorizontalLayout {
                    height:36px;spacing:8px;
                    ToolButton {text:"Validate inputs";enabled:!root.busy;clicked=>{root.check();}}
                    ToolButton {text:root.meshing ? "Generating…" : "Generate mesh";enabled:!root.busy;clicked=>{root.generate();}}
                    if root.meshing : ToolButton {text:"Cancel";clicked=>{root.cancel();}}
                }
            }

        }
    }
}
