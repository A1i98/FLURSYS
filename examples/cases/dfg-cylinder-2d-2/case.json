        "sha256": "95542b81aa6159dde43870c2aa5edc4396b403a685e45c672545654bc16eb021",
        "content": "// Velocity inlet: m/s. Channel y spans [0, params.height] metres.\n// Steady signature: no physical-time argument.\nfn profile(x, y, z) {\n    let r = y / params.height;\n    if r <= 0.0 || r >= 1.0 { return vec3(0.0, 0.0, 0.0); }\n    vec3(4.0 * params.peak_speed * r * (1.0 - r), 0.0, 0.0)\n}\n",
