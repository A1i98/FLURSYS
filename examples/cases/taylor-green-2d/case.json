  "name": "Taylor–Green vortex · periodic 2D",
  "category": "Analytical transient benchmark",
  "description": "Decaying periodic vortex; unit square, Re=100, mapped 64×64 cells, BDF2/PIMPLE, exact spatial initialization.",
  "capabilities": [
    "Workbench",
    "TwoD",
    "Editable",
