SetFactory("OpenCASCADE");
L = 0.3048;
rCone = L * Tan(Pi / 18);
rFar = 0.20;
Cylinder(1) = {0, 0, 0, L, 0, 0, rFar};
Cone(2) = {0, 0, 0, L, 0, 0, 0, rCone};
fluid[] = BooleanDifference{ Volume{1}; Delete; }{ Volume{2}; Delete; };
eps = 1e-5;
inlet[] = Surface In BoundingBox{-eps, -rFar-eps, -rFar-eps, eps, rFar+eps, rFar+eps};
outlet[] = Surface In BoundingBox{L-eps, -rFar-eps, -rFar-eps, L+eps, rFar+eps, rFar+eps};
all[] = Boundary{ Volume{fluid[]}; };
cone[] = Surface In BoundingBox{-eps, -rCone-eps, -rCone-eps, L+eps, rCone+eps, rCone+eps};
far[] = all[];
far[] -= inlet[];
far[] -= outlet[];
far[] -= cone[];
Physical Volume("fluid") = {fluid[]};
Physical Surface("inlet") = {inlet[]};
Physical Surface("outlet") = {outlet[]};
Physical Surface("cone") = {cone[]};
Physical Surface("farfield") = {far[]};
Mesh.CharacteristicLengthMin = 0.008;
Mesh.CharacteristicLengthMax = 0.015;
